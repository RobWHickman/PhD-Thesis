function valToGetty = ModigMakeGettyArray_PAVLOVIAN_FIX
% valToGetty = ModigMakeGettyArray_PAVLOVIAN
%
% Make a vector to send to Getty in PAVLOVIAN project.
% Note that shares task number (24), Imperative giving AND dictator, this
% one is the "pavlovian" version (in terms of labels in getty) AND with
% observation learning, which has the same PAVLOVIAN label. Values 10 and
% 11 are 
%
% 
% rbm 11.10

global Stim Task TaskOp Timers BehaveData UserInfo

valToGetty = zeros(1,80);

%% basic stuff
% 1. fixed
valToGetty(1) = length(valToGetty); % numb of additional vars

% 2. taskNumb
valToGetty(2) = 24;  

% 3. combined trial type (bhvsit)

% 0 | 1 (always at the center!)
stimLeft = 0; 
% 0 | 6
actor    = strcmp(TaskOp.curSetup,'B')*6;                               
% 1 | 3 | 5: 1, imperative; 3, pavlovian; 5, choice
tk = 3;

% steps of 12 'labels'
condition= 12*(TaskOp.(TaskOp.curSetup).trialOrder(TaskOp.count.seq,1)-1);

valToGetty(3) = (actor + stimLeft + tk + condition);

% longest possible trial length (w/o error time added)
taFi = fields(Task);
trLAll   = 0;
trLTimer = 0;

for i = 1:length(taFi)
    trLAll = trLAll + Timers.Event.(taFi{i}).StartDelay;
    if ~strcmpi(taFi{i},'error')
        trLTimer = trLTimer + Timers.Event.(taFi{i}).StartDelay;        
    end
end

trLNoITI = trLTimer - Timers.Event.ITI.StartDelay;
trLNoITI = max(trLNoITI)*1000;
valToGetty(4) = floor(trLNoITI/256);
valToGetty(5) = mod(trLNoITI,256);

% disp(sprintf('no ITI: %g  all epochs: %g ',max(trLNoITI)*1000, trLTimer))

TaskOp.trLTimer = trLTimer;

%% stim params,

% picture IDs
% this is the presented one
name = Stim.CS.csfname{1}; 
cs1 = str2double(name(end-7:end-4));
valToGetty(6) = floor(cs1/256); 
valToGetty(7) = mod(cs1,256);

% to see which CSs are active at a given "session" (which might change
% during one recording session)
baseNo = base2dec(num2str(Stim.CS.active),2);
valToGetty(8) = floor(baseNo/256);
valToGetty(9) = mod(baseNo,256);

% this ain't related to CS, but to the fact that this project shares the
% task number with too many others. It's signature is the animal IDs
valToGetty(10:11) = [str2double(UserInfo.setupA) str2double(UserInfo.setupB)];

% CS position
valToGetty(12:2:18) = floor(Stim.CS.position/256);
valToGetty(13:2:19) = mod(Stim.CS.position,256);

% these are all CSs IDs 1/4/11
cs = [];
cs = [cs, str2double(Stim.CS.cs1name(end-7:end-4))];
cs = [cs, str2double(Stim.CS.cs2name(end-7:end-4))];
cs = [cs, str2double(Stim.CS.cs3name(end-7:end-4))];
cs = [cs, str2double(Stim.CS.cs4name(end-7:end-4))];
cs = [cs, str2double(Stim.CS.cs5name(end-7:end-4))];
cs = [cs, str2double(Stim.CS.cs6name(end-7:end-4))];
cs = [cs, str2double(Stim.CS.cs7name(end-7:end-4))];
cs = [cs, str2double(Stim.CS.cs8name(end-7:end-4))];
cs = [cs, str2double(Stim.CS.cs9name(end-7:end-4))];
cs = [cs, str2double(Stim.CS.cs10name(end-7:end-4))];
if sum(isnan(cs))>0,
    warning('One of your CS''s doesn''t have a number please change it')
    
end
valToGetty(20:2:20+(9*2)) = floor(cs./256);
valToGetty(21:2:21+(9*2)) = mod(cs,256);

%% click at no-US?

%% reward
% open time
valToGetty(36) = floor((Timers.Event.us.startDelay*1000)/256);
valToGetty(37) = mod((Timers.Event.us.startDelay*1000),256);

currentCue = TaskOp.(TaskOp.curSetup).trialOrder(TaskOp.count.seq,1);
% programmed probabilities for CS shown on current trial
valToGetty(38) = Stim.us.probability(currentCue);
valToGetty(40) = Stim.us.probabilitySocial(currentCue);
valToGetty(42) = Stim.us.probabilityBucket(currentCue);

%% ITI recovery
if isfield(TaskOp.EvntHist,'prev_ITI_base'),
    valToGetty(60) = floor(TaskOp.EvntHist.prev_ITI_base/256); % previous ITI duration base
    valToGetty(61) = mod(TaskOp.EvntHist.prev_ITI_base,256); % previous ITI duration base
    valToGetty(62) = floor(TaskOp.EvntHist.prev_ITI_var/256); % previous ITI duration var
    valToGetty(63) = mod(TaskOp.EvntHist.prev_ITI_var,256); % previous ITI duration var
end

% [this is planned ITI duration]
valToGetty(64) = floor(TaskOp.EvntHist.prev_ITI_rand/256); % planned ITI duration
valToGetty(65) = mod(TaskOp.EvntHist.prev_ITI_rand,256);   % planned ITI duration

% [this is measured ITI duration]
[TH ITI_start_time Empty] = isfield_sk(TaskOp,'EvntHist.ITI_start_time');
if ~Empty
    % trial end @ moShEv/ShEv
    % trial starts @ MoTaLo/StTrial
    prev_ITI_dur = round((TaskOp.EvntHist.cur_trial_start_time-TaskOp.EvntHist.prev_ITI_start_time)*1000);
else
    % first trial
    prev_ITI_dur = 0;
end

% ITI longer than 1 min 5 sec 536 msec is rounded to 65535 msec, because of
% 16 bit limit
if prev_ITI_dur>2^16 
    valToGetty(66) = 255;
    valToGetty(67) = 255;
else
    valToGetty(66) = floor(prev_ITI_dur/256);
    valToGetty(67) = mod(prev_ITI_dur,256); 
end

%% send eye gain values...
% gains = [TaskOp.Cal.Eye.Gain.x, TaskOp.Cal.Eye.Gain.y];
% valToGetty(69:70) = floor(gains/256);
% valToGetty(71:72) = mod(gains,255);

%% send touch interrupt coordinates
if ~isempty(BehaveData.tchInt)
    ersteTeil = floor(BehaveData.tchInt/256);
    zweiteTeil= mod(BehaveData.tchInt,255);
    valToGetty(73:74) = ersteTeil;
    valToGetty(75:76) = zweiteTeil;
end

%% send voltage P.O.R.
% Oct 21, 2009
porx = round(TaskOp.Cal.Eye.Offset.x*100);
pory = round(TaskOp.Cal.Eye.Offset.y*100);
valToGetty(77) = floor(porx/256);
valToGetty(78) = mod(porx,255);
valToGetty(79) = floor(pory/256);
valToGetty(80) = mod(pory,255);