% --- Executes on button press in snofszCheckbox.
function snofszCheckbox_Callback(hObject, eventdata, handles)
% hObject    handle to snofszCheckbox (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)

% Hint: get(hObject,'Value') returns toggle state of snofszCheckbox
global Stim TaskOp

ig = strcmpi(TaskOp.prj,'imp_giving');

% check for "two element-payoff" 
upp = unique(Stim.us.possiblePulses);
aZero = sum(upp==0)>0;
onlyTwo = numel(upp)==2;

% check that we want to run rings and rects
if ig,
    dfield = 'CSon';
else
    dfield = 'choApp';
end

rAndR = strcmpi(Stim.(dfield).type, 'ringRect');

if rAndR && aZero && onlyTwo,
    Stim.(dfield).snofsz = get(handles.snofszCheckbox,'Value');
else
    Stim.(dfield).snofsz = 0;
end

% --- Executes on button press in randSPcheckbox.
function randSPcheckbox_Callback(hObject, eventdata, handles)
