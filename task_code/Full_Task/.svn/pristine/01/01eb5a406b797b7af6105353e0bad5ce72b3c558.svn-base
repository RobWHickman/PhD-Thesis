function varargout = paramGui_IMP_GIVING(varargin)
% PARAMGUI_IMP_GIVING M-file for paramGui_IMP_GIVING.fig
%      PARAMGUI_IMP_GIVING, by itself, creates a new PARAMGUI_IMP_GIVING or raises the existing
%      singleton*.
%
%      H = PARAMGUI_IMP_GIVING returns the handle to a new PARAMGUI_IMP_GIVING or the handle to
%      the existing singleton*.
%
%      PARAMGUI_IMP_GIVING('CALLBACK',hObject,eventData,handles,...) calls the local
%      function named CALLBACK in PARAMGUI_IMP_GIVING.M with the given input arguments.
%
%      PARAMGUI_IMP_GIVING('Property','Value',...) creates a new PARAMGUI_IMP_GIVING or raises the
%      existing singleton*.  Starting from the left, property value pairs are
%      applied to the GUI before paramGui_IMP_GIVING_OpeningFunction gets called.  An
%      unrecognized property name or invalid value makes property application
%      stop.  All inputs are passed to paramGui_IMP_GIVING_OpeningFcn via varargin.
%
%      *See GUI Options on GUIDE's Tools menu.  Choose "GUI allows only one
%      instance to run (singleton)".
%
% See also: GUIDE, GUIDATA, GUIHANDLES

% Edit the above text to modify the response to help paramGui_IMP_GIVING

% Last Modified by GUIDE v2.5 10-Aug-2011 12:04:17

% Begin initialization code - DO NOT EDIT
gui_Singleton = 1;
gui_State = struct('gui_Name',       mfilename, ...
                   'gui_Singleton',  gui_Singleton, ...
                   'gui_OpeningFcn', @paramGui_IMP_GIVING_OpeningFcn, ...
                   'gui_OutputFcn',  @paramGui_IMP_GIVING_OutputFcn, ...
                   'gui_LayoutFcn',  [] , ...
                   'gui_Callback',   []);
if nargin && ischar(varargin{1})
    gui_State.gui_Callback = str2func(varargin{1});
end

if nargout
    [varargout{1:nargout}] = gui_mainfcn(gui_State, varargin{:});
else
    gui_mainfcn(gui_State, varargin{:});
end
% End initialization code - DO NOT EDIT


% --- Executes just before paramGui_IMP_GIVING is made visible.
function paramGui_IMP_GIVING_OpeningFcn(hObject, eventdata, handles, varargin)
% This function has no output args, see OutputFcn.
% hObject    handle to figure
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)
% varargin   command line arguments to paramGui_IMP_GIVING (see VARARGIN)

global Stim TaskOp Timers
% Choose default command line output for paramGui_IMP_GIVING
handles.output = hObject;

% draw in the background axes
A = imread('modig_naked_3','jpg');
image(A,'parent',handles.background)
set(handles.background,'Visible','Off') % hide ticks and tick labels

% load 'defaults' 
ModigTaskLoop('Initialize');

% modify GUI for different projects
if strcmpi(TaskOp.prj,'dictator')
    % title
    set(hObject,'Name','Dictator Project Parameters')
    
    % pulse matrix
    % will eventually include more payoffs????!!!
    prep = get(handles.possiblePulsesEdit, 'Position');   
    set(handles.possiblePulsesEdit, 'Position', [prep(1:2), 10, prep(4)])
    set(handles.possiblePulsesEdit,'String',mat2str(Stim.us.possiblePulses(:,:,1)));
    
    if ~isfield(Stim.choApp,'snofsz') || ~isfield(Stim.choApp,'randSP'),
        Stim.choApp.snofsz = 0;
        Stim.choApp.randSP = 0;
%         disp('snofsz and randsp fields weren''t present. save new params')
    end
    set(handles.snofszCheckbox,'Value',Stim.choApp.snofsz);
    set(handles.randSPcheckbox,'Value',Stim.choApp.randSP);
    
    set(handles.uipanel_rewDetect,'Visible','on') 
    TaskOp.rewardDetection = 1; % GUI candidates
    TaskOp.pRewDetection = 0.2; 

elseif strcmpi(TaskOp.prj,'imp_giving')
    set(handles.possiblePulsesEdit,'String',mat2str(Stim.us.possiblePulses));
    set(handles.distCtrEdit,'String',num2str(Stim.CSon.distCtr));
    
    if ~isfield(Stim.CSon,'snofsz') || ~isfield(Stim.CSon,'randSP'),
        Stim.CSon.snofsz = 0;
        Stim.CSon.randSP = 0;
        disp('snofsz and randsp fields weren''t present. save new params')
    end
    set(handles.snofszCheckbox,'Value',Stim.CSon.snofsz);
    set(handles.randSPcheckbox,'Value',Stim.CSon.randSP);
    
    TaskOp.simOnePlayer = 0;
    
    set(handles.uipanel_rewDetect,'Visible','off')       
end
      
set(handles.interPulseDelayEdit,'String',num2str(Stim.us.interPulseDelay));

% set trial sequence stuff
set(handles.trialSeqLength,'String',num2str(TaskOp.count.total_seq));
set(handles.respBkg,'Value',TaskOp.respBlackBkg );
set(handles.trialsToRoleChange,'String',num2str(TaskOp.roleChangeTrials));
set(handles.roleChangeCorrect,'Value',TaskOp.roleChangeCorrect);

% set tol window stuff
if strcmpi(TaskOp.prj,'imp_giving') 
    set(handles.editTolWindow,'Value',Stim.target.tolerance_window);
elseif strcmpi(TaskOp.prj,'dictator')
    set(handles.editTolWindow,'String',mat2str(Stim.target.tolerance_window));
end

% Update handles structure
guidata(hObject, handles);

