function uipanelSimOnePlayer_SelectionChangeFcn(hObject, eventdata, handles)
% hObject    handle to uipanelSimOnePlayer (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)
global TaskOp

activeRadio = get(hObject,'Tag');
switch activeRadio,
    case 'radiobuttonNoSim',
        TaskOp.simOnePlayer = 0;
    case 'radiobuttonPlayerA',
        TaskOp.simOnePlayer = 'A';
    case 'radiobuttonPlayerB',
        TaskOp.simOnePlayer = 'B';
end


