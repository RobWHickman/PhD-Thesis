% --- Executes on button press in updateParams.
function updateParams_Callback(hObject, eventdata, handles)
% hObject    handle to updateParams (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)
global Stim TaskOp Timers

set(hObject,'String','updating...')
% update reward values
Stim.us.possiblePulses = eval(get(handles.possiblePulsesEdit,'String'));
Stim.us.interPulseDelay = str2double(get(handles.interPulseDelayEdit,'String'));

% reset project counter
TaskOp.count.prjCount = zeros(size(Stim.us.possiblePulses,2),1);

% update type of stimuli and distance to center
selected=get(handles.stimType,'SelectedObject');
str = get(selected,'Tag');

if strcmpi(TaskOp.prj,'imp_giving'),
    dfield = 'CSon';
else
    dfield = 'choApp';
end
Stim.(dfield).type = str(1:end-5);
Stim.(dfield).distCtr = str2double(get(handles.distCtrEdit,'String'));

% assign tolerance window dimensions
Stim.target.tolerance_window = eval(get(handles.editTolWindow,'String'));

% collect trial sequence stuff
TaskOp.count.total_seq  = str2double(get(handles.trialSeqLength,'String'));
TaskOp.respBlackBkg     = get(handles.respBkg,'Value');
TaskOp.roleChangeTrials = str2double(get(handles.trialsToRoleChange,'String'));
TaskOp.roleChangeCorrect= get(handles.roleChangeCorrect,'Value');
TaskOp.count.repChoLimit= str2double(get(handles.repChoLimit,'String'));

% reset sequence counter and generate a new seq
TaskOp.count.seq = 1;
% set for the other setup in the handle in momame
options   = get(handles.trialSeqType, 'String');
selection = get(handles.trialSeqType, 'Value');

switch char(options(selection)),
    case 'Just Random'
        TaskOp.A.trialOrder = [ones(TaskOp.count.total_seq,1), 1+(rand(TaskOp.count.total_seq,1)>0.5)];
        TaskOp.B.trialOrder = [ones(TaskOp.count.total_seq,1), 1+(rand(TaskOp.count.total_seq,1)>0.5)];
    case {'Project Specific','Counterbalanced'}
        conds = size(Stim.us.possiblePulses,2);
        TaskOp.A.trialOrder = ModigRandSeq_DICTATOR(conds, TaskOp.count.total_seq);
        TaskOp.B.trialOrder = ModigRandSeq_DICTATOR(conds, TaskOp.count.total_seq);
end

% call #CS+==#CS-
snofszCheckbox_Callback([],[],handles);
% call randomize stimuli position
randSPcheckbox_Callback([], [], handles);
% update simulation state
% uipanelSimOnePlayer_SelectionChangeFcn(handles.uipanelSimOnePlayer);

% update are in momame
eval(['updateMoMaMe_',TaskOp.prj, ' initialize']);

set(hObject,'String','Update Parameters')
set(hObject,'Value',0)

