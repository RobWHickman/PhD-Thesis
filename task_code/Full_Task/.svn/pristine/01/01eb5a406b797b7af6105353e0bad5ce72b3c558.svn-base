% --- Executes on button press in newSeqPushbutton.
function newSeqPushbutton_Callback(hObject, eventdata, handles)
% hObject    handle to newSeqPushbutton (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)
global TaskOp Stim

conds = size(Stim.us.possiblePulses,2);
TaskOp.A.trialOrder = ModigRandSeq_DICTATOR(conds, TaskOp.count.total_seq);
TaskOp.B.trialOrder = ModigRandSeq_DICTATOR(conds, TaskOp.count.total_seq);                            
TaskOp.count.total_seq = size(TaskOp.(TaskOp.curSetup).trialOrder,1);
TaskOp.count.seq = 1;
% update display
ModigTaskLoop('SeqDisp');
TaskOp.roleChangeCorrect = 0;
activeSetupChange;
TaskOp.count.seq = 1;
TaskOp.count.total_seq = size(TaskOp.(TaskOp.curSetup).trialOrder,1);
% update display
ModigTaskLoop('SeqDisp');
activeSetupChange;
TaskOp.roleChangeCorrect = get(handles.roleChangeCorrect,'Value');

set(handles.trialSeqLength,'String',num2str(TaskOp.count.total_seq))
ModigMessage('m','New trial order');

% --------------------------------------------------------------------
function stimType_SelectionChangeFcn(hObject, eventdata, handles)
% hObject    handle to stimType (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)

global Stim TaskOp

% which one is selected now?
string = get(hObject,'Tag');

if strcmpi(TaskOp.prj,'dictator'),
    Stim.choApp.type = string(1:end-5);
else
    Stim.CSon.type = string(1:end-5);
end

% disable some options if it is value bars and update pulse matrix
vB = 1+strcmpi(string,'valueBarRadio');
options = {'on','off'};
set(handles.randSPcheckbox,'enable',options{vB});
set(handles.snofszCheckbox, 'enable', options{vB});
set(handles.interPulseDelayEdit, 'enable', options{vB});
set(handles.editJuiceTarget, 'enable', options{vB});

if vB==2 && sum(sum(sum(mod(Stim.us.possiblePulses,1)==0)))
    % only integers, change to fractions
    Stim.us.possiblePulses = [1 2 3 2 2; 2 2 2 1 3]/5;
    
    set(handles.interPulseDelayEdit,'UserData', Stim.us.interPulseDelay);
    Stim.us.interPulseDelay = 0;
elseif vB==1 && sum(sum(mod(Stim.us.possiblePulses(:,:,1),1)))>0;
    % fractions, change to integers
    Stim.us.possiblePulses = [1 2 3 2 2; 2 2 2 1 3];
    
    Stim.us.interPulseDelay = get(handles.interPulseDelayEdit,'UserData');
end
set(handles.possiblePulsesEdit, 'String', mat2str(Stim.us.possiblePulses(:,:,1)))
possiblePulsesEdit_Callback(handles.possiblePulsesEdit)
set(handles.interPulseDelayEdit, 'String', num2str(Stim.us.interPulseDelay));

% Update handles structure
guidata(hObject, handles);

