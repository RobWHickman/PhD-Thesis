function runned = ModigPrepareTrial_OBS_LEARNFIX
% Prepares trial parameters in project 'OBS_LEARNFIX'
%
%   Events:
%  
% pre_trial   
% touchHold  
% central fixation
% choApp (choices appear)      
% goSignal    
% choAcq
% us          
% post_trial  
% ITI         
% error 
%
% RBM/FG 3.12
global Stim TaskOp VisParam Timers MENUs UserInfo ExtDevice ModigDir

%% initialize variables/ modifiable variables.
% variables in the GUI
if ~isfield(MENUs,'paramGui_OBS_LEARN') || strcmpi(MENUs.paramGui_OBS_LEARN.status,'OFF')
    TaskOp.count.total_seq = 50; %was 50
    TaskOp.count.prob_seq  = 50; %was 20
    Stim.us.probability = [.5 .85];
    Stim.us.target      = 0.5;
    Stim.us.lists       = zeros(TaskOp.count.total_seq,2);
    Stim.us.doMinimalReward= 1;
    Stim.us.minimalReward = 0.1;%in ml
    imagePath = ModigDir.Images;
    Stim.choApp.cs1name = [imagePath,'\Picture 001.jpg'];
    Stim.choApp.cs2name = [imagePath,'\Picture 002.jpg'];
    Stim.choApp.cs3name = [imagePath,'\Picture 003.jpg'];
    Stim.choApp.cs4name = [imagePath,'\Picture 004.jpg'];

    TaskOp.roleChangeCorrect = 1;
    TaskOp.respBlackBkg     = 1;
    TaskOp.roleChangeTrials = 1;
    TaskOp.obsLearnFix.oneLearnSet = 0;    
    TaskOp.obsLearnix.learnSetSwitch = 0;
    TaskOp.obsLearnFix.switchCriterion = 2;
    TaskOp.pavlovianObsLearn = 0;
end
TaskOp.pavlovianObsLearn=0;
% read and double-check if we are running pavlovian O.L.
% if isfield(MENUs.paramGui_IMP_GIVING,'checkboxActivatePavlovian') && ishandle(MENUs.paramGui_OBS_LEARN.checkboxActivatePavlovian)
%     myGuiValue = get(MENUs.paramGui_IMP_GIVING.checkboxActivatePavlovian, 'value');
%     if TaskOp.pavlovianObsLearn~=myGuiValue,
%         disp('inchoerence')
%         keyboard
%     end
% else
%     TaskOp.pavlovianObsLearn = 0;
% end
setupB = strcmp(TaskOp.curSetup,'B');
%% 1-agent learning set
% check if we switch learning sets in this trial
% How many trials have passed since starting? Are they equal the criterion?
if TaskOp.obsLearnFix.oneLearnSet==1 && (TaskOp.count.seq >= TaskOp.obsLearnFix.switchCriterion),
   TaskOp.obsLearnFix.learnSetSwitch = 1;
   TaskOp.count.seq = 0;
end
%%  reward probability lists 

if TaskOp.readRewardList==1&&TaskOp.count.choice==1
% if we start a new experiment/reward sequence
%   
% look up and read file using list number (it comes from the gui)
%   Stim.choApp.rewardList
% pass the vector to "Stim.us.lists"
    if Stim.choApp.rewardList == 1
        load OBS_LEARNFIX_rewardList1.txt
        Stim.us.lists = OBS_LEARNFIX_rewardList1';
    end      
    if ~isfield(TaskOp.count,'choices') || size(TaskOp.count.choices,1)==1,
        TaskOp.count.choices = zeros(2);
    end
elseif TaskOp.readRewardList==1&&TaskOp.count.choice<1    
    
else
    if ~isfield(TaskOp.count,'choices') || size(TaskOp.count.choices,1)==1,
        TaskOp.count.choices = zeros(2);
    end

    if ~isfield(TaskOp.count,'prob_seq'),
        TaskOp.count.prob_seq = 20;
    end

    % check that the list of rewards is the same size as the requested sequence
    % size
    if length(Stim.us.lists) ~= TaskOp.count.prob_seq,
        Stim.us.lists = zeros(TaskOp.count.prob_seq,2);
    end

    if mod(TaskOp.count.choices(setupB+1,1),TaskOp.count.prob_seq)==0 || sum(TaskOp.count.choices(setupB+1,:))==0
        Stim.us.lists(:,1) = RewardSeqGenerator(Stim.us.probability(1)*100,TaskOp.count.prob_seq);
    end
    if mod(TaskOp.count.choices(setupB+1,2),TaskOp.count.prob_seq)==0 || sum(TaskOp.count.choices(setupB+1,:))==0
        Stim.us.lists(:,2) = RewardSeqGenerator(Stim.us.probability(2)*100,TaskOp.count.prob_seq);
    end

end


%% create trial list (Left-Right) and condition
if~isfield(TaskOp,TaskOp.curSetup) || ~isfield(TaskOp.(TaskOp.curSetup),'trialOrder');
    TaskOp.(TaskOp.curSetup).trialOrder = [];
end
countPassed = TaskOp.count.seq > TaskOp.count.total_seq; % does it happen?
tooShortList = TaskOp.count.seq <= 1;
noSequence = isempty(TaskOp.(TaskOp.curSetup).trialOrder);
listTooShort = TaskOp.count.seq > size(TaskOp.(TaskOp.curSetup).trialOrder,1);
if  countPassed || tooShortList || noSequence || listTooShort
    TaskOp.count.seq = 1; %re-start sequence counter
    
    if TaskOp.pavlovianObsLearn==1,
        % trial sequence: [trial type, lqeft/right OR CS#1/CS#2]
        % trial type: 1=choice, 2=pavlovian
        demoRepeats = Stim.choApp.repeats;
        pavSeq = ModigRandSeq_DICTATOR(1, demoRepeats*2);
        choSeq = ModigRandSeq_DICTATOR(1, TaskOp.count.total_seq);
        choSeq(:,1) = 2;
        TaskOp.(TaskOp.curSetup).trialOrder = [pavSeq; choSeq];
    else
        TaskOp.(TaskOp.curSetup).trialOrder = ModigRandSeq_DICTATOR(1, ...
            TaskOp.count.total_seq);
    end
end

% tolerance window size
Stim.goSignal.tolerance_window = repmat([175 125],2,1); %was [250 125]
%% create whole window if we don't have one yet
persistent wholeWindow
windowPtrs=Screen('Windows');
kind=Screen(windowPtrs, 'WindowKind');

if isempty(wholeWindow) && sum(kind==1)==2,
    [VisParam.scr_handle, VisParam.scr_rect] = Screen('OpenWindow',1, 0);
    TaskOp.curSetup = 'A';
    activeSetupChange;
    wholeWindow = 1;
    
    if UserInfo.use_split==1,
        UserInfo.use_split = 0;
    end
end
scrCtr = VisParam.scr_rect(3:4)/2;


%% central fixation parameters
% (x,y) from mon center
Stim.centralFix.center = scrCtr; 

if ~isfield(Stim.centralFix,'default') || Stim.centralFix.default == 1,
    Stim.centralFix.hand.req            = 1;
    
    Stim.centralFix.size = [10 20]; %was [10 10] 

    cF = Stim.centralFix;
    Stim.centralFix.position = [cF.center-cF.size(1),...
                                cF.center+cF.size(2)];

    % [rgb] (0-256, ptb; 0-1, matlab
    Stim.centralFix.color               = [0 256 256]; %[256 0 256] for touch choice [0 256 256] for eye choice

    Stim.centralFix.tolerance_window    = 150; % was 200

    Stim.centralFix.filter_time         = 2.0;
    Stim.centralFix.hold                = 1.5; %was 2
    Stim.centralFix.holdTime            = 0.5; %was 0.25;
    Stim.centralFix.eyeInterrupt        = 1;
    
    Stim.centralFix.default             = 1;
end

[Stim.centralFix.tolWin  Stim.centralFix.tolWinHdl] = createTolWin2(Stim.centralFix.center, Stim.centralFix.tolerance_window);
% generate a second tolerance window handle
[Stim.centralFix.tolWin  Stim.centralFix.tolWinHdl(2)] = createTolWin2(Stim.centralFix.center, Stim.centralFix.tolerance_window);
%% CSs
if TaskOp.pavlovianObsLearn,
    Stim.choApp.distCtr = 0;
else
    Stim.choApp.distCtr = 225; % distance from image center to monitor's center
end
Stim.choApp.width   = 100; % distance from the center of the image to its edge
Stim.choApp.heigth  = 100;

Stim.choApp.type    = 'img';

% monitor composition-->stim arrangement
bIsActive = strcmp(TaskOp.curSetup,'B');
if bIsActive
    distCtr = [Stim.choApp.distCtr; -Stim.choApp.distCtr]; % changes Left/right
else
    distCtr = [-Stim.choApp.distCtr; Stim.choApp.distCtr];
end
scrCtr = repmat(VisParam.scr_rect(3:4)/2,2,1);

Stim.choApp.center = [scrCtr(:,1), scrCtr(:,2)-distCtr];

switch Stim.choApp.type,
    case 'img'
        % image per se, flips L-R based on trial order
        l = TaskOp.(TaskOp.curSetup).trialOrder(TaskOp.count.seq,2);
%         l=2; %FG: l=2 for CS2 on left, use for side training, see
%         JudgeSit for arming left vs right 
        Stim.choApp.CSsides      = [l 3-l];
        Stim.choApp.csfname{l}   = Stim.choApp.cs1name;
        Stim.choApp.csfname{3-l} = Stim.choApp.cs2name;
        %% 1-agent learning set
        if TaskOp.obsLearnFix.oneLearnSet==1 && ((TaskOp.obsLearnFix.learnSetSwitch==0 && bIsActive) || (TaskOp.obsLearnFix.learnSetSwitch==1 && ~bIsActive))
            Stim.choApp.csfname{l}   = Stim.choApp.cs3name;
            Stim.choApp.csfname{3-l} = Stim.choApp.cs4name;
        end
        fprintf('Learn set switch state = %d\n',TaskOp.obsLearnFix.learnSetSwitch)
        
        % position, 
        Stim.choApp.position = zeros(2,4);
        c = Stim.choApp.center;
        w = Stim.choApp.width;
        h = Stim.choApp.heigth;

        Stim.choApp.position(1,:) = [c(1,1)-w, c(1,2)-h, c(1,1)+w, c(1,2)+h];
        Stim.choApp.position(2,:) = [c(2,1)-w, c(2,2)-h, c(2,1)+w, c(2,2)+h];
end

%% goSignal 
Stim.goSignal.size = repmat([100, 200],2,1); 
Stim.goSignal.position = zeros(2,4);
Stim.goSignal.size = Stim.goSignal.size(:,[2,1]); 
if bIsActive,
    Stim.goSignal.center   = [Stim.goSignal.size(:,1),...
        VisParam.scr_rect(4)-Stim.choApp.center(:,2)];
else
    Stim.goSignal.center = [VisParam.scr_rect(3)-(Stim.goSignal.size(:,1)),...
        VisParam.scr_rect(4)-Stim.choApp.center(:,2)];
end
Stim.goSignal.position = [Stim.goSignal.center-Stim.goSignal.size,...
                        Stim.goSignal.center+Stim.goSignal.size];
Stim.goSignal.color = [0 0 192];

%% US
calibrateJuiceDelivery('us', Stim.us.target, 0, 1);
 
%% BEHAVIOR CONTROL VARIABLES
Stim.pre_trial = [];

%
Stim.touchHold = [];
if ~TaskOp.pavlovianObsLearn,
    Stim.touchHold.handInterrupt = 1;
    Stim.touchHold.hand.filter_time = Timers.Event.touchHold.StartDelay-0.6;
    Stim.touchHold.hold = 1;
    Stim.touchHold.holdTime = 0.5;
    
    Stim.centralFix.hand.req    = 1;
    Stim.centralFix.eye.req     = 'centralFixation';
    Stim.centralFix.hold        = 1;
    Stim.centralFix.holdTime    = 0.5;
    Stim.centralFix.eyeInterrupt= 1;
    Stim.centralFix.filterTime  = Timers.Event.centralFix.StartDelay-Stim.centralFix.holdTime;
    
    Stim.choApp.hand.req = 1;
    Stim.choApp.eye.req = 1;
    Stim.choApp.hold    = 1;
    Stim.choApp.eye.req = 'centralFixation';

    Stim.goSignal.filter_time = Timers.Event.goSignal.StartDelay-0.2;
%     Stim.goSignal.req = 'twoTouchAreas'; %use this for touch choice
    Stim.goSignal.req = 'choiceFixation'; %FG use this for saccade choice

    % IF the effector is arm movement.
%     [Stim.goSignal.touchLimits  Stim.goSignal.tolWinHdl] = ...
%     createTolWin2(Stim.goSignal.center, Stim.goSignal.tolerance_window);

    % if the effectoir is eye movement
    tchCtr = Stim.choApp.center([1 4; 2 3]);
    [Stim.goSignal.touchLimits  Stim.goSignal.tolWinHdl] = createTolWin2(tchCtr, Stim.goSignal.tolerance_window);
    
else
    Stim.touchHold.handInterrupt = 0;
    Stim.touchHold.hold = 0;
    Stim.touchHold.holdTime = 0;

    Stim.touchHold.hand = [];
    Stim.goSignal.handReq = [];
    Stim.goSignal.req = [];
end


%% TaskOp trial variables initialization
TaskOp.handInterrupt = 0;
TaskOp.interrupt = 0;
TaskOp.hold = 0;
TaskOp.holdTime = 0;

TaskOp.choice = 0; 

runned = 1;