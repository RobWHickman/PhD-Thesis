This function is called by:
<ul style="list-style-image:url(../../../../matlabicon.gif)">
</ul>
<!-- crossreference -->



<h2><a name="_source"></a>SOURCE CODE <a href="#_top"><img alt="^" border="0" src="../../../../up.png"></a></h2>
<div class="fragment"><pre>0001 <a name="_sub0" href="#_subfunctions" class="code">function valToGetty = ModigMakeGettyArray_OBS_LEARN</a>
0002 <span class="comment">% valToGetty = ModigMakeGettyArray_OBS_LEARN</span>
0003 <span class="comment">%</span>
0004 <span class="comment">% Make a vector to send to Getty in OBS_LEARN project.</span>
0005 <span class="comment">% Note that shares task number (24), Imperative giving AND dictator, this</span>
0006 <span class="comment">% one is the &quot;pavlovian&quot; version (in terms of labels in getty).</span>
0007 <span class="comment">%</span>
0008 <span class="comment">% Right now only 40 to 59 are free</span>
0009 <span class="comment">%</span>
0010 <span class="comment">% rbm 11.10</span>
0011 
0012 <span class="keyword">global</span> Stim Task TaskOp Timers BehaveData
0013 
0014 valToGetty = zeros(1,80);
0015 
0016 <span class="comment">%% basic stuff</span>
0017 <span class="comment">% 1. fixed</span>
0018 valToGetty(1) = length(valToGetty); <span class="comment">% numb of additional vars</span>
0019 
0020 <span class="comment">% 2. taskNumb</span>
0021 valToGetty(2) = 24;  
0022 
0023 <span class="comment">% 3. combined trial type (bhvsit)</span>
0024 
0025 <span class="comment">% 0 | 1</span>
0026 stimLeft = TaskOp.(TaskOp.curSetup).trialOrder(TaskOp.count.seq,2)-1; 
0027 <span class="comment">% 0 | 6</span>
0028 actor    = strcmp(TaskOp.curSetup,<span class="string">'B'</span>)*6;                               
0029 <span class="comment">% 1 | 3 | 5: 1, imperative; 3, pavlovian; 5, choice</span>
0030 tk = 3;
0031 
0032 <span class="comment">% steps of 12 'labels'</span>
0033 condition= 12*(TaskOp.(TaskOp.curSetup).trialOrder(TaskOp.count.seq,1)-1);
0034 
0035 valToGetty(3) = (actor + stimLeft + tk + condition);
0036 
0037 <span class="comment">% longest possible trial length (w/o error time added)</span>
0038 taFi = fields(Task);
0039 trLAll   = 0;
0040 trLTimer = 0;
0041 
0042 <span class="keyword">for</span> i = 1:length(taFi)
0043     trLAll = trLAll + Timers.Event.(taFi{i}).StartDelay;
0044     <span class="keyword">if</span> ~strcmpi(taFi{i},<span class="string">'error'</span>)
0045         trLTimer = trLTimer + Timers.Event.(taFi{i}).StartDelay;        
0046     <span class="keyword">end</span>
0047 <span class="keyword">end</span>
0048 
0049 trLNoITI = trLTimer - Timers.Event.ITI.StartDelay;
0050 trLNoITI = max(trLNoITI)*1000;
0051 valToGetty(4) = floor(trLNoITI/256);
0052 valToGetty(5) = mod(trLNoITI,256);
0053 
0054 <span class="comment">% disp(sprintf('no ITI: %g  all epochs: %g ',max(trLNoITI)*1000, trLTimer))</span>
0055 
0056 TaskOp.trLTimer = trLTimer;
0057 
0058 <span class="comment">%% stim params,</span>
0059 
0060 <span class="comment">% picture IDs</span>
0061 cs1 = str2double(Stim.choApp.cs1name(end-7:end-4));
0062 cs2 = str2double(Stim.choApp.cs2name(end-7:end-4));
0063 valToGetty(6) = floor(cs1/256); 
0064 valToGetty(7) = mod(cs1,256); 
0065 valToGetty(8) = floor(cs2/256); 
0066 valToGetty(9) = mod(cs2,256); 
0067 
0068 <span class="comment">% CS position</span>
0069 valToGetty(10) = floor(Stim.choApp.distCtr/256);
0070 valToGetty(11) = mod(Stim.choApp.distCtr,256);
0071 valToGetty(12) = floor(Stim.choApp.width/256);
0072 valToGetty(13) = mod(Stim.choApp.width,256);
0073 valToGetty(14) = floor(Stim.choApp.heigth/256);
0074 valToGetty(15) = mod(Stim.choApp.heigth,256);
0075 
0076 <span class="comment">% go signal -&gt;we need the size [W H]</span>
0077 tPos1 = floor(Stim.target.size(1,:)/256);
0078 tPos2 = mod(Stim.target.size(1,:),256);
0079 
0080 valToGetty(16:2:18) = tPos1;
0081 valToGetty(17:2:19) = tPos2;
0082 
0083 <span class="comment">%% TOUCH tolerance window</span>
0084 tl1 = floor(Stim.target.touchLimits/256);
0085 tl2 = mod(Stim.target.touchLimits,256);
0086 
0087 valToGetty(20:2:26) = tl1(1,:);
0088 valToGetty(21:2:27) = tl2(1,:);
0089 valToGetty(28:2:34) = tl1(2,:);
0090 valToGetty(29:2:35) = tl2(2,:);
0091 
0092 <span class="comment">%% reward</span>
0093 <span class="comment">% open time</span>
0094 valToGetty(36) = floor((Timers.Event.us.startDelay*1000)/256);
0095 valToGetty(37) = mod((Timers.Event.us.startDelay*1000),256);
0096 
0097 <span class="comment">% reward probability,</span>
0098 valToGetty(38:39) = Stim.us.probability*100;
0099 
0100 
0101 <span class="comment">%% ITI recovery</span>
0102 <span class="keyword">if</span> isfield(TaskOp.EvntHist,<span class="string">'prev_ITI_base'</span>),
0103     valToGetty(60) = floor(TaskOp.EvntHist.prev_ITI_base/256); <span class="comment">% previous ITI duration base</span>
0104     valToGetty(61) = mod(TaskOp.EvntHist.prev_ITI_base,256); <span class="comment">% previous ITI duration base</span>
0105     valToGetty(62) = floor(TaskOp.EvntHist.prev_ITI_var/256); <span class="comment">% previous ITI duration var</span>
0106     valToGetty(63) = mod(TaskOp.EvntHist.prev_ITI_var,256); <span class="comment">% previous ITI duration var</span>
0107 <span class="keyword">end</span>
0108 
0109 <span class="comment">% [this is planned ITI duration]</span>
0110 valToGetty(64) = floor(TaskOp.EvntHist.prev_ITI_rand/256); <span class="comment">% planned ITI duration</span>
0111 valToGetty(65) = mod(TaskOp.EvntHist.prev_ITI_rand,256);   <span class="comment">% planned ITI duration</span>
0112 
0113 <span class="comment">% [this is measured ITI duration]</span>
0114 [TH ITI_start_time Empty] = <a href="../../../../Modig/library/isfield_sk.html" class="code" title="function [TF,value empty] = isfield_sk(stem, fullname)">isfield_sk</a>(TaskOp,<span class="string">'EvntHist.ITI_start_time'</span>);
0115 <span class="keyword">if</span> ~Empty
0116     <span class="comment">% trial end @ moShEv/ShEv</span>
0117     <span class="comment">% trial starts @ MoTaLo/StTrial</span>
0118     prev_ITI_dur = round((TaskOp.EvntHist.cur_trial_start_time-TaskOp.EvntHist.prev_ITI_start_time)*1000);
0119 <span class="keyword">else</span>
0120     <span class="comment">% first trial</span>
0121     prev_ITI_dur = 0;
0122 <span class="keyword">end</span>
0123 
0124 <span class="comment">% ITI longer than 1 min 5 sec 536 msec is rounded to 65535 msec, because of</span>
0125 <span class="comment">% 16 bit limit</span>
0126 <span class="keyword">if</span> prev_ITI_dur&gt;2^16 
0127     valToGetty(66) = 255;
0128     valToGetty(67) = 255;
0129 <span class="keyword">else</span>
0130     valToGetty(66) = floor(prev_ITI_dur/256);
0131     valToGetty(67) = mod(prev_ITI_dur,256); 
0132 <span class="keyword">end</span>
0133 
0134 <span class="comment">%% send eye gain values...</span>
0135 <span class="comment">% gains = [TaskOp.Cal.Eye.Gain.x, TaskOp.Cal.Eye.Gain.y];</span>
0136 <span class="comment">% valToGetty(68:69) = floor(gains/256);</span>
0137 <span class="comment">% valToGetty(70:71) = mod(gains,256);</span>
0138 
0139 <span class="comment">%% send touch interrupt coordinates</span>
0140 <span class="keyword">if</span> ~isempty(BehaveData.tchInt)
0141     ersteTeil = floor(BehaveData.tchInt/256);
0142     zweiteTeil= mod(BehaveData.tchInt,255);
0143     valToGetty(73:74) = ersteTeil;
0144     valToGetty(75:76) = zweiteTeil;
0145 <span class="keyword">end</span>
0146 
0147 <span class="comment">%% send voltage P.O.R.</span>
0148 <span class="comment">% Oct 21, 2009</span>
0149 porx = round(TaskOp.Cal.Eye.Offset.x*100);
0150 pory = round(TaskOp.Cal.Eye.Offset.y*100);
0151 valToGetty(77) = floor(porx/256);
0152 valToGetty(78) = mod(porx,255);
0153 valToGetty(79) = floor(pory/256);
0154 valToGetty(80) = mod(pory,255);</pre></div>
