<h2><a name="_source"></a>SOURCE CODE <a href="#_top"><img alt="^" border="0" src="../../../../up.png"></a></h2>
<div class="fragment"><pre>0001 <a name="_sub0" href="#_subfunctions" class="code">function updateMoMaMe_EYECAL(option)</a>
0002 <span class="comment">% updateMoMaMe_EYECAL(option)</span>
0003 <span class="comment">%</span>
0004 <span class="comment">% creates a project specific and totally modifiable update area in the</span>
0005 <span class="comment">% MOMaMe figure using uicontrols.</span>
0006 <span class="comment">%</span>
0007 <span class="comment">% inputs: 'initialize' --&gt;creates the uicontrols</span>
0008 <span class="comment">%         'update' --&gt; updates the counters.</span>
0009 <span class="comment">%         'reset' --&gt; resets the counters</span>
0010 <span class="comment">%</span>
0011 <span class="comment">% rbm 07.09</span>
0012 
0013 <span class="keyword">global</span> MENUs TaskOp
0014 <span class="comment">% global Stim  Timers Task</span>
0015 figHdl = MENUs.ModigMainMenu.handle;
0016 upArea = MENUs.ModigMainMenu.handles.prjUpArea;
0017 
0018 <span class="comment">%</span>
0019 <span class="keyword">if</span> nargin == 0,
0020     option = <span class="string">'initialize'</span>;
0021 <span class="keyword">end</span>
0022 
0023 <span class="keyword">switch</span> option,
0024     <span class="keyword">case</span> <span class="string">'initialize'</span>,
0025         <span class="comment">% change Area name,</span>
0026         set(upArea,<span class="string">'Units'</span>,<span class="string">'pixels'</span>)
0027         set(upArea,<span class="string">'Title'</span>, TaskOp.prj)    
0028 
0029         <span class="comment">% delete previous children objects</span>
0030         kids = get(upArea,<span class="string">'Children'</span>);
0031         delete (kids)
0032         
0033         <span class="comment">%% start error counters,</span>
0034         TaskOp.count.errors = zeros(5,1);
0035         
0036         <span class="comment">%% code for Ui controls</span>
0037          uicontrol(upArea, <span class="string">'style'</span>, <span class="string">'text'</span>, <span class="string">'units'</span>, <span class="string">'pixels'</span>,<span class="keyword">...</span><span class="comment">    </span>
0038             <span class="string">'position'</span>, [10 120 300 15],<span class="keyword">...</span><span class="comment"> </span>
0039             <span class="string">'fontSize'</span>, 9,<span class="keyword">...</span>
0040             <span class="string">'backgroundColor'</span>, [0.831 0.816 0.784],<span class="keyword">...</span>
0041             <span class="string">'tag'</span>, <span class="string">'conditionsText'</span>,<span class="string">'String'</span>,<span class="string">'Conditions:   Count:                 Error Types:   Error count'</span>)
0042         
0043         conds = unique(TaskOp.count.trialOrder(:,1));
0044         uicontrol(upArea, <span class="string">'style'</span>, <span class="string">'text'</span>, <span class="string">'units'</span>, <span class="string">'pixels'</span>,<span class="keyword">...</span><span class="comment">    </span>
0045             <span class="string">'position'</span>, [50 10 40 110],<span class="keyword">...</span><span class="comment"> </span>
0046             <span class="string">'fontSize'</span>, 9,<span class="keyword">...</span>
0047             <span class="string">'backgroundColor'</span>, [0.831 0.816 0.784],<span class="keyword">...</span>
0048             <span class="string">'tag'</span>, <span class="string">'condsText2'</span>, <span class="string">'string'</span>, num2str(conds));
0049          
0050         uicontrol(upArea, <span class="string">'style'</span>, <span class="string">'text'</span>, <span class="string">'units'</span>, <span class="string">'pixels'</span>,<span class="keyword">...</span>
0051             <span class="string">'position'</span>, [90 10 40 110],<span class="keyword">...</span><span class="comment"> </span>
0052             <span class="string">'fontSize'</span>, 9, <span class="keyword">...</span>
0053             <span class="string">'backgroundColor'</span>, [0.831 0.816 0.784],<span class="keyword">...</span>
0054             <span class="string">'tag'</span>, <span class="string">'optionsValues'</span>, <span class="keyword">...</span>
0055             <span class="string">'string'</span>,num2str(TaskOp.count.prjCount))   
0056 
0057         errStr = {<span class="string">'lost KT'</span>; <span class="string">'no CF'</span>; <span class="string">'lost CF'</span>; <span class="string">'no PF'</span>; <span class="string">'lost PF'</span>};
0058         uicontrol(upArea, <span class="string">'style'</span>, <span class="string">'text'</span>, <span class="string">'units'</span>, <span class="string">'pixels'</span>,<span class="keyword">...</span>
0059             <span class="string">'position'</span>, [190 10 40 110],<span class="keyword">...</span><span class="comment"> </span>
0060             <span class="string">'fontSize'</span>, 9, <span class="keyword">...</span>
0061             <span class="string">'backgroundColor'</span>, [0.831 0.816 0.784],<span class="keyword">...</span>
0062             <span class="string">'tag'</span>, <span class="string">'errorStrings'</span>, <span class="keyword">...</span>
0063             <span class="string">'string'</span>,errStr)    
0064         
0065          uicontrol(upArea, <span class="string">'style'</span>, <span class="string">'text'</span>, <span class="string">'units'</span>, <span class="string">'pixels'</span>,<span class="keyword">...</span>
0066             <span class="string">'position'</span>, [255 10 40 110],<span class="keyword">...</span><span class="comment"> </span>
0067             <span class="string">'fontSize'</span>, 9, <span class="keyword">...</span>
0068             <span class="string">'backgroundColor'</span>, [0.831 0.816 0.784],<span class="keyword">...</span>
0069             <span class="string">'tag'</span>, <span class="string">'errorsValues'</span>, <span class="keyword">...</span>
0070             <span class="string">'string'</span>,num2str(TaskOp.count.errors))  
0071         
0072          <span class="comment">% update gui handles</span>
0073         uih = guihandles(figHdl);
0074         guidata(figHdl, uih);
0075 
0076         <span class="comment">% update our globals</span>
0077         MENUs.ModigMainMenu.handles = <a href="../../../../Modig/library/sort_structure.html" class="code" title="function structure_out = sort_structure(structure)">sort_structure</a>(uih);
0078         MENUs.ModigMainMenu.handle  = figHdl;  
0079         
0080     <span class="keyword">case</span> <span class="string">'reset'</span>,
0081         TaskOp.count.errors   = zeros(size(TaskOp.count.errors));
0082         TaskOp.count.prjCount = zeros(size(TaskOp.count.prjCount));
0083         
0084         <a href="updateMoMaMe_EYECAL.html" class="code" title="function updateMoMaMe_EYECAL(option)">updateMoMaMe_EYECAL</a>(<span class="string">'update'</span>);
0085     <span class="keyword">case</span> <span class="string">'update'</span>,
0086         <span class="keyword">if</span> TaskOp.correct,
0087             row = TaskOp.count.trialOrder(TaskOp.count.seq,1);
0088             TaskOp.count.prjCount(row) = TaskOp.count.prjCount(row)+1;
0089 <span class="comment">%         else</span>
0090         <span class="keyword">end</span>
0091         set(MENUs.ModigMainMenu.handles.optionsValues, <span class="string">'string'</span>,num2str(TaskOp.count.prjCount))
0092         set(MENUs.ModigMainMenu.handles.errorsValues,  <span class="string">'string'</span>,num2str(TaskOp.count.errors))
0093 <span class="keyword">end</span></pre></div>
