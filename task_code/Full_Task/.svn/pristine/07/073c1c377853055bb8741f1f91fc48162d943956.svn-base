function cb = ModigPreparePages_IMP_GIVING
%  cb = ModigPreparePages_IMP_GIVING
%
% page 1: background
% page 2: CS on
% page 3: touch target
% page 4: actor target touched feedback, target area dissapears 
%           but with different flip as page 2!
% page 5: actor CS dissapears, receiver CS stays
% page 6: black background
%
% See also EXPSHOWIMAGE, EXPDRAWRECT, MODIGMONITORBEHAVIOR, DRAWRECT

% RBM 06.08
% rbm 0.11 value bars
global Tbl VisParam Stim TaskOp

% prepare VisParam params
VisParam.pages    = unique(cell2mat(Tbl.TaskTbl(:,Tbl.TaskTblColumnID.vis_page)));
VisParam.pages    = VisParam.pages(VisParam.pages>0);
VisParam.num_page = length(VisParam.pages);

%% page 1. background str
% String for Drawing with PTB on subject's screen the fixation spot,
bkgstr   = 'Screen(''FillRect'', VisParam.scr_handle, [127 127 127]);';

%% page 2. all CS's
% draw CS on or load CS on image
cs = Stim.CSon;
% csPos = num2str(cs.position);
switch cs.type
    case 'valueBar'
        if Stim.us.pulses(1)>0 || cs.showZeroImg==1,
            [csstrRe ringHdlRe] = drawValueBar(Stim.us.pulses(1), Stim.CSon.herClr, ...
                Stim.CSon.position(1,:), VisParam.h_MONITOR_AXIS, 4,...
                'scrCenter',VisParam.scr_rect(3:4)/2,...
                'rect_size',Stim.CSon.rect_size);
        else
            csstrRe = '1;';
            ringHdlRe = zeros(1,4);
        end
        
        if Stim.us.pulses(2)>0 || cs.showZeroImg==1,
            [csstrDi ringHdlDi] = drawValueBar(Stim.us.pulses(2), Stim.CSon.meClr, ...
                Stim.CSon.position(2,:), ...
                VisParam.h_MONITOR_AXIS, 4,...
                'scrCenter',VisParam.scr_rect(3:4)/2,...
                'rect_size',Stim.CSon.rect_size);
        else
            csstrDi = '1;';
            ringHdlDi = zeros(1,4);
        end
        
    case 'img'
        [csstrRe ringHdlRe] = drawImages(cs.fname, cs.position, VisParam.h_MONITOR_AXIS, 4,90);
        csstrDi = '1;';
        ringHdlDi = zeros(1,4);
    case {'ring','boxedRing'}
         % POSITION(pulses,rect,respOrdict)
        if Stim.us.pulses(1)>0,
            [csstrRe ringHdlRe]  = drawRings(cs.herClr, cs.position(:,:,1), VisParam.h_MONITOR_AXIS, 4);
        else
            csstrRe ='1;';
            ringHdlRe = zeros(1,4);
        end
        if Stim.us.pulses(2)>0,
            [csstrDi ringHdlDi]  = drawRings(cs.meClr, cs.position(:,:,2), VisParam.h_MONITOR_AXIS, 4);
        else
            csstrDi = '1;'; 
            ringHdlDi=zeros(1,4);
        end
    case {'ringRect'}
         % POSITION(pulses,rect,respOrdict)
        if Stim.us.pulses(1)>0,
            [csstrRe ringHdlRe]  = drawRings(cs.herClr, cs.position(:,:,1), VisParam.h_MONITOR_AXIS, 4);
        else
            [csstrRe ringHdlRe]  = drawFrameRect(cs.herClr, cs.position(:,:,1),5, VisParam.h_MONITOR_AXIS, 4);
        end
        if Stim.us.pulses(2)>0,
            [csstrDi ringHdlDi]  = drawRings(cs.meClr, cs.position(:,:,2), VisParam.h_MONITOR_AXIS, 4);
        else
            [csstrDi ringHdlDi]  = drawFrameRect(cs.meClr, cs.position(:,:,2),5, VisParam.h_MONITOR_AXIS, 4);
        end
    case 'dreiEck'
         % POSITION(pulses,rect,respOrdict)
        if Stim.us.pulses(1)>0,
            [csstrRe ringHdlRe]  = drawTriangle(cs.herClr, cs.position(:,:,1), VisParam.h_MONITOR_AXIS, 4,1);
        else
            csstrRe ='1;';
            ringHdlRe = zeros(1,4);
        end
        if Stim.us.pulses(2)>0,
            [csstrDi ringHdlDi]  = drawTriangle(cs.meClr, cs.position(:,:,2), VisParam.h_MONITOR_AXIS, 4,1);
        else
            csstrDi = '1;'; 
            ringHdlDi=zeros(1,4);
        end
end

if strcmpi(cs.type,'boxedRing')
   [boxStr boxHdl] = drawFrameRect(cs.box.color,cs.box.position,cs.box.penWidth,VisParam.h_MONITOR_AXIS, 4);
else
    boxStr = [];
    boxHdl = zeros(1,4);
end

%% page 3. target on
if  strcmpi(Stim.CSon.type,'dreiEck')
    tstr = '1;';
    tarHdl = ringHdlRe(:,2);
else
    stTar = Stim.target;
    [tstr tarHdl] = drawRectangle_RBM(stTar.color,stTar.position,VisParam.h_MONITOR_AXIS,1);
end

%% page 6, white 'error' bkg
% whiteBkg = 'Screen(''FillRect'', VisParam.scr_handle, [255 255 255]);';
blkBkg = 'Screen(''FillRect'', VisParam.scr_handle, [0 0 0]);';

%% flip strings
flpstr   = 'Screen(''Flip'',VisParam.scr_handle);';
flpnoclr = 'Screen(''Flip'',VisParam.scr_handle,[],1);';

%% load draw commands into VisParam global
VisParam.page(1).draw = bkgstr;
VisParam.page(2).draw = [csstrRe, csstrDi, boxStr];
VisParam.page(3).draw = tstr;
VisParam.page(4).draw = VisParam.page(2).draw;
VisParam.page(5).draw = [csstrRe boxStr];
VisParam.page(6).draw = blkBkg;
VisParam.page(7).draw = csstrDi;

VisParam.page(1).flip = flpstr;
VisParam.page(2).flip = flpnoclr;
VisParam.page(3).flip = flpstr;
VisParam.page(4).flip = flpstr;
VisParam.page(5).flip = flpstr;
VisParam.page(6).flip = flpstr;
VisParam.page(7).flip = flpstr;

VisParam.page(1).str = [bkgstr, flpstr];
VisParam.page(2).str = [csstrRe, csstrDi, boxStr, flpnoclr];
VisParam.page(3).str = [tstr, flpstr];
VisParam.page(4).str = [csstrRe, csstrDi, boxStr, flpstr];
VisParam.page(5).str = [csstrRe, boxStr, flpstr];
VisParam.page(6).str = [blkBkg, flpstr];
VisParam.page(7).str = [csstrDi, flpstr];

%% Draw stimulus on experimenter's monitor (ModigMonitor)
VisParam.exp_page(1).obj_handle = [ringHdlRe(:,1); ringHdlDi(:,1); boxHdl(1)];
VisParam.exp_page(2).obj_handle = [tarHdl(:,1); ringHdlRe(:,2); ringHdlDi(:,2);  boxHdl(2); Stim.target.tolWinHdl];
VisParam.exp_page(3).obj_handle = [ringHdlRe(:,3); ringHdlDi(:,3);  boxHdl(3)];
VisParam.exp_page(4).obj_handle = [ringHdlRe(:,4);  boxHdl(4)];
VisParam.exp_page(5).obj_handle = ringHdlDi(:,4);

%% remove invalid object handles
for i = 1:size(VisParam.exp_page,2)
    invalidHdl = ~ishandle(VisParam.exp_page(i).obj_handle);
    VisParam.exp_page(i).obj_handle(invalidHdl) = [];   
    if ~any(ishandle(VisParam.exp_page(i).obj_handle)),
        VisParam.exp_page(i) = []; % sort of dangerous!
    end
end
cb = 1;
