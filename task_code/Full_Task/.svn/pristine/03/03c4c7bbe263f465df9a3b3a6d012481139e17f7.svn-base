<h2><a name="_source"></a>SOURCE CODE <a href="#_top"><img alt="^" border="0" src="../../up.png"></a></h2>
<div class="fragment"><pre>0001 <a name="_sub0" href="#_subfunctions" class="code">function MovieDemo</a>
0002 <span class="comment">% MovieDemo uses Screen.mex to make and show a movie.</span>
0003 fprintf(<span class="string">'MovieDemo.m is only 36 lines, plus comments.\n'</span>);
0004 fprintf(<span class="string">'Read it to see how easy it is to show movies.\n\n'</span>);
0005 
0006 <span class="comment">% Open a window in center of screen</span>
0007 screenNumber=1;
0008 rect=CenterRect([0 0 200 200],Screen(screenNumber,<span class="string">'Rect'</span>));
0009 window=Screen(screenNumber,<span class="string">'OpenWindow'</span>,[],rect);
0010 
0011 <span class="comment">% Make a movie by drawing ovals into 101 offscreen windows.</span>
0012 fprintf(<span class="string">'Computing the movie... '</span>);
0013 black=BlackIndex(window);
0014 w=zeros(101,1);
0015 <span class="keyword">for</span> i=1:101
0016     w(i)=Screen(window,<span class="string">'OpenOffscreenWindow'</span>);
0017     r=[0 0 2 2]*(i-1);
0018     Screen(w(i),<span class="string">'FillOval'</span>,black,r);
0019 <span class="keyword">end</span>
0020 fprintf(<span class="string">'Done.\nRoll ''em!\n'</span>);
0021 
0022 <span class="comment">% Show the movie, first forwards, then backwards.</span>
0023 HideCursor;
0024 rect=Screen(w(1),<span class="string">'Rect'</span>);
0025 <span class="keyword">for</span> i=[1:101 101:-1:1]
0026     Screen(window,<span class="string">'WaitBlanking'</span>);
0027     Screen(<span class="string">'CopyWindow'</span>,w(i),window,rect,rect);
0028 <span class="keyword">end</span>
0029 
0030 <span class="comment">% Show the movie again, now using Rush to minimize interruptions.</span>
0031 loop={
0032     <span class="string">'for i=[1:101 101:-1:1];'</span>
0033     <span class="string">'Screen(window,''WaitBlanking'');'</span>
0034     <span class="string">'Screen(''CopyWindow'',w(i),window,rect,rect);'</span>
0035     <span class="string">'end;'</span>
0036     };
0037 priorityLevel=MaxPriority(screenNumber,<span class="string">'WaitBlanking'</span>);
0038 Rush(loop,priorityLevel);
0039 ShowCursor;
0040 
0041 <span class="comment">%Close the on- and off-screen windows</span>
0042 Screen(<span class="string">'CloseAll'</span>);
0043 
0044 fprintf(<span class="string">'The movie was shown twice. The first showing may have been jerky, due to\n'</span>);
0045 fprintf(<span class="string">'interruptions. The second showing used Rush to minimize interruptions, to\n'</span>);
0046 fprintf(<span class="string">'make the movie run smoothly. See MovieTearDemo and Rush.\n'</span>);</pre></div>
