0030         
0031 
0032         <span class="comment">% since the parent is the project update area the position values are in</span>
0033         <span class="comment">% reference to the ui control parent, *not* the figure itself</span>
0034         uicontrol(upArea, <span class="string">'style'</span>, <span class="string">'text'</span>, <span class="string">'units'</span>, <span class="string">'pixels'</span>,<span class="keyword">...</span><span class="comment">  </span>
0035             <span class="string">'HorizontalAlignment'</span>,<span class="string">'left'</span>,<span class="keyword">...</span>
0036             <span class="string">'position'</span>, [1 1 120 135],<span class="keyword">...</span><span class="comment"> </span>
0037             <span class="string">'fontSize'</span>, 10,<span class="keyword">...</span>
0038             <span class="string">'backgroundColor'</span>, [0.831 0.816 0.784],<span class="keyword">...</span>
0039             <span class="string">'tag'</span>, <span class="string">'optionsText'</span>, <span class="keyword">...</span>
0040             <span class="string">'string'</span>,{<span class="string">'CS1 vs. CS2'</span>;<span class="string">'Left vs. Right'</span>;<span class="string">'R|CS1 &amp; R|CS2'</span>;<span class="string">'% R(CS1) R(CS2)'</span>})
0041 
0042         <span class="comment">% for simpler updating use matrix</span>
0043         uicontrol(upArea, <span class="string">'style'</span>, <span class="string">'text'</span>, <span class="string">'units'</span>, <span class="string">'pixels'</span>,<span class="keyword">...</span>
0044             <span class="string">'position'</span>, [130 1 75 135],<span class="keyword">...</span><span class="comment"> </span>
0045             <span class="string">'HorizontalAlignment'</span>,<span class="string">'left'</span>,<span class="keyword">...</span>
0046             <span class="string">'fontSize'</span>, 10, <span class="keyword">...</span>
0047             <span class="string">'backgroundColor'</span>, [0.831 0.816 0.784],<span class="keyword">...</span>
0048             <span class="string">'tag'</span>, <span class="string">'counterValues'</span>,<span class="keyword">...</span>
0049             <span class="string">'string'</span>,num2str(zeros(4,2)))      
0050         
0051         <span class="comment">% error strings...</span>
0052         uicontrol(upArea, <span class="string">'style'</span>, <span class="string">'text'</span>, <span class="string">'units'</span>, <span class="string">'pixels'</span>,<span class="keyword">...</span>
0053             <span class="string">'position'</span>, [205 1 120 135],<span class="keyword">...</span><span class="comment"> </span>
0054             <span class="string">'HorizontalAlignment'</span>,<span class="string">'right'</span>,<span class="keyword">...</span>
0055             <span class="string">'fontSize'</span>, 10, <span class="keyword">...</span>
0056             <span class="string">'backgroundColor'</span>, [0.831 0.816 0.784],<span class="keyword">...</span>
0057             <span class="string">'tag'</span>, <span class="string">'errorStrings'</span>,<span class="keyword">...</span>
0058             <span class="string">'string'</span>,{<span class="string">'Early KT release: '</span>;<span class="string">'No touch: '</span>; <span class="string">'Errors in succesion: '</span>; <span class="string">'Mean RT: '</span>;<span class="string">'Side repetitions: '</span>});
0059         uicontrol(upArea, <span class="string">'style'</span>, <span class="string">'text'</span>, <span class="string">'units'</span>, <span class="string">'pixels'</span>,<span class="keyword">...</span>
0060             <span class="string">'position'</span>, [325 1 50 135],<span class="keyword">...</span><span class="comment"> </span>
0061             <span class="string">'HorizontalAlignment'</span>,<span class="string">'left'</span>,<span class="keyword">...</span>
0062             <span class="string">'fontSize'</span>, 10, <span class="keyword">...</span>
0063             <span class="string">'backgroundColor'</span>, [0.831 0.816 0.784],<span class="keyword">...</span>
0064             <span class="string">'tag'</span>, <span class="string">'errorNos'</span>,<span class="keyword">...</span>
0065             <span class="string">'string'</span>,num2str(zeros(5,1)));
0066 
0067         <span class="comment">% update gui handles</span>
0068         uih = guihandles(figHdl);
0069         guidata(figHdl, uih);
0070 
0071         <span class="comment">% update our globals</span>
0072         MENUs.ModigMainMenu.handles = <a href="../../../../Modig/library/sort_structure.html" class="code" title="function structure_out = sort_structure(structure)">sort_structure</a>(uih);
0073         MENUs.ModigMainMenu.handle  = figHdl;
0074 
0075         TaskOp.count.sideChoice     = zeros(2); <span class="comment">% saves L-R choices</span>
0076         TaskOp.count.choices        = zeros(2); <span class="comment">% saves CS1-CS2 choices</span>
0077         TaskOp.count.earlyRelease   = 0; <span class="comment">% here we save early key touch releases</span>
0078         TaskOp.count.noTouch        = 0; <span class="comment">% save no touches</span>
0079         TaskOp.count.choiceRT       = [];  <span class="comment">% save choice RT</span>
0080         TaskOp.count.repCho         = zeros(1,2); <span class="comment">% repeated choices tracker</span>
0081         TaskOp.count.sideRepErr     = 0;
0082         TaskOp.count.successiveError= 0;
0083         TaskOp.count.rewHist        = zeros(1,2);
0084         TaskOp.count.choiceHist     = [];
0085         
0086         TaskOp.count.seq            = 0;
0087         
0088         <span class="keyword">if</span> isfield(MENUs,<span class="string">'paramGui_OBS_LEARN'</span>) &amp;&amp; strcmp(MENUs.paramGui_OBS_LEARN.status,<span class="string">'ON'</span>) <span class="keyword">...</span>
0089                 &amp;&amp; ishandle(MENUs.paramGui_OBS_LEARN.handles.learningAxes)
0090             cla(MENUs.paramGui_OBS_LEARN.handles.learningAxes,<span class="string">'reset'</span>)
0091             xlabel(MENUs.paramGui_OBS_LEARN.handles.learningAxes,<span class="string">'Trials'</span>)
0092             ylim(MENUs.paramGui_OBS_LEARN.handles.learningAxes,[-0.1 1.1])
0093             
0094         <span class="keyword">end</span>
0095     <span class="keyword">case</span> <span class="string">'update'</span>,
0096         <span class="comment">% variables can be undeclared,</span>
0097         <span class="keyword">if</span> ~isfield(TaskOp.count,<span class="string">'choices'</span>) || ~isfield(TaskOp.count,<span class="string">'successiveError'</span>) <span class="keyword">...</span>
0098                 || ~isfield(MENUs.ModigMainMenu.handles,<span class="string">'counterValues'</span>)
0099             <a href="updateMoMaMe_OBS_LEARN.html" class="code" title="function updateMoMaMe_OBS_LEARN(option)">updateMoMaMe_OBS_LEARN</a>(<span class="string">'initialize'</span>)
0100             <a href="updateMoMaMe_OBS_LEARN.html" class="code" title="function updateMoMaMe_OBS_LEARN(option)">updateMoMaMe_OBS_LEARN</a>(<span class="string">'update'</span>)
0101         <span class="keyword">end</span>
0102         setupB = strcmp(TaskOp.curSetup,<span class="string">'B'</span>);
0103        
0104         <span class="comment">% update counters</span>
0105         <span class="keyword">if</span> TaskOp.choice~=0 &amp;&amp; TaskOp.correct
0106              <span class="comment">% keep track of repeated L/R choices...</span>
0107             repeat = TaskOp.count.repCho(2)==TaskOp.choice;
0108             <span class="keyword">if</span> repeat
0109                 TaskOp.count.repCho(1) = TaskOp.count.repCho(1)+1;
0110             <span class="keyword">else</span>
0111                 TaskOp.count.repCho(1) = 0;
0112             <span class="keyword">end</span>
0113             TaskOp.count.repCho(2) = TaskOp.choice; <span class="comment">% now the prev choice</span>
0114             
0115             <span class="comment">% update L-R choice</span>
0116             TaskOp.count.sideChoice(1+setupB,TaskOp.choice) = <span class="keyword">...</span>
0117                 TaskOp.count.sideChoice(1+setupB,TaskOp.choice)+1;
0118             
0119             <span class="comment">% update CS1-CS2 choice</span>
0120             TaskOp.count.choices(1+setupB,Stim.choApp.CSsides(TaskOp.choice)) = <span class="keyword">...</span>
0121                     TaskOp.count.choices(1+setupB,Stim.choApp.CSsides(TaskOp.choice))+1;
0122                 
0123             TaskOp.count.choiceHist = [TaskOp.count.choiceHist, Stim.choApp.CSsides(TaskOp.choice)];
0124                 
0125             <span class="comment">% update reward history for each CS</span>
0126             TaskOp.count.rewHist(Stim.choApp.CSsides(TaskOp.choice)) = <span class="keyword">...</span>
0127                 TaskOp.count.rewHist(Stim.choApp.CSsides(TaskOp.choice)) + TaskOp.count.rewardNow;
0128             
0129             <span class="keyword">if</span> isfield(Timers.Event,<span class="string">'goSignal'</span>) 
0130                 pre = Timers.Event.goSignal.Userdata;
0131                 choiceRT = pre(end).Data-Task.goSignal.flipTimeStamp;
0132             <span class="keyword">else</span>
0133                 choiceRT = NaN;
0134             <span class="keyword">end</span>
0135             TaskOp.count.choiceRT = [TaskOp.count.choiceRT choiceRT];
0136                         
0137             TaskOp.count.successiveError = 0;
0138             
0139             <span class="comment">% update learning axes</span>
0140             <span class="comment">% padded with 0.5 to start at 0.5 on first trial</span>
0141             movAve = filter(ones(1,10)/10,1,[ones(1,10)/2,TaskOp.count.choiceHist-1]);
0142             clr = [1 0 0;0 0 1];
0143             theClr = clr(1+setupB,:);
0144             myX = (setupB/5) + sum(TaskOp.count.choices(1+setupB,:));           
0145             myY = movAve(end);
0146             hold(MENUs.paramGui_OBS_LEARN.handles.learningAxes,<span class="string">'on'</span>)
0147             scatHdl = scatter(MENUs.paramGui_OBS_LEARN.handles.learningAxes, myX, myY);
0148             set(scatHdl,<span class="string">'MarkerEdgeColor'</span>,theClr)
0149 
0150             
0151         <span class="keyword">elseif</span> TaskOp.repeatError == 1,
0152             TaskOp.count.successiveError = TaskOp.count.successiveError +1;
0153         <span class="keyword">end</span>
0154         
0155         <span class="keyword">if</span> sum(TaskOp.count.choices(1+setupB,:))&gt;0, 
0156             warning(<span class="string">'off'</span>,<span class="string">'MATLAB:DivideByZero'</span>)
0157             percentRw = round(100*(TaskOp.count.rewHist./TaskOp.count.choices(1+setupB,:)));
0158             warning(<span class="string">'on'</span>,<span class="string">'MATLAB:DivideByZero'</span>)
0159         <span class="keyword">else</span>
0160             percentRw = zeros(1,2);
0161         <span class="keyword">end</span>
0162         
0163         s = num2str([TaskOp.count.choices(1+setupB,:);TaskOp.count.sideChoice(1+setupB,:); TaskOp.count.rewHist; percentRw]);
0164         set(MENUs.ModigMainMenu.handles.counterValues, <span class="keyword">...</span>
0165             <span class="string">'string'</span>,s)
0166         
0167         <span class="keyword">if</span> ~isempty(TaskOp.count.choiceRT),
0168             m = round(mean(TaskOp.count.choiceRT)*1000);
0169         <span class="keyword">else</span>
0170             m = 0;
0171         <span class="keyword">end</span>
0172         en = [TaskOp.count.earlyRelease; TaskOp.count.noTouch; TaskOp.count.successiveError;  <span class="keyword">...</span>
0173             m; TaskOp.count.repCho(1)];
0174         set(MENUs.ModigMainMenu.handles.errorNos, <span class="keyword">...</span>
0175             <span class="string">'string'</span>,num2str(en))
0176         
0177         
0178     <span class="keyword">case</span> <span class="string">'reset'</span>,
0179         TaskOp.count.sideChoice     = zeros(2); <span class="comment">% saves L-R choices</span>
0180         TaskOp.count.choices        = zeros(2); <span class="comment">% saves CS1-CS2 choices</span>
0181         TaskOp.count.earlyRelease   = 0; <span class="comment">% here we save early key touch releases</span>
0182         TaskOp.count.noTouch        = 0; <span class="comment">% save no touches</span>
0183         TaskOp.count.choiceRT       = [];  <span class="comment">% save choice RT</span>
0184         TaskOp.count.repCho         = zeros(1,2); <span class="comment">% repeated choices tracker</span>
0185         TaskOp.count.sideRepErr     = 0;
0186         TaskOp.count.successiveError=0;
0187         TaskOp.count.rewHist        = zeros(1,2);
0188         TaskOp.count.choiceHist     = [];
0189         TaskOp.count.seq            = 0;
0190         
0191         setupB = strcmp(TaskOp.curSetup,<span class="string">'B'</span>);
0192         percentRw = [0,0];
0193         s = num2str([TaskOp.count.choices(1+setupB,:);TaskOp.count.sideChoice(1+setupB,:); TaskOp.count.rewHist; percentRw]);
0194         set(MENUs.ModigMainMenu.handles.counterValues, <span class="keyword">...</span>
0195             <span class="string">'string'</span>,s)
0196         en = [TaskOp.count.earlyRelease; TaskOp.count.noTouch; TaskOp.count.sideRepErr;<span class="keyword">...</span>
0197             TaskOp.count.successiveError;  TaskOp.count.repCho(1)];
0198         set(MENUs.ModigMainMenu.handles.errorNos, <span class="keyword">...</span>
0199             <span class="string">'string'</span>,num2str(en))
0200 <span class="keyword">end</span>
