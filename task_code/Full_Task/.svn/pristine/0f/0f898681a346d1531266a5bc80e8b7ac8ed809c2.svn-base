<div class="fragment"><pre>0001 <a name="_sub0" href="#_subfunctions" class="code">function updateMoMaMe_OBS_LEARN(option)</a>
0002 <span class="comment">% updateMoMaMe_OBS_LEARN(option)</span>
0003 <span class="comment">%</span>
0004 <span class="comment">% creates a project specific and totally modifiable update area in the</span>
0005 <span class="comment">% MOMaMe figure using uicontrols.</span>
0006 <span class="comment">%</span>
0007 <span class="comment">% inputs: 'initialize' --&gt;creates the uicontrols</span>
0008 <span class="comment">%         'update' --&gt; updates the counters.</span>
0009 <span class="comment">%         'reset' --&gt; resets the counters</span>
0010 <span class="comment">%</span>
0011 
0012 <span class="comment">% rbm 11.10</span>
0013 <span class="keyword">global</span> MENUs Stim TaskOp Timers Task
0014 figHdl = MENUs.ModigMainMenu.handle;
0015 upArea = MENUs.ModigMainMenu.handles.prjUpArea;
0016 
0017 <span class="keyword">switch</span> option,
0018     <span class="keyword">case</span> <span class="string">'initialize'</span>,
0019         
0020         <span class="comment">% change Area name,</span>
0021         set(upArea,<span class="string">'Units'</span>,<span class="string">'pixels'</span>)
0022         set(upArea,<span class="string">'Title'</span>, TaskOp.prj)
0023 
0024         <span class="comment">% delete previous data</span>
0025         kids = get(upArea, <span class="string">'children'</span>);
0026         delete(kids)
0027         
0028         <span class="comment">% get option names</span>
