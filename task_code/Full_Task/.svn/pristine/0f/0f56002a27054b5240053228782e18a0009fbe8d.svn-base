function runned = ModigPrepareTrial_DICTATOR
% Prepares trial parameters in project 'DICTATOR'
%
%   Events:
%  
% pre_trial   
% touchHold   
% choApp      
% goSignal    
% choAcq      
% us          
% otherUsDelay
% otherUS     
% post_trial  
% ITI         
% error 
%
% RBM 12.07
%       3.08
%       4.08
%       7.11 value bars
global Stim TaskOp VisParam Timers MENUs UserInfo Pest ModigDir


%% variables in the GUI
if ~isfield(MENUs,'paramGui_IMP_GIVING') || strcmpi(MENUs.paramGui_IMP_GIVING.status,'OFF')
    Stim.us.possiblePulses=[];
    Stim.us.possiblePulses(:,:,1) = [0 .2;.2 .2];

    % interpulse delay [s]
    Stim.us.interPulseDelay = 0.09;
    Stim.us.target = 0.2;
    TaskOp.count.total_seq = 16;
    
    
    Stim.choApp.type = 'valueBar'; % 'bars'
    Stim.choApp.distCtr = 200;
    Stim.choApp.showZeroImg = 0;
    
    TaskOp.count.repChoLimit = inf; % inf, not to punish repeated side selections
    TaskOp.respBlackBkg = 1;
    TaskOp.roleChangeTrials = 1;
    TaskOp.roleChangeCorrect = 1;
    
    Stim.target.tolerance_window = [150 125; 150 125];
    
    Pest.doPest=0;
    
    TaskOp.rewardDetection = 1; 
    TaskOp.pRewDetection = 1; 
    % reverse (conspecific then actor) or normal (act. then consp.) juice delivery order
    Stim.pre_trial.normalUsOrder = 1; 
end
%% us/otherUS: [other A, other B; self A, self B], conditions in 3rd dim
Stim.us.possiblePulses = zeros(2,2,1);
% Stim.us.possiblePulses(:,:,1) = [0 3;0 0];
% Stim.us.possiblePulses(:,:,2) = [0 3;2 2];
% Stim.us.possiblePulses(:,:,3) = [0 3;4 4];
% Stim.us.possiblePulses(:,:,4) = [0 3;2 4];
% Stim.us.possiblePulses(:,:,5) = [0 3;4 2];
% Stim.us.possiblePulses(:,:,6) = [0 3;3 3];
% Stim.us.possiblePulses(:,:,1) = [0 1;1 3];
% Stim.us.possiblePulses(:,:,2) = [0 1;3 1];
% Stim.us.possiblePulses(:,:,4) = [2 5;1 2];

% Is RT "preference" consistent with actual choice?
Stim.us.possiblePulses(:,:,1) = [1 3;1 3];
Stim.us.possiblePulses(:,:,2) = [1 2;1 2];
Stim.us.possiblePulses(:,:,3) = [1 0;1 2];
Stim.us.possiblePulses(:,:,4) = [1 4;1 2];
Stim.us.possiblePulses(:,:,5) = [3 4;3 2];
Stim.us.possiblePulses(:,:,6) = [4 3;2 3];

% Trial condition(s) =  Pest instances. Otherwise conditions = 3rd
% dimension of array

Pest.instances = 1;
if Pest.doPest,
    conds = Pest.instances;
    Stim.us.possiblePulses = zeros(2,2,1);
else
    conds = size(Stim.us.possiblePulses,3);
end

%% Other's reward detection 
TaskOp.rewardDetectionTraining = 1; % juice at start of trial
if TaskOp.rewardDetection,
    % initialize counter if we didn't had it
    if ~isfield(TaskOp.count,'rewDetect') || isempty(TaskOp.count.rewDetect),
        TaskOp.count.rewDetect = 1;
    end
    trials = 100;
    
    % generate, if necessary, trial #'s when to ask for reward detection
    if TaskOp.count.rewDetect > trials ||  ~isfield(TaskOp.count,'listRewDetectTrials')
        TaskOp.count.listRewDetectTrials=zeros(trials,1);   
        TaskOp.count.listRewDetectTrials(rand(trials,1)<TaskOp.pRewDetection) = 1;
        TaskOp.count.rewDetect =1;
    end        
    
    if TaskOp.rewardDetectionTraining || (TaskOp.count.listRewDetectTrials(TaskOp.count.rewDetect)==1 && TaskOp.count.seq>1),
        Stim.choApp.type = 'rewDetect';
        fprintf('\n Running a reward detection trial! \n')
    else
        Stim.choApp.type = 'ringRect';
    end   
    TaskOp.count.rewDetect = TaskOp.count.rewDetect+1;
end

%% Create condition list
% create new list if any of the following conditionals apply
curCountBiggerThanReq = TaskOp.count.seq > TaskOp.count.total_seq;
noList = isempty(TaskOp.(TaskOp.curSetup).trialOrder);
curCountBiggerThanList = TaskOp.count.seq > size(TaskOp.(TaskOp.curSetup).trialOrder,1);
listConds = numel(unique(TaskOp.(TaskOp.curSetup).trialOrder(:,1))); % it 
% could be max(list), but we might use non-ordinal numbers in a given
% session

if curCountBiggerThanReq || TaskOp.count.seq <= 1 || noList || ...
        curCountBiggerThanList || conds~=listConds
    TaskOp.count.seq = 1;
    TaskOp.(TaskOp.curSetup).trialOrder = ModigRandSeq_DICTATOR(conds, ...
        TaskOp.count.total_seq);
%     fprintf('prep_trial_dictator sequence size: %d\n',size(TaskOp.(TaskOp.curSetup).trialOrder,1))
end

% position relative to midline: 1=left, 2=right
thisPositions = TaskOp.(TaskOp.curSetup).trialOrder(TaskOp.count.seq,2);
Stim.us.pulsePos = [thisPositions 3-thisPositions];

% from trial type number, select possible pulses/magnitude
thisTrialTypeNumber = TaskOp.(TaskOp.curSetup).trialOrder(TaskOp.count.seq,1);
Stim.us.pulses = Stim.us.possiblePulses(:, Stim.us.pulsePos, thisTrialTypeNumber);
% fprintf('prep_trial_dictator trial type debug: %d \n',thisTrialTypeNumber)

%% PEST for "bar discrimination"
% if Pest.doPest,
%     % initial variables
%     if TaskOp.count.seq == 1,
%         if ~isfield(Pest,'default') || Pest.default==1
%             Pest.default = 1;
%             Pest.referenceList = [0.25 0.5 0.75];
%             Pest.range     = [0.01 1]; % in ml
%             Pest.exitRule  = 0.05; %also in ml
%             Pest.doFigure  = 1;
%             Pest.runThisManyRuns = 10;
%             Pest.minTrials = 10;
%         end
%         
%         TaskOp.count.total_seq = 100; % 
%         list = randperm(numel(Pest.referenceList));
%         Pest.reference = Pest.referenceList(list(1));%say in ml
% %         Pest.epsilon   = Pest.range(1) + diff(Pest.range)* rand(1); % (rate of change)
%         preEpsilon = normrnd(0.5,0.3);
%         preEpsilon(preEpsilon>Pest.range(2)) = Pest.range(2);
%         preEpsilon(preEpsilon<Pest.range(1)) = Pest.range(1);
%         Pest.epsilon   =  preEpsilon;% (rate of change)
% 
%         Pest.testValue = Pest.range(1) + diff(Pest.range)*rand(1); % test value within range
%         
%         Pest.choiceHistory = [];
%         Pest.testValueHistory = [];
%         Pest.epsilonHistory = [];
%         
%         Stim.us.possiblePulses = [];
%         Stim.us.possiblePulses(:,:,1) = [0 0;Pest.reference Pest.testValue];
%     end
%     % assign testValue to Stim.us.pulses (used through code as holder for
%     % reward) and change, accordingly, left-right assignment
%     values = [0, 0; Pest.reference, Pest.testValue];
%     Stim.us.pulses = values(:,Stim.us.pulsePos); 
% end
%% PEST for inequity
if Pest.doPest,
    % initial variables
    if TaskOp.count.seq == 1,
        if ~isfield(Pest,'default') || Pest.default==1
            Pest.default = 1;
            Pest.refList = [0.3 ];
            Pest.deltaList = [-0.2 -0.1 0 0.1 0.2]; % inequity
            Pest.range     = [0.07 1]; % in ml
            Pest.exitRule  = 0.075; %also in ml
%             Pest.exitRule = diff(absRange)/50; % prescribed exit rule 
            Pest.doFigure  = 1;
            Pest.runThisManyRuns = 10;
            Pest.minTrials = 5;
        end
        
        TaskOp.count.total_seq = 100; % 
        
        % choose one reference value
        randlist = randperm(numel(Pest.refList));
        reference = Pest.refList(randlist(1)); 
        
        % now choose one inequality for that  reference value
        list = randperm(numel(Pest.deltaList));
%         Pest.reference = reference-(Pest.deltaList(list(1)).*[-1; 1]); 
        Pest.reference = [reference+Pest.deltaList(list(1)); reference]; 

        % draw from a normally distributed distribution the epsilon, verify
        % it doesn't go above or below the testing range
        preEpsilon = normrnd(0.5,0.3);
        preEpsilon(preEpsilon>Pest.range(2)) = Pest.range(2);
        preEpsilon(preEpsilon<Pest.range(1)) = Pest.range(1);
        Pest.epsilon   =  preEpsilon;% (rate of change)

        % generate test value within range
        Pest.testValue = Pest.range(1) + diff(Pest.range)*rand(1);
%         Pest.testValue = repmat(Pest.testValue,2,1);
        
        % initialize variables
        Pest.choiceHistory = [];
        Pest.testValueHistory = [];
        Pest.epsilonHistory = [];
    end
    % assign testValue to Stim.us.pulses (used throughout code as holder for
    % reward) and change, accordingly, left-right assignment
    Stim.us.possiblePulses(:,:,1) = [Pest.reference, [Pest.testValue;Pest.testValue]];
    values =  Stim.us.possiblePulses;
    Stim.us.pulses = values(:,Stim.us.pulsePos); 
end

%% pre_trial

%% choApp
% monitor composition-->stim arrangement
bIsActive = strcmp(TaskOp.curSetup,'B');
% Stim.choApp.distCtr = 200;
if bIsActive
    distCtr = Stim.choApp.distCtr*[1; -1]; % changes Left/right
else
    distCtr = Stim.choApp.distCtr*[-1; 1];
end
scrCtr = repmat(VisParam.scr_rect(3:4)/2,2,1);

switchAxis = 1; 
if switchAxis,
    Stim.choApp.center = [scrCtr(:,1), scrCtr(:,2)-distCtr];
    arrangeRings = [2 4];
    otherAxis = [1 3];
else
    Stim.choApp.center   = [scrCtr(:,1)-distCtr, scrCtr(:,2)];
    arrangeRings = [1 3];
    otherAxis = [2 4];
end

% check congruence between type of CS and juice volume or number of pulses
NotPulses = prod(prod(mod(Stim.us.pulses,round(Stim.us.pulses))));
if NotPulses && strcmp(Stim.choApp.type, 'ring')
   Stim.us.pulses = [1 2; 3 1];
end
switch Stim.choApp.type,
     case 'rewDetect',
         sz = 200/2;
         Stim.choApp.size = sz*2;
         Stim.choApp.position = [Stim.choApp.center-sz,Stim.choApp.center+sz];
                 
        l = TaskOp.(TaskOp.curSetup).trialOrder(TaskOp.count.seq,2);
        Stim.choApp.CSsides      = [l 3-l];
        Stim.choApp.csfname{l}   = [ModigDir.Images,'\ribena.jpg'];
        Stim.choApp.csfname{3-l} = [ModigDir.Images,'\no_ribena.jpg'];
         
     case 'valueBar'
        Stim.choApp.orientation = 'h';
        Stim.choApp.barWidth = 5;
        Stim.choApp.horOffset = 0; % 60 if bars are seen from monitor edge
        Stim.choApp.verOffset = 60; % 0 if bars are seen from monitor edge
        Stim.choApp.size = [100 250];
        Stim.choApp.showZeroImg = 0; % logical, passed to prepPages
        if bIsActive,
            horOff = Stim.choApp.horOffset*[-1; 1]; 
        else
            horOff = Stim.choApp.horOffset*[1; -1];
        end
        % position (hor, ver) stimuli center to screen center, in pixels              
        % receiver: 1st row
        % dictator: 2nd row
        % left-right: 3rd dimension
        Stim.choApp.position = zeros(2,2,2);
        Stim.choApp.position(:,1,1) = horOff; 
        Stim.choApp.position(:,1,2) = horOff; 
        Stim.choApp.position(1,2,1) = distCtr(2)-Stim.choApp.verOffset;
        Stim.choApp.position(2,2,1) = distCtr(2)+Stim.choApp.verOffset;
        Stim.choApp.position(1,2,2) = distCtr(1)-Stim.choApp.verOffset;
        Stim.choApp.position(2,2,2) = distCtr(1)+Stim.choApp.verOffset;
    case 'bars'
        % choice stimuli parameters
        Stim.choApp.barHalfW = 250; % heigth from center
        Stim.choApp.szHB = 10; % % half width        
                          
        Stim.choApp.bkgclr = [255 255 255];
        Stim.choApp.rewRange = [50 150];
        % dictator stims always in the center
%         Stim.choApp.choPay = [payoff(:,payRand(1)), flipud(payoff(:,payRand(2)))];
    case 'apples'
        Stim.choApp.rectSz = 100;
        
        p=repmat(Stim.choApp.rectSz/2,4); 
        p(1:2,:)=p(1:2,:)*-1;
        prePos = repmat(Stim.choApp.center,2)+p; %(you*2|me*2,rect)
        prePos([2 4],1:2)= prePos([2 4],1:2)-150; % responder
        prePos([2 4],3:4)= prePos([2 4],3:4)+150; % dictator/proposer
        Stim.choApp.stimPos = prePos;
        
%         Stim.choApp.choPay = payoff(:,payRand(1:2));
    case {'ring','ringRect'}
        Stim.choApp.size  = 75;
        
        maxPulses = max(max(Stim.us.pulses));
        
         % small variation for ringRect
        if strcmp(Stim.choApp.type,'ringRect') && maxPulses==0 ,
            maxPulses=1;
        end
        % position(pulses,rect,leftOrRight,respOrDict) 
        prePos = zeros(maxPulses,4,2,2);

        basis = round([Stim.choApp.center-(Stim.choApp.size/2),...
                 Stim.choApp.center+(Stim.choApp.size/2)]);
        prePos(:,:,1,:) = repmat(basis(1,:),[maxPulses,1,2]);
        prePos(:,:,2,:) = repmat(basis(2,:),[maxPulses,1,2]);
        
        % distance between resp or dict changes Left/right
        if strcmp(TaskOp.curSetup,'B'),
            prePos(:,otherAxis,:,1) = prePos(:,otherAxis,:,1)+75;
            prePos(:,otherAxis,:,2) = prePos(:,otherAxis,:,2)-75; 
        else
            prePos(:,otherAxis,:,1) = prePos(:,otherAxis,:,1)-75;
            prePos(:,otherAxis,:,2) = prePos(:,otherAxis,:,2)+75;
        end
        
        % same Number of Stims for Zero on full payoff 
        pulses = Stim.us.pulses;
        fakeThisIter = find(pulses==0);
        if isfield(Stim.choApp,'snofsz') && Stim.choApp.snofsz && ~isempty(fakeThisIter)
            upp = unique(Stim.us.possiblePulses);
            withThisStims = upp(upp>0); 
            pulses(fakeThisIter) = withThisStims;
        end
        
        
        if isfield(Stim.choApp,'randSP') && Stim.choApp.randSP 
            % trick to get 1 random CS-
            aZero = ~isempty(find(pulses==0));
            if strcmp(Stim.choApp.type,'ringRect') && ~Stim.choApp.snofsz && aZero,
                pulses(pulses==0) = 1;
            end
            rect = VisParam.scr_rect;
            tp = 200;
            stimSz = Stim.choApp.size;
            sp = 8;
            centralGap = 150;
            rect(4) = rect(4)-centralGap;
            prePosL = randomizeStimPosition(rect, tp, stimSz, sp, pulses(:,1), bIsActive, 1, 0);
            prePosR = randomizeStimPosition(rect, tp, stimSz, sp, pulses(:,2), bIsActive, 0, 0);
            
            if bIsActive,
                prePosR(:,[2 4],:) = prePosR(:,[2 4],:)+centralGap;
%                 prePosL(:,[2 4],:) = prePosL(:,[2 4],:)-centralGap;
            else
%                 prePosR(:,[2 4],:) = prePosR(:,[2 4],:)-centralGap;
                prePosL(:,[2 4],:) = prePosL(:,[2 4],:)+centralGap;
            end
            
            
            prePos(:,:,1,1) = repmat(prePosL(1,:,1),4,1); % left passive
            prePos(:,:,2,1) = repmat(prePosR(1,:,1),4,1); % right passive
            prePos(:,:,1,2) = repmat(prePosL(1,:,2),4,1); % left active
            prePos(:,:,2,2) = repmat(prePosR(1,:,2),4,1); % right active
            
            prePos(1:size(prePosL(:,:,1),1),:,1,1) = prePosL(:,:,1); % left passive
            prePos(1:size(prePosR(:,:,1),1),:,2,1) = prePosR(:,:,1); % right passive
            prePos(1:size(prePosL(:,:,2),1),:,1,2) = prePosL(:,:,2); % left active
            prePos(1:size(prePosR(:,:,2),1),:,2,2) = prePosR(:,:,2); % right active
        else
            % arrange amount of rings in one 'area'
            for j = 1:2,
                for i = 1:2,
                    if pulses(j,i) == 2,
                        % hide the 'extra' rings behind one... this way we keep
                        %   constancy in the position matrix 
                        prePos(1,arrangeRings,i,j) = prePos(1,arrangeRings,i,j)-50;
                        prePos(2:maxPulses,arrangeRings,i,j) = ...
                            prePos(2:maxPulses,arrangeRings,i,j)+50;
                    elseif pulses(j,i) == 3,
                        prePos(1,arrangeRings,i,j) =  prePos(1,arrangeRings,i,j)-100;
                        prePos(2,arrangeRings,i,j) =  prePos(2,arrangeRings,i,j);
                        prePos(3:maxPulses,arrangeRings,i,j) =  prePos(3:maxPulses,arrangeRings,i,j)+100;
                    elseif pulses(j,i) == 4,
                        prePos(1,arrangeRings,i,j) = prePos(1,arrangeRings,i,j)-60;
                        prePos(2,arrangeRings,i,j) = prePos(2,arrangeRings,i,j)+60;
                        prePos(3,otherAxis,i,j) = prePos(3,otherAxis,i,j)-60;
                        prePos(4:maxPulses,otherAxis,i,j) = prePos(4:maxPulses,otherAxis,i,j)+60;
                     elseif pulses(j,i) == 5,
                         m = [-1, 1];
                         m = m(bIsActive+1);
                        prePos(1,arrangeRings,i,j) = prePos(1,arrangeRings,i,j)-100;
                        prePos(1,otherAxis,i,j)    = prePos(1,otherAxis,i,j)+40*m;
                        prePos(2,otherAxis,i,j)    = prePos(2,otherAxis,i,j)+40*m;
                        prePos(3,arrangeRings,i,j) = prePos(3,arrangeRings,i,j)+100;
                        prePos(3,otherAxis,i,j)    = prePos(3,otherAxis,i,j)+40*m;
                        prePos(4,arrangeRings,i,j) = prePos(4,arrangeRings,i,j)-50;
                        prePos(4,otherAxis,i,j)    = prePos(4,otherAxis,i,j)-40*m;
                        prePos(5,arrangeRings,i,j) = prePos(5,arrangeRings,i,j)+50;
                        prePos(5,otherAxis,i,j)    = prePos(5,otherAxis,i,j)-40*m;
                    end
                end
            end
        end        
        Stim.choApp.position = round(prePos);
end

% monkey ring colors,
mrc = zeros(99,3);
mrc(56,:) = [0 256 0];% green is H2 or 56
mrc(60,:) = [256 0 256];% is 60--purple--nigel
mrc(61,:) = [256 256 0];% is 61--yellow--obi
mrc(62,:) = [256 0 0]  ;% is 62--red-----L40
mrc(66,:) = [0 256/2 256];% is 66, Ramses
mrc(67,:) = [0 256 256];% 67 is Robb

% get id of present guys
actor = eval(['UserInfo.setup',TaskOp.curSetup]);

strings = ['A','B'];
other = strings(2-bIsActive);
receiver = eval(['UserInfo.setup',other]);

Stim.choApp.meClr = mrc(str2double(actor),:);
Stim.choApp.herClr = mrc(str2double(receiver),:);

% if Stim.us.neutral,
%     Stim.choApp.neutralClr = [51 204 255];
% end

%% goSignal /targetOn
Stim.target.size = repmat([100, 50],2,1); 
Stim.target.position = zeros(2,4);
if switchAxis
    Stim.target.size = Stim.target.size(:,[2,1]); 
    if bIsActive,
        Stim.target.center   = [Stim.target.size(:,1),...
            VisParam.scr_rect(4)-Stim.choApp.center(:,2)];
    else
        Stim.target.center = [VisParam.scr_rect(3)-(Stim.target.size(:,1)),...
            VisParam.scr_rect(4)-Stim.choApp.center(:,2)];
    end
else
    Stim.target.center = [VisParam.scr_rect(3)-Stim.choApp.center(:,1),...
        VisParam.scr_rect(4)-Stim.target.size(:,2)];
end
Stim.target.position = [Stim.target.center-Stim.target.size,...
                        Stim.target.center+Stim.target.size];
Stim.target.color = [0 0 192];

%% BEHAVIOR CONTROL VARIABLES

%
Stim.touchHold = [];
Stim.touchHold.handInterrupt = 1;
Stim.touchHold.hand.filter_time = Timers.Event.touchHold.StartDelay-0.6;
Stim.touchHold.hold = 1;
Stim.touchHold.holdTime = 0.5;


Stim.target.filter_time = Timers.Event.goSignal.StartDelay-0.2;
[Stim.target.touchLimits  Stim.target.tolWinHdl] = createTolWin2(Stim.target.center, Stim.target.tolerance_window);


%% TaskOp trial variables initialization
% TaskOp.eyeInterrupt = 0;
TaskOp.handInterrupt = 0;
TaskOp.interrupt = 0;
TaskOp.hold = 0;
TaskOp.holdTime = 0;

% BehaveData.tchInt = [];
TaskOp.choice = 0; 

runned = 1;