<h2><a name="_source"></a>SOURCE CODE <a href="#_top"><img alt="^" border="0" src="../../up.png"></a></h2>
<div class="fragment"><pre>0001 <span class="comment">%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%</span>
0002 <a name="_sub0" href="#_subfunctions" class="code">function ModigSetPriority(level)</a>
0003 <span class="comment">%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%</span>
0004 <span class="keyword">global</span> MENUs
0005 <span class="keyword">if</span> isnumeric(level)
0006     <span class="keyword">if</span> 0 &lt;= level &amp; level &lt;= 9
0007     <span class="keyword">elseif</span> level &lt;0
0008         level = 0;
0009     <span class="keyword">elseif</span> level&gt;9
0010         level = 9;
0011     <span class="keyword">end</span>
0012     <span class="keyword">if</span> level == 0
0013         color = [0.12 0.8 0.04]; <span class="comment">% green for priority 0</span>
0014     <span class="keyword">elseif</span> level == 1
0015         color = [1 0.9 0];
0016     <span class="keyword">elseif</span> level == 2
0017         color = [1 0.3 0];
0018     <span class="keyword">elseif</span> level &gt; 1
0019         color = [1 0 0];
0020     <span class="keyword">end</span>
0021     <a href="#_sub1" class="code" title="subfunction PhaseColorDisp(color)">PhaseColorDisp</a>(color);
0022     Priority(level);
0023 <span class="keyword">end</span>
0024 <span class="comment">%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%</span>
0025 <a name="_sub1" href="#_subfunctions" class="code">function PhaseColorDisp(color)</a>
0026 <span class="comment">%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%</span>
0027 <span class="comment">% Load a task table defined by a project name</span>
0028 <span class="comment">% Called at the begining of task, or after changing a task</span>
0029 <span class="keyword">global</span> MENUs
0030 set(MENUs.ModigMainMenu.handles.CNTR_PUSH_REMEDY,<span class="string">'BackgroundColor'</span>,color);
0031 drawnow;</pre></div>
