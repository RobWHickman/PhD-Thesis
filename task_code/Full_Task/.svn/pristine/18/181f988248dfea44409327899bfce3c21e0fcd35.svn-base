function param = ModigJudgeSituation_DICTATOR(time_beh,prev_id)
% param = ModigJudgeSituation_DICTATOR(time_beh,prev_id)
%
%    Events:
%    
%   pre_trial   
%   touchHold   
%   choApp      
%   goSignal    
%   choAcq      
%   us          
%   otherUsDelay
%   otherUS     
%   post_trial  
%   ITI         
%   error 
%
% See also MODIGPREPARETRIAL_DICTATOR, MODIGPREPAREPAGES_DICTATOR
%
% rbm  12.07
%       3.08
%       4.08 
%		4.09 TableMonitor and TO.Touch adaptation
%       8.10 open solenoid with time adapted to linear regression
%       9.11 side repeat error, flexible change in order of juice delivery
%       12.11 grey bit off at last juice
%       7.12 reward detection trial. CS bit off timing
global Tbl Timers Stim TaskOp VisParam UserInfo 
persistent bt 

if isempty(bt),
    % output table:
    bt = cell2mat(Tbl.BitTbl(:,2));
    nbt(1) = find( strcmp(Tbl.BitTbl(:,1),'KT1')==1);
    nbt(2) = find( strcmp(Tbl.BitTbl(:,1),'KT2')==1);
    nbt(3) = find( strcmp(Tbl.BitTbl(:,1),'Lick1')==1);
    nbt(4) = find( strcmp(Tbl.BitTbl(:,1),'Neuron')==1);
    bt(nbt)=[];
end

% Initalize variables
param.time_beh          = time_beh;
param.prev_id           = prev_id;

param.hand.req          = 0;
param.hand.filter_time  = 0;

param.touch.req           = {};
param.touch.filter_time   = [];
param.touch.state         = 0;
param.touch.limits      =[];

param.expPageMod = 0;

% TaskOp.eyeInterrupt = 0;
TaskOp.handInterrupt = 0;
TaskOp.hold = 0;
TaskOp.holdTime = 0;

param.on_bit = [];
param.off_bit = [];

% used in reward detection training
persistent othRw
if isempty(othRw), othRw = 0; end

switch param.time_beh
    case 1 % called by timer
        switch param.prev_id
            case 1 % pre
                param.hand.req          = Stim.touchHold.hand.req;                
                TaskOp.handInterrupt    = Stim.touchHold.handInterrupt;
                TaskOp.hold             = Stim.touchHold.hold;
                TaskOp.holdTime         = Stim.touchHold.holdTime;
                param.hand.filter_time  = Stim.touchHold.hand.filter_time;
                
                param.next_id  = 2; 
                
                param.on_bit = Tbl.Bit.greyOn.bit_asignment;
                
                if TaskOp.rewardDetectionTraining,
                    othRw = rand(1)<1;
                    if othRw,
                        DIOjuice(0.1,12);
                    end
                end
            case 2 % touchHold
                param.hand.req = Stim.choApp.hand.req;
                param.next_id  = 3;
                
                param.on_bit = [Tbl.Bit.ownCSs.bit_asignment; ...
                                Tbl.Bit.otherCSs.bit_asignment];
                param.off_bit = Tbl.Bit.PreTrial.bit_asignment;

            case 3 % choices appear  
                if UserInfo.use_touch_screen,
                     SetMouse(2048,0);
                end

                tar = Stim.target;
                param.touch.req           = 'twoTouchAreas';
                param.touch.filter_time   = tar.filter_time;
                param.touch.limits        = tar.touchLimits;
                TaskOp.touchInterrupt     = 1;                
                
                param.next_id = 4; 
                param.on_bit = Tbl.Bit.Targets.bit_asignment;
                
            case 4 % go
                if UserInfo.use_touch_screen,
                     SetMouse(2048,0);
                end
                
                % side repeat error 
                if isfield(TaskOp.count,'repChoLimit') && ...
                         TaskOp.count.repCho(1) > TaskOp.count.repChoLimit && ...
                         TaskOp.count.repCho(2)==TaskOp.choice,
                    TaskOp.count.sideRepErr = TaskOp.count.sideRepErr+1;
                    fprintf('Chose for %d time side: %d. Side repeat error.\n',TaskOp.count.repCho(1),TaskOp.count.repCho(2))
                    param.next_id = 11;
                elseif TaskOp.touchInterrupt && TaskOp.choice > 0,                    
                    % select touch feedback page
                    VisParam.page(4).draw = VisParam.page(3+TaskOp.choice).draw;
                    chosen    = VisParam.exp_page(2+TaskOp.choice).obj_handle;
                    notChosen = VisParam.exp_page(5-TaskOp.choice).obj_handle;
                    VisParam.exp_page(3).obj_handle = chosen;
                    VisParam.exp_page(4).obj_handle = notChosen;
                    
                    % depending on US order, select delayed CS
                    if Stim.pre_trial.normalUsOrder,
                        VisParam.page(6).draw = VisParam.page(5+TaskOp.choice).draw;
                        chosen    = VisParam.exp_page(4+TaskOp.choice).obj_handle;
                        notChosen = VisParam.exp_page(7-TaskOp.choice).obj_handle;
                    else
                        VisParam.page(6).draw = VisParam.page(7+TaskOp.choice).draw;
                        chosen    = VisParam.exp_page(6+TaskOp.choice).obj_handle;
                        notChosen = VisParam.exp_page(9-TaskOp.choice).obj_handle;
                        VisParam.exp_page(7:end) = [];
                    end                                       
                    VisParam.exp_page(5).obj_handle = chosen;
                    VisParam.exp_page(6).obj_handle = notChosen;

                    % arm juice delivery
                    selfPulses = Stim.us.pulses(2,TaskOp.choice);
                    otherPulses = Stim.us.pulses(1,TaskOp.choice);
                    ipd = num2str(Stim.us.interPulseDelay);

                    switch Stim.choApp.type
                        case {'valueBar'}
                            targetInMl_self = Stim.us.pulses(2,TaskOp.choice);
                            targetInMl_other = Stim.us.pulses(1,TaskOp.choice);
                            selfPulses = selfPulses>0;
                            otherPulses = otherPulses>0;
                        case 'rewDetect'
                            targetInMl_self = 0;
                            targetInMl_other = 0;
                            % Did he detect the other's reward receipt on
                            % the previous trial?
                            prevRw = othRw;
                            choseRwDet = Stim.choApp.CSsides(1)==TaskOp.choice; 
                            TaskOp.EvntHist.hit = choseRwDet & prevRw;
                            TaskOp.EvntHist.cr  = ~choseRwDet & ~prevRw;
                            TaskOp.EvntHist.miss = ~choseRwDet & prevRw;
                            TaskOp.EvntHist.fa = choseRwDet & ~prevRw;
                            if TaskOp.EvntHist.hit || TaskOp.EvntHist.cr
                                targetInMl_self = Stim.us.target;
                            end                            
                            selfPulses = 1;
                            otherPulses = 0;
                        otherwise
                            targetInMl_self = Stim.us.target;
                            targetInMl_other = Stim.us.target;
                    end
                    calibrateJuiceDelivery('us',targetInMl_self,ipd,selfPulses);
                    calibrateJuiceDelivery('otherUS',targetInMl_other,ipd,otherPulses);

                    % 
                    param.next_id = 5;
                    TaskOp.repeatError = 0;

                    % send bits up depending on choice
                    if TaskOp.choice == 1,
                        param.on_bit = Tbl.Bit.LeftChosenFB.bit_asignment;
                    elseif TaskOp.choice == 2,
                        param.on_bit = Tbl.Bit.RightChosenFB.bit_asignment;
                    end
                    param.on_bit = [param.on_bit; Tbl.Bit.Correct.bit_asignment];
                    param.off_bit = Tbl.Bit.Targets.bit_asignment;
                else
                    TaskOp.count.noTouch =     TaskOp.count.noTouch+1;
                    param.next_id = 11;
                end
            case 5 % choice acq/juice delay
                param.off_bit = Tbl.Bit.Correct.bit_asignment;
                
                if Stim.pre_trial.normalUsOrder,
                    param.next_id = 6;
                    param.off_bit = [param.off_bit; Tbl.Bit.ownCSs.bit_asignment];
                else
                    param.next_id = 8;
                    param.off_bit = [param.off_bit; Tbl.Bit.otherCSs.bit_asignment];
                end
            case 6 % us
                if Stim.pre_trial.normalUsOrder,
                    if strcmpi(Stim.choApp.type,'rewDetect'),
                        param.next_id = 9;
                    else 
                        param.next_id = 7;
                    end
                    
                    if TaskOp.choice == 1,
                        param.off_bit = Tbl.Bit.LeftChosenFB.bit_asignment;
                    else
                        param.off_bit = Tbl.Bit.RightChosenFB.bit_asignment;
                    end                    
                else
                    param.next_id = 9;                  
                end
                
            case 7 % next us delay
                if Stim.pre_trial.normalUsOrder,
                    param.next_id = 8;
                    param.off_bit = Tbl.Bit.otherCSs.bit_asignment;
                else
                    param.next_id = 6;
                    param.off_bit = Tbl.Bit.ownCSs.bit_asignment;
                end
                
            case 8 % other us
                if Stim.pre_trial.normalUsOrder,
                    param.next_id = 9;
                else
                    param.next_id = 7;
                    if TaskOp.choice == 1,
                        param.off_bit = Tbl.Bit.LeftChosenFB.bit_asignment;
                    else
                        param.off_bit = Tbl.Bit.RightChosenFB.bit_asignment;
                    end
                     param.expPageMod = -1;
                end
                
            case 9 % post_trial
                param.next_id = 10;
                param.off_bit = bt;
                
            case 10 % iti
                TaskOp.touchInterrupt = 0;
                TaskOp.choice = 0;
                
                param.next_id = 1;
                param.on_bit = Tbl.Bit.PreTrial.bit_asignment;
                param.off_bit = bt(bt ~= param.on_bit);
            case 11 % error
                param.next_id = 10;
                TaskOp.repeatError = 1;
                TaskOp.correct = 0;

                param.off_bit = cell2mat(Tbl.BitTbl(:,2));
        end
    case 2 % called by behavior during an error
        switch param.prev_id
            case 2
               TaskOp.ignored = 1;
            case 3
               TaskOp.count.earlyRelease = TaskOp.count.earlyRelease+1;               
            case 4
               TaskOp.count.noTouch = TaskOp.count.noTouch+1;
        end
        param.next_id = 11;
        
        % set all bits down
       param.off_bit = bt; 
end
% Recover timer and event names from global Tbl
param.prev_event_name = cell2mat(Tbl.TaskTbl(param.prev_id,Tbl.TaskTblColumnID.evnt_name));
param.prev_timer      = Timers.Event.(param.prev_event_name);

param.next_event_name = cell2mat(Tbl.TaskTbl(param.next_id,Tbl.TaskTblColumnID.evnt_name));
param.next_timer      = Timers.Event.(param.next_event_name);
param.next_page       = cell2mat(Tbl.TaskTbl(param.next_id, Tbl.TaskTblColumnID.vis_page));
param.ok = 1;