% --- Executes on button press in pushbuttonCS1.
function pushbuttonCS1_Callback(hObject, eventdata, handles)
% hObject    handle to pushbuttonCS1 (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)
global Stim ModigDir

mycd = cd;
cd(ModigDir.Images)
[filename, pathname] = uigetfile('*.jpg','Pick an image');
cd(mycd)
if length(filename)>1,
    callerTag = get(hObject,'Tag');
    if strcmpi(callerTag,'pushbuttonCS1')
        Stim.CS.cs1name = [pathname,filename];
        cs1 = imread(Stim.CS.cs1name);
        image(cs1,'Parent',handles.axesCS1)
        set(handles.axesCS1,'visible','off')
        set(handles.textCS1,'String',filename,'fontsize',10)
    elseif strcmpi(callerTag,'pushbuttonCS2')
        Stim.CS.cs2name = [pathname,filename];
        cs2 = imread(Stim.CS.cs2name);
        image(cs2,'Parent',handles.axesCS2)
        set(handles.axesCS2,'visible','off')
        set(handles.textCS2,'String',filename,'fontsize',10)
     elseif strcmpi(callerTag,'pushbuttonCS3')
        Stim.CS.cs3name = [pathname,filename];
        cs3 = imread(Stim.CS.cs3name);
        image(cs3,'Parent',handles.axesCS3)
        set(handles.axesCS3,'visible','off')
        set(handles.textCS3,'String',filename,'fontsize',10)
     elseif strcmpi(callerTag,'pushbuttonCS4')
        Stim.CS.cs4name = [pathname,filename];
        cs4 = imread(Stim.CS.cs4name);
        image(cs4,'Parent',handles.axesCS4)
        set(handles.axesCS4,'visible','off')
        set(handles.textCS4,'String',filename,'fontsize',10)
     elseif strcmpi(callerTag,'pushbuttonCS5')
        Stim.CS.cs5name = [pathname,filename];
        cs5 = imread(Stim.CS.cs5name);
        image(cs5,'Parent',handles.axesCS5)
        set(handles.axesCS5,'visible','off')
        set(handles.textCS5,'String',filename,'fontsize',10)
    end
end


