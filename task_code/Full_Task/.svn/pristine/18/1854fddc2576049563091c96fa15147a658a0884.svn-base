function varargout = paramGui_PAVLOVIAN(varargin)
% PARAMGUI_PAVLOVIAN M-file for paramGui_PAVLOVIAN.fig
%
% 

% Last Modified by GUIDE v2.5 22-Mar-2011 11:07:46

% Begin initialization code - DO NOT EDIT
gui_Singleton = 1;
gui_State = struct('gui_Name',       mfilename, ...
                   'gui_Singleton',  gui_Singleton, ...
                   'gui_OpeningFcn', @paramGui_PAVLOVIAN_OpeningFcn, ...
                   'gui_OutputFcn',  @paramGui_PAVLOVIAN_OutputFcn, ...
                   'gui_LayoutFcn',  [] , ...
                   'gui_Callback',   []);
if nargin && ischar(varargin{1})
    gui_State.gui_Callback = str2func(varargin{1});
end

if nargout
    [varargout{1:nargout}] = gui_mainfcn(gui_State, varargin{:});
else
    gui_mainfcn(gui_State, varargin{:});
end
% End initialization code - DO NOT EDIT


% --- Executes just before paramGui_PAVLOVIAN is made visible.
function paramGui_PAVLOVIAN_OpeningFcn(hObject, eventdata, handles, varargin)
% This function has no output args, see OutputFcn.
% hObject    handle to figure
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)
% varargin   command line arguments to paramGui_PAVLOVIAN (see VARARGIN)

global Stim TaskOp ModigDir Timers
% Choose default command line output for paramGui_PAVLOVIAN
handles.output = hObject;

% load 'defaults' 
ModigTaskLoop('Initialize');

% set trial sequence stuff
set(handles.trialSeqLength,'String',num2str(TaskOp.count.total_seq));
set(handles.respBkg,'Value',TaskOp.respBlackBkg );
set(handles.trialsToRoleChange,'String',num2str(TaskOp.roleChangeTrials));
set(handles.roleChangeCorrect,'Value',TaskOp.roleChangeCorrect);

% set US variables: p(r) & volume
if ~isfield(Stim.us,'probability') || numel(Stim.us.probability)~=5,
    Stim.us.probability = [15 35 50 65 85];
end
for i = 1:numel(Stim.us.probability),
    hdl = eval(sprintf('handles.editCS%dpUS',i));
    set(hdl,'String',num2str(Stim.us.probability(i)))
end
set(handles.editJuiceTarget,'String',num2str(Stim.us.target))

% load default images for push buttons & activate checkboxes
if ~isfield(Stim.CS,'cs1name') || ~ischar(Stim.CS.cs1name),
    Stim.CS.cs1name = [ModigDir.Images,'\Picture 000.jpg'];
    Stim.CS.cs2name = [ModigDir.Images,'\Picture 006.jpg'];
    Stim.CS.cs3name = [ModigDir.Images,'\picture 999.jpg'];
    Stim.CS.cs4name = [ModigDir.Images,'\Picture 003.jpg'];
    Stim.CS.cs5name = [ModigDir.Images,'\Picture 002.jpg'];
end

if ~isfield(Stim.CS,'active') || numel(Stim.CS.active)~=5,
    Stim.CS.active = [0 0 1 0 0];
end

for i = 1:5,
    thisName = eval(sprintf('Stim.CS.cs%dname',i));
    thisImage = imread(thisName);
    thisHdl = eval(sprintf('handles.axesCS%d',i));
    image(thisImage,'Parent',thisHdl)
    set(thisHdl,'Visible','off')
    thisStr = eval(sprintf('handles.textCS%d',i));
    set(thisStr,'String',thisName(end-7:end-4))
    actStr = eval(sprintf('handles.checkbox_CS%d_active',i));
    set(actStr, 'Value', Stim.CS.active(i));
end

% disable stuff that's not working....
set(handles.trialSeqType,'enable','off')
set(handles.uipanelCSselector,'visible','off');
% Update handles structure
guidata(hObject, handles);

% --- Outputs from this function are returned to the command line.
function varargout = paramGui_PAVLOVIAN_OutputFcn(hObject, eventdata, handles) 
% varargout  cell array for returning output args (see VARARGOUT);
% hObject    handle to figure
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)

% Get default command line output from handles structure
varargout{1} = handles.output;

% --- Executes on selection change in trialSeqType.
function trialSeqType_Callback(hObject, eventdata, handles)
% hObject    handle to trialSeqType (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)

% set for the other setup in the handle in momame
global TaskOp

options   = get(handles.trialSeqType, 'String');
selection = get(handles.trialSeqType, 'Value');

switch char(options(selection)),
    case 'Just Random'
        TaskOp.A.trialOrder = [ones(TaskOp.count.total_seq,1), 1+(rand(TaskOp.count.total_seq,1)>0.5)];
        TaskOp.B.trialOrder = [ones(TaskOp.count.total_seq,1), 1+(rand(TaskOp.count.total_seq,1)>0.5)];
    case {'Project Specific','Counterbalanced'}
        conds = size(Stim.us.possiblePulses,2);
        TaskOp.A.trialOrder = ModigRandSeq_DICTATOR(conds, TaskOp.count.total_seq);
        TaskOp.B.trialOrder = ModigRandSeq_DICTATOR(conds, TaskOp.count.total_seq);
end


