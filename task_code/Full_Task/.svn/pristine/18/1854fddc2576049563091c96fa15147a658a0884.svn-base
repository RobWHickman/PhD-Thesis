% --- Executes on button press in updateParams.
function updateParams_Callback(hObject, eventdata, handles)
% hObject    handle to updateParams (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)
global TaskOp 

set(hObject,'String','updating...')

% collect trial sequence stuff
TaskOp.count.total_seq  = str2double(get(handles.trialSeqLength,'String'));
TaskOp.respBlackBkg     = get(handles.respBkg,'Value');
TaskOp.roleChangeTrials = str2double(get(handles.trialsToRoleChange,'String'));
TaskOp.roleChangeCorrect= get(handles.roleChangeCorrect,'Value');

% % if the CS is active evaluate edit boxes
% checkbox_CS1_active_Callback(handles.checkbox_CS1_active)
% checkbox_CS2_active_Callback(handles.checkbox_CS2_active)
% checkbox_CS3_active_Callback(handles.checkbox_CS3_active)
% checkbox_CS4_active_Callback(handles.checkbox_CS4_active)
% checkbox_CS5_active_Callback(handles.checkbox_CS5_active)
% 
% % evaluate p(US|CS) edit boxes
% editCS1pUS_Callback(handles.editCS1pUS,[],handles)
% editCS2pUS_Callback(handles.editCS2pUS,[],handles)
% editCS3pUS_Callback(handles.editCS3pUS,[],handles)
% editCS4pUS_Callback(handles.editCS4pUS,[],handles)
% editCS5pUS_Callback(handles.editCS5pUS,[],handles)

% 
TaskOp.count.trialCounter = zeros(2,10);

% reset seq counterSSS! and generate a new seq
% update are in momame
eval(['updateMoMaMe_',TaskOp.prj, ' initialize']);

clear('activeSetupChange.m')

set(hObject,'String','Update Parameters')
set(hObject,'Value',0)

% --- Executes on button press in close.
function close_Callback(hObject, eventdata, handles)
% hObject    handle to close (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)
close(handles.paramGui_PAVLOVIAN)

% --- Executes on button press in newSeqPushbutton.
function newSeqPushbutton_Callback(hObject, eventdata, handles)
% hObject    handle to newSeqPushbutton (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)
% --- Executes on button press in newSeqPushbutton.
global TaskOp Stim

% Update size of total sequence
trialSeqLength_Callback(handles.trialSeqLength,[],handles);

% New trial orders 
activeCSs = sum(Stim.CS.active==1);
theseActive = find(Stim.CS.active);

% change trialOrder values to correspond to the CS #
for player={'A','B'},
    pre_trialOrder = ModigRandSeq_DICTATOR(activeCSs, TaskOp.count.total_seq);
    TaskOp.(player{:}).trialOrder = pre_trialOrder;
    i = 0;
    for j = theseActive,
        i = i+1;
        TaskOp.(player{:}).trialOrder(pre_trialOrder(:,1)==i,1) = j;
    end
end
TaskOp.count.total_seq = size(TaskOp.(TaskOp.curSetup).trialOrder,1);
TaskOp.count.seq = 1;

% update display
ModigTaskLoop('SeqDisp');
TaskOp.roleChangeCorrect = 0;
activeSetupChange;
TaskOp.count.seq = 1;
TaskOp.count.total_seq = size(TaskOp.(TaskOp.curSetup).trialOrder,1);

% update display
ModigTaskLoop('SeqDisp');
activeSetupChange;
TaskOp.roleChangeCorrect = get(handles.roleChangeCorrect,'Value');

set(handles.trialSeqLength,'String',num2str(TaskOp.count.total_seq))
ModigMessage('m','New trial order');




