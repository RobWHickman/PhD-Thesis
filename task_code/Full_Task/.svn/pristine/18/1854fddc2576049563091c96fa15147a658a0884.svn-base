function trialSeqLength_Callback(hObject, eventdata, handles)
% hObject    handle to trialSeqLength (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)

% Hints: get(hObject,'String') returns contents of trialSeqLength as text
%        str2double(get(hObject,'String')) returns contents of trialSeqLength as a double
global TaskOp MENUs
length = str2double(get(hObject,'String'));
TaskOp.count.total_seq = str2double(get(hObject,'String'));

bIsActive = 1+strcmp(TaskOp.curSetup,'B');
names = {'A', 'B'};
inactive = char(names(bIsActive));
hdl = eval(['MENUs.ModigMainMenu.handles.pushbuttonSetup',inactive]);
uda = get(hdl,'UserData');
uda.total_seq = length;

