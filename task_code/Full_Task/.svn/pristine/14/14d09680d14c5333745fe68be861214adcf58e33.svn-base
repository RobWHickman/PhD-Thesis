0082 <a name="_sub1" href="#_subfunctions" class="code">function cb = ShiftEvent(param)</a>
0083 <span class="comment">% shift event phase</span>
0084 <span class="keyword">global</span> Tbl Timers breaksession TaskOp MENUs VisParam 
0085 
0086 <span class="comment">% if previous timer is running, stop it</span>
0087 <span class="keyword">if</span> strcmp(param.prev_timer.running,<span class="string">'on'</span>)
0088     stop(param.prev_timer); 
0089 <span class="comment">%     fprintf('Stopped previous timer %s \n',param.prev_timer.Name)</span>
0090 <span class="keyword">end</span>
0091 
0092 <span class="comment">% if we have a next timer</span>
0093 <span class="keyword">if</span> ~isempty(param.next_timer)
0094     <span class="keyword">if</span> strcmp(param.next_timer.running,<span class="string">'off'</span>)
0095         
0096         <span class="comment">% pass parameters to global TaskOp</span>
0097         TaskOp.prev_event_name           = param.prev_event_name;
0098         TaskOp.cur_event_id              = param.next_id;
0099         TaskOp.cur_event_name            = param.next_event_name;
0100 
0101         <span class="keyword">if</span> isfield(param,<span class="string">'hand'</span>)
0102             TaskOp.hand.req             = param.hand.req;
0103             TaskOp.hand.filter_time     = param.hand.filter_time;  
0104             
0105             <span class="comment">% time anchor for hand requirement,</span>
0106             <span class="keyword">if</span> TaskOp.hand.req
0107                 TaskOp.hand.filter_startTime = GetSecs;
0108             <span class="keyword">else</span>
0109                 TaskOp.hand.filter_startTime = 0;
0110             <span class="keyword">end</span> 
0111         <span class="keyword">end</span>
0112         
0113         <span class="keyword">if</span> isfield(param,<span class="string">'eye'</span>)
0114             TaskOp.eye.filter_time           = param.eye.filter_time;
0115             TaskOp.eye.req                   = param.eye.req;
0116             TaskOp.eye.limits                = param.eye.limits;
0117             
0118             <span class="comment">% time anchor for eye filter time as required</span>
0119             <span class="keyword">if</span> ~isempty(TaskOp.eye.filter_time)
0120                 TaskOp.eye.filter_startTime = GetSecs;
0121             <span class="keyword">else</span>
0122                 TaskOp.eye.filter_startTime = [];
0123             <span class="keyword">end</span>
0124         <span class="keyword">end</span>
0125         
0126         <span class="keyword">if</span> isfield(param,<span class="string">'touch'</span>)
0127             TaskOp.touch.filter_time           = param.touch.filter_time;
0128             TaskOp.touch.req                   = param.touch.req;
0129             TaskOp.touch.limits                = param.touch.limits;
0130             
0131              <span class="comment">% time anchor for touch filter time as required</span>
0132             <span class="keyword">if</span> ~isempty(TaskOp.touch.req)
0133                 TaskOp.touch.filter_startTime = GetSecs;
0134             <span class="keyword">else</span>
0135                 TaskOp.touch.filter_startTime = [];
0136             <span class="keyword">end</span>
0137         <span class="keyword">end</span>
0138         cb = 1;
0139     <span class="keyword">else</span>
0140         warning(<span class="string">'MODIG:TimerIssue'</span>,<span class="string">'timer ''%s'' running ahead of time'</span>,<span class="keyword">...</span>
0141             param.next_timer.name)
0142         stop(param.next_timer);
0143         <a href="#_sub1" class="code" title="subfunction cb = ShiftEvent(param)">ShiftEvent</a>(param);
0144     <span class="keyword">end</span>
0145 <span class="keyword">else</span> 
0146     warning(<span class="string">'MODIG:TimerIssue'</span>,<span class="string">'empty timer @: %s'</span>, <span class="keyword">...</span>
0147         param.next_timer.name);
0148     <a href="ModigCommand.html" class="code" title="function ModigCommand(option)">ModigCommand</a>(<span class="string">'stop_session'</span>)
0149     cb = 0;
0150 <span class="keyword">end</span>
0151 
0152 <span class="comment">% on starting ITI,</span>
0153 <span class="keyword">if</span> strcmpi(param.next_event_name,<span class="string">'ITI'</span>)
0154     
0155     <span class="comment">% time stamp when the ITI really starts</span>
0156     [TH_bt ITI_start_time EMPTY_it] = <a href="../../Modig/library/isfield_sk.html" class="code" title="function [TF,value empty] = isfield_sk(stem, fullname)">isfield_sk</a>(TaskOp,<span class="string">'EvntHist.ITI_start_time'</span>);
0157     <span class="keyword">if</span> ~EMPTY_it
0158         TaskOp.EvntHist.prev_ITI_start_time = ITI_start_time;
0159     <span class="keyword">else</span>
0160         TaskOp.EvntHist.prev_ITI_start_time = GetSecs;
0161     <span class="keyword">end</span>
0162     TaskOp.EvntHist.ITI_start_time = GetSecs;
0163         
0164     <span class="comment">% stop sampling behavior</span>
0165     [TH_bt btimer EMPTY_bt] = <a href="../../Modig/library/isfield_sk.html" class="code" title="function [TF,value empty] = isfield_sk(stem, fullname)">isfield_sk</a>(Timers,<span class="string">'Input.behavior_monitor'</span>);
0166     <span class="keyword">if</span> ~EMPTY_bt
0167         stop(btimer);
0168     <span class="keyword">end</span>
0169     
0170     <span class="comment">% hide MoMo children</span>
0171     curMon = Tbl.MenuTbl{1}; <span class="comment">% find which current monitor is being used.</span>
0172     curActHdl = <span class="string">'MONITOR_AXIS'</span>;
0173     [TH exp_page EMPTY] = <a href="../../Modig/library/isfield_sk.html" class="code" title="function [TF,value empty] = isfield_sk(stem, fullname)">isfield_sk</a>(VisParam,<span class="string">'exp_page'</span>);
0174     mmh = MENUs.(curMon).handles;
0175     <span class="keyword">if</span> ishandle(mmh.(curActHdl))
0176         <span class="comment">% hide all children,</span>
0177         <span class="keyword">for</span> i = 1:size(exp_page,2),
0178             <span class="keyword">if</span> any(ishandle(exp_page(i).obj_handle)),
0179                 set(exp_page(i).obj_handle,<span class="string">'visible'</span>,<span class="string">'off'</span>);
0180             <span class="keyword">else</span>
0181                 warning(<span class="string">'MODIG:invalidHandles'</span>, <span class="keyword">...</span>
0182                     <span class="string">'VisParam.exp_page(%2.0f) is not a handle, deleting...'</span>,i)
0183                 VisParam.exp_page(i) = []; <span class="comment">% sort of dangerous!</span>
0184                 breaksession = 1;
0185             <span class="keyword">end</span>
0186         <span class="keyword">end</span>
0187    <span class="keyword">end</span>
0188       
0189     <span class="comment">% ModigTaskLoop is waiting for this color change in subroutine</span>
0190     <span class="comment">% 'PostTrial'  and enable 'remedy'</span>
0191     set(MENUs.ModigMainMenu.handles.CNTR_PUSH_REMEDY,<span class="string">'BackgroundColor'</span>,[0.12 0.7 0.4]);
0192     drawnow;
0193 <span class="keyword">end</span>
0194 
0195 <span class="comment">%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%</span>
0196 <a name="_sub2" href="#_subfunctions" class="code">function ShowVisualPage(page, on, off)</a>
0197 <span class="comment">% show page for current event</span>
0198 <span class="comment">% effectively the time point of event shifting</span>
0199 
0200 <span class="keyword">global</span> VisParam Task TaskOp UserInfo breaksession
0201 <span class="keyword">persistent</span> tries
0202 <span class="keyword">if</span> isempty(tries)
0203     tries = 0;
0204 <span class="keyword">end</span>
0205 
0206 <span class="keyword">if</span> page~=0 
0207     <span class="keyword">if</span> page &lt;= size(VisParam.page,2) 
0208         eval(VisParam.page(page).draw);  
0209         <span class="comment">% try-catch since sometimes there's no output from Screen -I'm</span>
0210         <span class="comment">% guessing no flip</span>
0211         <span class="keyword">try</span>
0212             Task.(TaskOp.cur_event_name).flipTimeStamp = eval(VisParam.page(page).flip);
0213         <span class="keyword">catch</span>
0214             <span class="keyword">if</span> ~isfield(TaskOp,<span class="string">'cur_event_name'</span>) || isempty(TaskOp.cur_event_name)
0215                 TaskOp.cur_event_name = <span class="string">'pre_trial'</span>;
0216             <span class="keyword">end</span>
0217             tries = tries+1;
0218             fprintf(<span class="string">'Tried %d times to show visual page\n'</span>,tries);                       
0219             <span class="keyword">if</span> tries &gt; 100,
0220                 breaksession = 1;
0221                 <span class="keyword">return</span>
0222             <span class="keyword">end</span>
0223             <a href="#_sub2" class="code" title="subfunction ShowVisualPage(page, on, off)">ShowVisualPage</a>(page,on,off);
0224         <span class="keyword">end</span>
0225         tries = 0;
0226         
0227        <span class="comment">% change bits...</span>
0228        <span class="keyword">if</span> (~isempty(on) || ~isempty(off))        
0229            <span class="keyword">if</span> UserInfo.lab_connection 
0230     <span class="comment">%        % new exec times 3.9 to 4.1 ms (3.7.08)</span>
0231                 <a href="ModigBitSender.html" class="code" title="function  ModigBitSender(lines, values)">ModigBitSender</a>([on; off]'+1,[ones(1,length(on)) zeros(1,length(off))]);
0232            <span class="keyword">end</span>
0233        <span class="keyword">end</span>
0234     <span class="keyword">else</span>
0235         error(<span class="string">'ModigShiftEvent:called page isn''t defined in VisParam'</span>)
0236     <span class="keyword">end</span>
0237 <span class="keyword">end</span>
0238 
0239 <span class="comment">%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%</span>
0240 <a name="_sub3" href="#_subfunctions" class="code">function ShowExpVisualPage(page)</a>
0241 <span class="comment">% show page for current event</span>
0242 <span class="keyword">global</span> VisParam breaksession
0243 
0244 [TH exp_page EMPTY] = <a href="../../Modig/library/isfield_sk.html" class="code" title="function [TF,value empty] = isfield_sk(stem, fullname)">isfield_sk</a>(VisParam,<span class="string">'exp_page'</span>);
0245 <span class="keyword">if</span> ~EMPTY
0246     <span class="keyword">for</span> i = 1:size(exp_page,2)
0247         <span class="comment">% if we have as many handles as items in the variable</span>
0248         <span class="keyword">if</span> sum(ishandle(exp_page(i).obj_handle))==length(exp_page(i).obj_handle)
0249             <span class="keyword">if</span> page == i
0250                 set(exp_page(i).obj_handle,<span class="string">'visible'</span>,<span class="string">'on'</span>);
0251                 VisParam.exp_page(i).visible = 1; <span class="comment">% redundant variable?</span>
0252             <span class="keyword">elseif</span> page ~= i
0253                 <span class="comment">% hide all not-called-upon children, including page 0</span>
0254                 set(exp_page(i).obj_handle,<span class="string">'visible'</span>,<span class="string">'off'</span>);
0255                 VisParam.exp_page(i).visible = 0;
0256             <span class="keyword">end</span>
0257         <span class="keyword">else</span>
0258             warning(<span class="string">'MODIG:invalidHandles'</span>, <span class="keyword">...</span>
0259                 <span class="string">'VisParam.exp_page(%2.0f) is not a handle'</span>,i)
0260             breaksession = 1; 
0261         <span class="keyword">end</span>
0262     <span class="keyword">end</span>    
0263     drawnow
0264 <span class="keyword">end</span></pre></div>
