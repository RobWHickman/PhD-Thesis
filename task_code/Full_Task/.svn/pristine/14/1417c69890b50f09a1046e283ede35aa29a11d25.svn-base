<h2><a name="_source"></a>SOURCE CODE <a href="#_top"><img alt="^" border="0" src="../../up.png"></a></h2>
<div class="fragment"><pre>0001 <a name="_sub0" href="#_subfunctions" class="code">function ModigRunTrial(identifier)</a>
0002 <span class="comment">%</span>
0003 <span class="comment">%</span>
0004 
0005 <span class="keyword">global</span> VisParam TaskOp Task UserInfo Timers breaksession IO 
0006 
0007 <span class="keyword">if</span> nargin==0,
0008     identifier =1;
0009 <span class="keyword">end</span>
0010 
0011 str = [<span class="string">'ModigJudgeSituation_'</span>,TaskOp.prj]; <span class="comment">% MJS_prj to be called</span>
0012 
0013 refreshRate = Screen(<span class="string">'GetFlipInterval'</span>, VisParam.scr_handle); 
0014 currentTS = TaskOp.EvntHist.cur_trial_start_time;
0015 
0016 <span class="comment">%% extract juice calls from their StartFcn</span>
0017 jcSelfUS=Timers.Event.us.StartFcn;
0018 <span class="keyword">if</span> numel(jcSelfUS)==2, 
0019     jcSelfUS=char(jcSelfUS{2}); 
0020 <span class="keyword">else</span>
0021     jcSelfUS=<span class="string">''</span>;
0022 <span class="keyword">end</span>
0023 <span class="keyword">if</span> isfield(Timers.Event,<span class="string">'otherUS'</span>)
0024     jcOthUS=Timers.Event.otherUS.StartFcn;
0025     jcOthUS=char(jcOthUS{2});
0026 <span class="keyword">end</span>
0027 
0028 <span class="comment">%% Run trial</span>
0029 showCursor <span class="comment">% debug</span>
0030 runTrial = 1;
0031 param.next_id = 1;<span class="comment">%find(strcmp(Tbl.TaskTbl(:,1),'ITI'));% start with ITI</span>
0032 
0033 <span class="keyword">while</span> runTrial &amp;&amp; breaksession==0,
0034 <span class="comment">%% obtain behavioural requirements, page #, bits On/off</span>
0035     preStr = sprintf(<span class="string">'%s(%d,%d);'</span>,str,identifier,param.next_id);
0036 <span class="comment">%     disp(preStr)% debug tool</span>
0037     param = eval(preStr);      
0038     fprintf(<span class="string">'Visual page %d\n'</span>,param.next_page)
0039     
0040 <span class="comment">%% estimate next flip time</span>
0041     now = GetSecs;
0042     flipwhen = currentTS+ param.next_time-refreshRate;
0043     finalWait = flipwhen-now-0.032;
0044     fprintf(<span class="string">'%s for %1.3g[s] %1.3g\n'</span>,param.prev_event_name,flipwhen-now, param.next_time)
0045     
0046 <span class="comment">%% pass parameters to global TaskOp</span>
0047     TaskOp.prev_event_name           = param.prev_event_name;
0048     TaskOp.cur_event_id              = param.next_id;
0049     TaskOp.cur_event_name            = param.next_event_name;
0050     TaskOp.next_page                 = param.next_page;
0051     
0052     <span class="keyword">if</span> isfield(param,<span class="string">'hand'</span>)
0053         TaskOp.hand.req             = param.hand.req;
0054         TaskOp.hand.filter_time     = param.hand.filter_time;  
0055 
0056         <span class="comment">% time anchor for hand requirement,</span>
0057         <span class="keyword">if</span> TaskOp.hand.req
0058             TaskOp.hand.filter_startTime = now;
0059         <span class="keyword">else</span>
0060             TaskOp.hand.filter_startTime = 0;
0061         <span class="keyword">end</span> 
0062     <span class="keyword">end</span>
0063         
0064     <span class="keyword">if</span> isfield(param,<span class="string">'eye'</span>)
0065         TaskOp.eye.filter_time           = param.eye.filter_time;
0066         TaskOp.eye.req                   = param.eye.req;
0067         TaskOp.eye.limits                = param.eye.limits;
0068 
0069         <span class="comment">% time anchor for eye filter time as required</span>
0070         <span class="keyword">if</span> ~isempty(TaskOp.eye.filter_time)
0071             TaskOp.eye.filter_startTime = now;
0072         <span class="keyword">else</span>
0073             TaskOp.eye.filter_startTime = [];
0074         <span class="keyword">end</span>
0075     <span class="keyword">end</span>
0076         
0077     <span class="keyword">if</span> isfield(param,<span class="string">'touch'</span>)
0078         TaskOp.touch.filter_time           = param.touch.filter_time;
0079         TaskOp.touch.req                   = param.touch.req;
0080         TaskOp.touch.limits                = param.touch.limits;
0081 
0082          <span class="comment">% time anchor for touch filter time as required</span>
0083         <span class="keyword">if</span> ~isempty(TaskOp.touch.req)
0084             TaskOp.touch.filter_startTime = now;
0085         <span class="keyword">else</span>
0086             TaskOp.touch.filter_startTime = [];
0087         <span class="keyword">end</span>
0088     <span class="keyword">end</span>
0089 
0090 <span class="comment">%% draw next page</span>
0091     eval(VisParam.page(param.next_page).draw);
0092 
0093 <span class="comment">%% start sampling behaviour in this epoch</span>
0094     <span class="keyword">if</span> IO.Input.behavior.sample==0,
0095         WaitSecs(finalWait); 
0096         <a href="#_sub1" class="code" title="subfunction flipTheScreen(flipwhen, refreshRate)">flipTheScreen</a>(flipwhen, refreshRate);
0097     <span class="keyword">else</span>
0098         [newFlip, errorInterrupt] = <a href="myTimerMonitorBehavior.html" class="code" title="function [flipwhen, errorInterrupt] = myTimerMonitorBehavior(rate,runTime)">myTimerMonitorBehavior</a>(IO.Input.behavior.sampling_rate, finalWait);
0099         <span class="keyword">if</span> errorInterrupt==1,
0100             disp(<span class="string">'error interrupt'</span>)
0101             <span class="comment">% evaluate the error judgeSituation</span>
0102             preStr = sprintf(<span class="string">'%s(%d,%d);'</span>,str,2,param.next_id);
0103 <span class="comment">%            disp(preStr)</span>
0104             param = eval(preStr);  
0105              <span class="comment">% draw next page</span>
0106             eval(VisParam.page(param.next_page).draw);             
0107             <a href="#_sub1" class="code" title="subfunction flipTheScreen(flipwhen, refreshRate)">flipTheScreen</a>(GetSecs+refreshRate, refreshRate);                        
0108 <span class="comment">%         elseif newFlip&gt;0</span>
0109 <span class="comment">%             fprintf('Interrupting now. Skipping this amount = %1.3g[s] \n',flipwhen-newFlip)</span>
0110 <span class="comment">%             param.next_id = param.prev_id;</span>
0111 <span class="comment">%             continue</span>
0112 <span class="comment">% %             flipTheScreen(newFlip, refreshRate);</span>
0113         <span class="keyword">else</span>
0114             <a href="#_sub1" class="code" title="subfunction flipTheScreen(flipwhen, refreshRate)">flipTheScreen</a>(flipwhen, refreshRate);
0115         <span class="keyword">end</span>
0116     <span class="keyword">end</span>
0117     
0118     <span class="comment">% Flip+flipwhen = precise, but blocks all other execution</span>
0119     <span class="comment">% waitsecs+flip -&gt;misses some flips/crashes</span>
0120     <span class="comment">% waitsecs+flip+flipwhen -&gt; imprecise</span>
0121     <span class="comment">% waitsecs+flip subfunction -&gt; very precise, some late presentations</span>
0122         
0123 <span class="comment">%% bits UP and DOWN</span>
0124     <span class="keyword">if</span> (~isempty(param.on_bit) || ~isempty(param.off_bit))        
0125        <span class="keyword">if</span> UserInfo.lab_connection 
0126         <span class="comment">% new exec times 3.9 to 4.1 ms (3.7.08)</span>
0127             <a href="ModigBitSender.html" class="code" title="function  ModigBitSender(lines, values)">ModigBitSender</a>([param.on_bit; param.off_bit]'+1,<span class="keyword">...</span>
0128                 [ones(1,length(param.on_bit)) zeros(1,length(param.off_bit))]);
0129        <span class="keyword">end</span>
0130     <span class="keyword">end</span>
0131     <span class="comment">% Time keeping</span>
0132     currentTS = Task.(TaskOp.cur_event_name).flipTimeStamp;
0133     
0134     <span class="comment">% Time tracking + debugging</span>
0135 <span class="comment">%     et=Task.(TaskOp.cur_event_name).flipTimeStamp - currentTS;</span>
0136 <span class="comment">%     disp([ param.next_time et et- param.next_time]);</span>
0137 
0138 
0139 <span class="comment">%% Deliver reward.</span>
0140     <span class="comment">% ~10 ms delay between Bit On/off and start of reward delivery</span>
0141     <span class="keyword">if</span> strcmp(TaskOp.cur_event_name,<span class="string">'us'</span>) &amp;&amp; ~isempty(jcSelfUS)
0142         eval(char(jcSelfUS))
0143     <span class="keyword">elseif</span> strcmp(TaskOp.cur_event_name,<span class="string">'otherUS'</span>) &amp;&amp; ~isempty(jcOthUS)
0144         eval(jcOthUS)
0145     <span class="keyword">end</span>
0146     
0147 <span class="comment">%% Show Experimental monitor /use old code for now</span>
0148 <span class="comment">%     ModigShiftEvent('ShowExpVisualPage',param.next_page+param.expPageMod-1);</span>
0149     
0150     <span class="comment">%% if starting ITI, use old ModigShiftEvent</span>
0151     <span class="keyword">if</span> strcmpi(param.next_event_name,<span class="string">'ITI'</span>),
0152         <a href="ModigShiftEvent.html" class="code" title="function varargout = ModigShiftEvent(varargin)">ModigShiftEvent</a>(<span class="string">'ShiftEvent'</span>,param);
0153         runTrial = 0;
0154     <span class="keyword">end</span>
0155 <span class="keyword">end</span>
0156 Priority(0);     
0157 
0158 <span class="comment">%% flip sub-function</span>
0159 <a name="_sub1" href="#_subfunctions" class="code">function flipTheScreen(flipwhen, refreshRate)</a>
0160 <span class="comment">% flipTheScreen(flipwhen, refreshRate)</span>
0161 <span class="comment">%</span>
0162 <span class="comment">% flipwhen:</span>
0163 <span class="comment">% refreshRate:</span>
0164 
0165 <span class="keyword">global</span> Task VisParam TaskOp
0166 <span class="keyword">persistent</span> tries 
0167 
0168 <span class="keyword">if</span> isempty(tries),
0169     tries = 0;
0170 <span class="keyword">end</span>
0171 
0172 <span class="keyword">try</span>
0173     Task.(TaskOp.cur_event_name).flipTimeStamp = eval(VisParam.page(TaskOp.next_page).flip);
0174 <span class="comment">%      Task.(TaskOp.cur_event_name).flipTimeStamp = Screen('Flip',VisParam.scr_handle,flipwhen);</span>
0175 <span class="keyword">catch</span>
0176     
0177     tries = tries+1;    
0178     <span class="keyword">if</span> tries &gt;100,
0179         keyboard
0180         error(<span class="string">'I give up showing the visual page!'</span>)
0181     <span class="keyword">end</span>
0182     <a href="#_sub1" class="code" title="subfunction flipTheScreen(flipwhen, refreshRate)">flipTheScreen</a>(flipwhen+refreshRate, refreshRate)
0183 <span class="keyword">end</span>
0184 
0185 <span class="keyword">if</span> tries &gt;0,
0186     fprintf(<span class="string">'Tried %d time(s) to show visual page\n'</span>,tries);
0187 <span class="keyword">end</span>
0188 tries = 0;
0189 
0190 
0191</pre></div>
