function [jCurTime, fullUStime] = calibrateJuiceDelivery(targetEpoch,targetInMl,interPulseDelay,pulses)
% jCurTime = calibrateJuiceDelivery(targetEpoch,targetInMl,interPulseDelay,pulses)
%
% calibrateJuiceDelivery uses calibration data to deliver the "target"
% amount of juice
%
% It can take input target(in ml) or, alternatively it reads Stim.us.target
%
% Output: assigns input target to Stim.us.target
%        changes Timers.Event.us.StartFcn, where DIojuice is used
%           jCurTime: calibrated time for each pulse
%           fullUStime: all time it will take to evaluate
%
% See also adjustSolenoidOpenTime
%
%
% rbm 3.12 
% rbm 4.12 Output fullUStime used to adjust inter-reward delay
%     7.12  changed 'sound' to psychPortAudio for low latency
global UserInfo TaskOp ExtDevice Stim Timers AudParam
jCurTime = 0;
fullUStime = 0;
upDownDelay = 0.005;
if nargin == 1,
    error('calibrateJuiceDelivery needs at least 2 inputs')
elseif nargin == 2,
    interPulseDelay = 0;
    pulses = 1;
end
ipd = num2str(interPulseDelay);

% ensure we deliver juice when asked for
if targetInMl<=0 || pulses==0,
    Timers.Event.(targetEpoch).StartFcn = {@timerTimeStamper};
    return
end


% last calibrated on Jun & Oct 2012

% use calibration curve to generate the pulse width -elegant solution
% Stim.us.betasSetupA = [-0.825277777777778;0.265;0.0101;];
% Stim.us.betasSetupA = [-0.6877; 0.2715; 0.0095]; % Jul 2010
% Stim.us.betasSetupA = [-0.1026, 0 , 0.004]; % Feb/2011
% Stim.us.betasSetupA = [0.0374, 0, 0.0043]; % Jul/2011
% Stim.us.betasSetupA = [-0.0445, 0, 0.0032]; % Jul 2011, after clean-up
% Stim.us.betasSetupA = [0.00709 0.0284 0.00295];% Mar 2012
% Stim.us.betasSetupA = [-0.0372453703347223,0.0247777777666667,0.00440277777750000];% Jun 2012
Stim.us.betasSetupA = [-0.0401, 0.037 0.0044]; % Oct 2012

% Stim.us.betasSetupB = [-0.358666666666665;0.152333333333333;0.006733333333333;];
% Stim.us.betasSetupB = [-0.327; 0.1765; 0.0056]; % Jul 2010, useful for
% multiple pulses
% Stim.us.betasSetupB = [-0.0286, 0, 0.0033]; %Feb/2011
% Stim.us.betasSetupB = [ 0.0223, 0, 0.0029]; % Jul 2011, after clean-up
% Stim.us.betasSetupB   = [-0.0105 0.0522 0.0029]; % Mar 2012
Stim.us.betasSetupB = [0.0105, 0.0437, 0.0028]; % Jun 2012

% retrieve current juice line
bIsActive = strcmp(TaskOp.curSetup,'B');

if UserInfo.lab_connection
    if (bIsActive && strcmpi(targetEpoch,'us')) || (~bIsActive && strcmpi(targetEpoch,'otherUS'))
        jCurTime = adjustSolenoidOpenTime(Stim.us.betasSetupB, targetInMl, pulses);
        curLine = ExtDevice.outputDio.juice2.Index;
    elseif (bIsActive && strcmpi(targetEpoch,'otherUS')) || (~bIsActive && strcmpi(targetEpoch,'us'))
        jCurTime = adjustSolenoidOpenTime(Stim.us.betasSetupA, targetInMl, pulses);
        curLine = ExtDevice.outputDio.juice1.Index;
    end
    
    if jCurTime<0,
        warning('AdjustSolenoidOpenTime suggested opening time < 0 with ml=%0.3g, time=%0.3g, pulses=%d',targetInMl,interPulseDelay,pulses)
        jCurTime = 0.015;
    end
        
    %%
    jCurTime = jCurTime-upDownDelay; % DIO up/down adjustment
    curJuiceCall = ['DIOjuice(',num2str(jCurTime),',',num2str(curLine),');'];    
    if pulses>1,
        juiceStr = {[repmat([curJuiceCall,'WaitSecs(',ipd,');'],1,pulses-1) curJuiceCall]};
    else
        juiceStr = curJuiceCall;
    end
else
   beepAsJuice('init');
   if (bIsActive && strcmpi(targetEpoch,'us')) || (~bIsActive && strcmpi(targetEpoch,'otherUS'))
        curLine = 12;
    elseif (bIsActive && strcmpi(targetEpoch,'otherUS')) || (~bIsActive && strcmpi(targetEpoch,'us'))        
        curLine = 11;
    end

   juiceStr = sprintf('beepAsJuice(''play'',%d);', curLine);
%     curJuiceCall   = 'Snd(''Play'',myBeep,22260);';
%     juiceStr = {['myBeep=MakeBeep(1000,.2);', repmat([curJuiceCall,'WaitSecs(',ipd,');'],1,pulses)]};
%     jCurTime = 0.2;
end

Timers.Event.(targetEpoch).StartFcn = {@timerTimeStamper juiceStr};

fullUStime = (jCurTime*pulses)+(str2double(ipd)*(pulses-1));
