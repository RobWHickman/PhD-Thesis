<h2><a name="_source"></a>SOURCE CODE <a href="#_top"><img alt="^" border="0" src="../../../../up.png"></a></h2>
<div class="fragment"><pre>0001 <a name="_sub0" href="#_subfunctions" class="code">function cb = ModigPreparePages_TWOAFC_SACC</a>
0002 <span class="comment">%  cb = ModigPreparePages_TWOAFC_SACC</span>
0003 <span class="comment">%</span>
0004 <span class="comment">% page 1: background</span>
0005 <span class="comment">% page 2: central fixation</span>
0006 <span class="comment">% page 3: peripheral choices</span>
0007 <span class="comment">% page 4: 1st choice acquisition</span>
0008 <span class="comment">% page 5: 2nd choice acquisition</span>
0009 <span class="comment">%</span>
0010 <span class="comment">% See also EXPSHOWIMAGE, EXPDRAWRECT, MODIGMONITORBEHAVIOR, DRAWRECT</span>
0011 
0012 <span class="comment">% RBM 09.07</span>
0013 <span class="keyword">global</span> Tbl VisParam Stim TaskOp
0014 type = <span class="string">'bars'</span>;
0015 cb = 1;
0016 VisParam.pages    = unique(cell2mat(Tbl.TaskTbl(:,Tbl.TaskTblColumnID.vis_page)));
0017 VisParam.pages    = VisParam.pages(VisParam.pages&gt;0);
0018 VisParam.num_page = length(VisParam.pages);
0019 
0020 <span class="comment">% String for Drawing with PTB for subject's screen the fixation spot,</span>
0021 bkgstr   = <span class="string">'Screen(''FillRect'', VisParam.scr_handle, [127 127 127]);'</span>;
0022 cF       = Stim.centralFix;
0023 ctr = VisParam.scr_rect(3:4)/2;
0024 
0025 cFpos    = [ctr-cF.position(1)-cF.size(1),<span class="keyword">...</span>
0026             ctr-cF.position(2)+cF.size(2)];
0027 cfstr    = [<span class="string">'Screen(''FillOval'', VisParam.scr_handle,['</span>,num2str(cF.color),<span class="string">'],['</span>,num2str(cFpos),<span class="string">']);'</span>];
0028 
0029 pF       = Stim.choices;
0030 flpstr   = <span class="string">'Screen(''Flip'',VisParam.scr_handle);'</span>;
0031 flpnoclr = <span class="string">'Screen(''Flip'',VisParam.scr_handle,[],1);'</span>;
0032 
0033 <span class="keyword">switch</span> type
0034     <span class="keyword">case</span> <span class="string">'circles'</span>
0035         <span class="keyword">for</span> i = 1:2,
0036             pFpos(i,:)    = [(VisParam.scr_rect(3:4)/2)+pF.position(i,:)-pF.size,<span class="keyword">...</span>
0037                              (VisParam.scr_rect(3:4)/2)+pF.position(i,:)+pF.size];
0038             pfstr(i).s    = [<span class="string">'Screen(''FillOval'', VisParam.scr_handle,['</span>,num2str(pF.chocolor(i,:)),<span class="string">'],['</span>,num2str(pFpos(i,:)),<span class="string">']);'</span>];
0039             pfacq    = [pFpos(i,1:2)-50 pFpos(i,3:4)+50];
0040             pfacqstr(i).s    = [<span class="string">'Screen(''FrameOval'', VisParam.scr_handle,['</span>,num2str(pF.acqcolor),<span class="string">'],['</span>,num2str(pfacq),<span class="string">']);'</span>];
0041         <span class="keyword">end</span>
0042     <span class="keyword">otherwise</span> <span class="comment">%case 'bars'</span>
0043         onehb  = [ctr(1)-pF.distCtr-pF.size, ctr(2)-pF.barH,<span class="keyword">...</span>
0044                    ctr(1)-pF.distCtr+pF.size, ctr(2)+pF.barH];
0045 
0046         twohb  = [ctr(1)+pF.distCtr-pF.size, ctr(2)-pF.barH,<span class="keyword">...</span>
0047                     ctr(1)+pF.distCtr+pF.size, ctr(2)+pF.barH];
0048 
0049         <span class="comment">% horizontal bars -px-</span>
0050         propRew = (pF.actRew-min(pF.rewRange))./(max(pF.rewRange)-min(pF.rewRange));
0051         pFpos(1,:)  = [ctr(1)-pF.distCtr-pF.size,<span class="keyword">...</span>
0052                onehb(4)-(pF.barH*2*propRew(TaskOp.choPos(1)))-pF.szHB,<span class="keyword">...</span>
0053                ctr(1)-pF.distCtr+pF.size,<span class="keyword">...</span>
0054                onehb(1,4)-(pF.barH*2*propRew(TaskOp.choPos(1)))];      
0055         pFpos(2,:)  = [ctr(1)+pF.distCtr-pF.size,<span class="keyword">...</span>
0056                 onehb(1,4)-(pF.barH*2*propRew(TaskOp.choPos(2)))-pF.szHB,<span class="keyword">...</span>
0057                 ctr(1)+pF.distCtr+pF.size,<span class="keyword">...</span>
0058                 onehb(1,4)-(pF.barH*2*propRew(TaskOp.choPos(2)))];
0059         <span class="comment">% converting matrix to char and then to evaluatable string ain't</span>
0060         <span class="comment">% allowed!</span>
0061         pos(:,:,1) = [onehb; pFpos(1,:)];
0062         pos(:,:,2) = [twohb; pFpos(2,:)];
0063         <span class="keyword">for</span> i = 1:2,
0064             wb = [<span class="string">'Screen(''FillRect'',VisParam.scr_handle,['</span>,num2str(pF.bkgclr),<span class="string">'],['</span>,num2str(pos(1,:,i)),<span class="string">']);'</span>];
0065             hb = [<span class="string">'Screen(''FillRect'',VisParam.scr_handle,['</span>,num2str(pF.chocolor),<span class="string">'],['</span>,num2str(pos(2,:,i)),<span class="string">']);'</span>];
0066             wbf = [<span class="string">'Screen(''FrameRect'',VisParam.scr_handle,['</span>,num2str(pF.chocolor),<span class="string">'],['</span>,num2str(pos(1,:,i)),<span class="string">'],3);'</span>];
0067             <span class="comment">% in case we have a '0' reward value</span>
0068             <span class="keyword">if</span> pF.actRew(TaskOp.choPos(i))&gt;0
0069 <span class="comment">%                 pfacq = [pos(2,1:2,i)-50 pos(2,3:4,i)+50]; % green circle</span>
0070 <span class="comment">%                 around the horizontal bar</span>
0071                 pfstr(i).s = [wb,<span class="string">' '</span>, hb, wbf];
0072             <span class="keyword">else</span>
0073                 pfstr(i).s = [wb,wbf];
0074                 <span class="comment">% momo related</span>
0075 <span class="comment">%                 pF.chocolor(i,:) = [0 255 255];%light blue</span>
0076 <span class="comment">%                 pFpos(i,2) = ctr(2);</span>
0077             <span class="keyword">end</span>
0078             pfacq = [pos(1,1:2,i)-50 pos(1,3:4,i)+50]; <span class="comment">% green circle around the whole stim</span>
0079             pfacqs = [<span class="string">'Screen(''FrameOval'', VisParam.scr_handle,[0 256 0],['</span>,num2str(pfacq),<span class="string">'],3);'</span>];
0080             pfacqstr(i).s = [pfstr(i).s pfacqs];
0081         <span class="keyword">end</span>
0082         pF.size = [10,10];
0083 <span class="keyword">end</span>
0084 
0085 VisParam.page(1).draw = bkgstr;
0086 VisParam.page(2).draw = cfstr ;
0087 VisParam.page(3).draw = [pfstr(1).s, pfstr(2).s ];
0088 VisParam.page(4).draw = [pfstr(1).s];<span class="comment">%, pfacqstr(1).s];</span>
0089 VisParam.page(5).draw = [pfstr(2).s];<span class="comment">%, pfacqstr(2).s];</span>
0090 
0091 VisParam.page(1).flip = flpstr;
0092 VisParam.page(2).flip = flpnoclr;
0093 VisParam.page(3).flip = flpstr;
0094 VisParam.page(4).flip = flpstr;
0095 VisParam.page(5).flip = flpstr;
0096     
0097 VisParam.page(1).str = [bkgstr, flpstr];
0098 VisParam.page(2).str = [cfstr , flpnoclr];
0099 VisParam.page(3).str = [pfstr(1).s, pfstr(2).s , flpstr];
0100 VisParam.page(4).str = [pfstr(1).s, pfacqstr(1).s, flpstr];
0101 VisParam.page(5).str = [pfstr(2).s, pfacqstr(2).s, flpstr];
0102 
0103 
0104 <span class="comment">% Draw stimulus on experimenter's monitor (ModigMonitor)</span>
0105 [TH h_monitor EMPTY] = <a href="../../../../Modig/library/isfield_sk.html" class="code" title="function [TF,value empty] = isfield_sk(stem, fullname)">isfield_sk</a>(VisParam,<span class="string">'h_MONITOR_AXIS'</span>);
0106 <span class="keyword">if</span> ~EMPTY
0107     <span class="keyword">if</span> ishandle(h_monitor),
0108         cfixhdl = zeros(1,3);
0109         cho1hdl = zeros(1,3);
0110         cho2hdl = zeros(1,3);
0111         pF.chocolor = [pF.chocolor; pF.chocolor];
0112         <span class="keyword">for</span> i=1:3,
0113             <span class="comment">% central fixation</span>
0114             cfixhdl(i) = rectangle(<span class="keyword">...</span>
0115                 <span class="string">'Position'</span>, [cFpos(1:2) cF.size*2],<span class="keyword">...</span>
0116                 <span class="string">'FaceColor'</span>,cF.color/256,<span class="keyword">...</span>
0117                 <span class="string">'Parent'</span>,h_monitor,<span class="keyword">...</span>
0118                 <span class="string">'Visible'</span>, <span class="string">'off'</span>);       
0119             <span class="comment">% choices fix,%                 'Position', [pFpos(1,1)</span>
0120             <span class="comment">% VisParam.scr_center_y+pF.position(1,2)-pF.size(2)</span>
0121             <span class="comment">% pF.size*2],...</span>
0122             cho1hdl(i) = rectangle(<span class="keyword">...</span>
0123                 <span class="string">'Position'</span>, [pFpos(1,1) VisParam.scr_rect(4)-pFpos(1,2) pF.size*2],<span class="keyword">...</span>
0124                 <span class="string">'FaceColor'</span>,pF.chocolor(1,:)./256,<span class="keyword">...</span>
0125                 <span class="string">'Parent'</span>,h_monitor,<span class="keyword">...</span>
0126                 <span class="string">'Tag'</span>, <span class="string">'choice1'</span>,<span class="keyword">...</span>
0127                 <span class="string">'Visible'</span>, <span class="string">'off'</span>);
0128             cho2hdl(i) = rectangle(<span class="keyword">...</span>
0129                 <span class="string">'Position'</span>, [pFpos(2,1)  VisParam.scr_rect(4)-pFpos(2,2) pF.size*2],<span class="keyword">...</span>
0130                 <span class="string">'FaceColor'</span>,pF.chocolor(2,:)./256,<span class="keyword">...</span>
0131                 <span class="string">'Parent'</span>,h_monitor,<span class="keyword">...</span>
0132                 <span class="string">'Tag'</span>, <span class="string">'choice2'</span>,<span class="keyword">...</span>
0133                 <span class="string">'Visible'</span>, <span class="string">'off'</span>);
0134 <span class="comment">%                             % target acquired feedback ... circle</span>
0135 <span class="comment">%                 theta = linspace(0,2*pi,1000);</span>
0136 <span class="comment">%                 rho   = ones(1,1000)* ((sz(1)/2)+Stim.targetFB.size);</span>
0137 <span class="comment">%                 [X,Y] = pol2cart(theta,rho); % polar to cartesian</span>
0138 <span class="comment">%                 X     = X + Stim.target.center(1);</span>
0139 <span class="comment">%                 Y     = Y + Stim.target.center(2);</span>
0140 <span class="comment">%                 fbHdl(i) = plot(X,Y,...</span>
0141 <span class="comment">%                         'Color',Stim.targetFB.color./256,...</span>
0142 <span class="comment">%                         'Parent',h_monitor,...</span>
0143 <span class="comment">%                         'Visible', 'off');</span>
0144         <span class="keyword">end</span>
0145 
0146         
0147         VisParam.exp_page(1).obj_handle = cfixhdl(1);
0148         VisParam.exp_page(2).obj_handle = [cho1hdl(1); cho2hdl(1); cfixhdl(2)];
0149         VisParam.exp_page(3).obj_handle = [cho1hdl(2); cho2hdl(2)];
0150         VisParam.exp_page(4).obj_handle = cho1hdl(3);
0151         VisParam.exp_page(5).obj_handle = cho2hdl(3);
0152         <span class="keyword">for</span> i = 1:5,
0153             VisParam.exp_page(i).scr_handle = h_monitor;
0154         <span class="keyword">end</span>
0155     <span class="keyword">end</span>
0156 <span class="keyword">end</span></pre></div>
