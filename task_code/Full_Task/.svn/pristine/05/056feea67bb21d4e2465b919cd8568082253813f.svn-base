<h2><a name="_source"></a>SOURCE CODE <a href="#_top"><img alt="^" border="0" src="../../../../up.png"></a></h2>
<div class="fragment"><pre>0001 <a name="_sub0" href="#_subfunctions" class="code">function param = ModigJudgeSituation_TOUCH_TRAINING(time_beh,prev_id)</a>
0002 <span class="comment">%</span>
0003 <span class="comment">% 1. pre-trial</span>
0004 <span class="comment">% 2. visual cue</span>
0005 <span class="comment">% 3. touch FB</span>
0006 <span class="comment">% 4. us</span>
0007 <span class="comment">% 5. iti</span>
0008 <span class="comment">% 6. error</span>
0009 <span class="comment">%</span>
0010 <span class="comment">% rbm 1.08</span>
0011 
0012 <span class="keyword">global</span> Tbl Timers Stim TaskOp VisParam MENUs UserInfo Task
0013 
0014 <span class="comment">% Initalize variables</span>
0015 param.ok                = 1;
0016 param.time_beh          = time_beh;
0017 param.prev_id           = prev_id;
0018 
0019 param.hand.req          = 0;
0020 param.hand.filter_time  = 0;
0021 
0022 param.touch.req           = {};
0023 param.touch.filter_time   = [];
0024 param.touch.state         = 0;
0025 param.touch.limits        =[];
0026 
0027 param.expPageMod    = 0;
0028 param.on_bit = [];
0029 param.off_bit =[];
0030 
0031 TaskOp.touchInterrupt = 0;
0032 TaskOp.handInterrupt= 0;
0033 TaskOp.hold         = 0;
0034 TaskOp.holdTime = 0;
0035 
0036 <span class="keyword">switch</span> param.time_beh
0037     <span class="keyword">case</span> 1 <span class="comment">% called by timer</span>
0038         <span class="keyword">switch</span> param.prev_id
0039             <span class="keyword">case</span> 1 <span class="comment">% pre</span>
0040                 <span class="keyword">if</span> UserInfo.use_touch_screen,
0041                      SetMouse(2048,0);
0042                 <span class="keyword">end</span>
0043                 tar = Stim.target;
0044                 param.touch.req          = <span class="string">'oneTouchArea'</span>;
0045                 param.touch.filter_time = tar.filter_time;
0046                 param.touch.limits      = tar.touchLimits;
0047 
0048                 TaskOp.touchInterrupt = 1;   
0049                  
0050                 param.next_id  = 2;
0051                 
0052             <span class="keyword">case</span> 2 <span class="comment">% visual cue</span>
0053                 <span class="keyword">if</span> TaskOp.interrupt,
0054                     param.next_id = 3; 
0055                     TaskOp.correct=1;
0056                 <span class="keyword">else</span>
0057                     param.next_id = 5; 
0058                 <span class="keyword">end</span>
0059                 
0060             <span class="keyword">case</span> 3 <span class="comment">% touch FB</span>
0061                 param.next_id = 4; 
0062                 
0063             <span class="keyword">case</span> 4 <span class="comment">% us</span>
0064                 param.next_id = 5;
0065                 
0066             <span class="keyword">case</span> 5 <span class="comment">% ITI</span>
0067                 param.hand.req         = 1;
0068                 param.hand.filter_time = Stim.pre.hand.filter_time;
0069                 TaskOp.handInterrupt   = Stim.pre.handInterrupt;
0070                 TaskOp.hold            = Stim.pre.hold;
0071                 TaskOp.holdTime        = Stim.pre.holdTime;
0072                 
0073                 param.next_id = 1;
0074                 
0075             <span class="keyword">case</span> 6 <span class="comment">% error</span>
0076                 TaskOp.correct = 0;
0077                 param.next_id = 5; 
0078         <span class="keyword">end</span>
0079     <span class="keyword">case</span> 2 <span class="comment">% called by behavior during an error</span>
0080        disp(sprintf(<span class="string">'error @ %s'</span>,char(Tbl.TaskTbl(param.prev_id,Tbl.TaskTblColumnID.evnt_name))))
0081        <span class="keyword">switch</span> param.prev_id
0082            <span class="keyword">case</span> 1
0083                TaskOp.ignored = 1;
0084            <span class="keyword">case</span> 2
0085                 TaskOp.count.noTouch = TaskOp.count.noTouch+1;
0086        <span class="keyword">end</span>
0087         param.next_id = 6; 
0088 <span class="keyword">end</span>
0089 <span class="comment">% Recover timer and event names from global Tbl</span>
0090 param.prev_event_name = cell2mat(Tbl.TaskTbl(param.prev_id,Tbl.TaskTblColumnID.evnt_name));
0091 param.prev_timer      = Timers.Event.(param.prev_event_name);
0092 
0093 param.next_event_name = cell2mat(Tbl.TaskTbl(param.next_id,Tbl.TaskTblColumnID.evnt_name));
0094 param.next_timer      = Timers.Event.(param.next_event_name);
0095 param.next_page       = cell2mat(Tbl.TaskTbl(param.next_id, Tbl.TaskTblColumnID.vis_page));</pre></div>
