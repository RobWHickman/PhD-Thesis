<h2><a name="_source"></a>SOURCE CODE <a href="#_top"><img alt="^" border="0" src="../../../../up.png"></a></h2>
<div class="fragment"><pre>0001 <a name="_sub0" href="#_subfunctions" class="code">function updateMoMaMe_TOUCH_TRAINING(option)</a>
0002 <span class="comment">% updateMoMaMe_TOUCH_TRAINING(option)</span>
0003 <span class="comment">%</span>
0004 <span class="comment">% creates a project specific and totally modifiable update area in the</span>
0005 <span class="comment">% MOMaMe figure using uicontrols.</span>
0006 <span class="comment">%</span>
0007 <span class="comment">% inputs: 'initialize' --&gt;creates the uicontrols</span>
0008 <span class="comment">%         'update' --&gt; updates the counters.</span>
0009 <span class="comment">%         'reset' --&gt; resets the counters</span>
0010 <span class="comment">%</span>
0011 <span class="comment">% rbm 6.11</span>
0012 <span class="keyword">global</span> MENUs Stim TaskOp Timers Task
0013 figHdl = MENUs.ModigMainMenu.handle;
0014 upArea = MENUs.ModigMainMenu.handles.prjUpArea;
0015 
0016 <span class="keyword">switch</span> option,
0017     <span class="keyword">case</span> <span class="string">'initialize'</span>,
0018         
0019         <span class="comment">% change Area name,</span>
0020         set(upArea,<span class="string">'Units'</span>,<span class="string">'pixels'</span>)
0021         set(upArea,<span class="string">'Title'</span>, TaskOp.prj)
0022 
0023         <span class="comment">% delete previous data</span>
0024         kids = get(upArea, <span class="string">'children'</span>);
0025         delete(kids)
0026         
0027 
0028         <span class="comment">% since the parent is the project update area the position values are in</span>
0029         <span class="comment">% reference to the ui control parent, *not* the figure itself</span>
0030         uicontrol(upArea, <span class="string">'style'</span>, <span class="string">'text'</span>, <span class="string">'units'</span>, <span class="string">'pixels'</span>,<span class="keyword">...</span><span class="comment">  </span>
0031             <span class="string">'HorizontalAlignment'</span>,<span class="string">'left'</span>,<span class="keyword">...</span>
0032             <span class="string">'position'</span>, [1 1 120 135],<span class="keyword">...</span><span class="comment"> </span>
0033             <span class="string">'fontSize'</span>, 10,<span class="keyword">...</span>
0034             <span class="string">'backgroundColor'</span>, [0.831 0.816 0.784],<span class="keyword">...</span>
0035             <span class="string">'tag'</span>, <span class="string">'optionsText'</span>, <span class="keyword">...</span>
0036             <span class="string">'string'</span>,{<span class="string">'Past trial RT (ms)'</span>;<span class="string">'Mean RT (ms)'</span>})
0037 
0038         <span class="comment">% for simpler updating use matrix</span>
0039         uicontrol(upArea, <span class="string">'style'</span>, <span class="string">'text'</span>, <span class="string">'units'</span>, <span class="string">'pixels'</span>,<span class="keyword">...</span>
0040             <span class="string">'position'</span>, [130 1 75 135],<span class="keyword">...</span><span class="comment"> </span>
0041             <span class="string">'HorizontalAlignment'</span>,<span class="string">'left'</span>,<span class="keyword">...</span>
0042             <span class="string">'fontSize'</span>, 10, <span class="keyword">...</span>
0043             <span class="string">'backgroundColor'</span>, [0.831 0.816 0.784],<span class="keyword">...</span>
0044             <span class="string">'tag'</span>, <span class="string">'counterValues'</span>,<span class="keyword">...</span>
0045             <span class="string">'string'</span>,num2str(zeros(2,1)))      
0046         
0047         <span class="comment">% error strings...</span>
0048         uicontrol(upArea, <span class="string">'style'</span>, <span class="string">'text'</span>, <span class="string">'units'</span>, <span class="string">'pixels'</span>,<span class="keyword">...</span>
0049             <span class="string">'position'</span>, [205 1 120 135],<span class="keyword">...</span><span class="comment"> </span>
0050             <span class="string">'HorizontalAlignment'</span>,<span class="string">'right'</span>,<span class="keyword">...</span>
0051             <span class="string">'fontSize'</span>, 10, <span class="keyword">...</span>
0052             <span class="string">'backgroundColor'</span>, [0.831 0.816 0.784],<span class="keyword">...</span>
0053             <span class="string">'tag'</span>, <span class="string">'errorStrings'</span>,<span class="keyword">...</span>
0054             <span class="string">'string'</span>,{<span class="string">'Early KT release: '</span>;<span class="string">'No touch: '</span>; <span class="string">'Errors in succesion: '</span>});
0055         uicontrol(upArea, <span class="string">'style'</span>, <span class="string">'text'</span>, <span class="string">'units'</span>, <span class="string">'pixels'</span>,<span class="keyword">...</span>
0056             <span class="string">'position'</span>, [325 1 50 135],<span class="keyword">...</span><span class="comment"> </span>
0057             <span class="string">'HorizontalAlignment'</span>,<span class="string">'left'</span>,<span class="keyword">...</span>
0058             <span class="string">'fontSize'</span>, 10, <span class="keyword">...</span>
0059             <span class="string">'backgroundColor'</span>, [0.831 0.816 0.784],<span class="keyword">...</span>
0060             <span class="string">'tag'</span>, <span class="string">'errorNos'</span>,<span class="keyword">...</span>
0061             <span class="string">'string'</span>,num2str(zeros(3,1)));
0062 
0063         <span class="comment">% update gui handles</span>
0064         uih = guihandles(figHdl);
0065         guidata(figHdl, uih);
0066 
0067         <span class="comment">% update our globals</span>
0068         MENUs.ModigMainMenu.handles = <a href="../../../../Modig/library/sort_structure.html" class="code" title="function structure_out = sort_structure(structure)">sort_structure</a>(uih);
0069         MENUs.ModigMainMenu.handle  = figHdl;
0070 
0071         TaskOp.count.earlyRelease   = 0; <span class="comment">% here we save early key touch releases</span>
0072         TaskOp.count.noTouch        = 0; <span class="comment">% save no touches</span>
0073         TaskOp.count.successiveError= 0;
0074         TaskOp.count.choiceRT       = []; 
0075         TaskOp.count.seq            = 0;
0076         
0077     <span class="keyword">case</span> <span class="string">'update'</span>,
0078         <span class="comment">% variables can be undeclared,</span>
0079         <span class="keyword">if</span> ~isfield(TaskOp.count,<span class="string">'choiceRT'</span>) || ~isfield(TaskOp.count,<span class="string">'successiveError'</span>)
0080             <a href="updateMoMaMe_TOUCH_TRAINING.html" class="code" title="function updateMoMaMe_TOUCH_TRAINING(option)">updateMoMaMe_TOUCH_TRAINING</a>(<span class="string">'initialize'</span>)
0081             <a href="updateMoMaMe_TOUCH_TRAINING.html" class="code" title="function updateMoMaMe_TOUCH_TRAINING(option)">updateMoMaMe_TOUCH_TRAINING</a>(<span class="string">'update'</span>)
0082         <span class="keyword">end</span>
0083        
0084         choiceRT = NaN;
0085         m = 0;
0086 
0087         <span class="comment">% update counters</span>
0088         <span class="keyword">if</span> TaskOp.correct
0089             <span class="keyword">if</span> isfield(Timers.Event,<span class="string">'visualCue'</span>) 
0090                 pre = Timers.Event.visualCue.Userdata;
0091                 choiceRT = pre(end).Data-Task.visualCue.flipTimeStamp;
0092             <span class="keyword">end</span>
0093             TaskOp.count.choiceRT = [TaskOp.count.choiceRT choiceRT];                       
0094             TaskOp.count.successiveError = 0;           
0095 <span class="comment">%         elseif TaskOp.repeatError == 1,</span>
0096         <span class="keyword">else</span>
0097             TaskOp.count.successiveError = TaskOp.count.successiveError +1;
0098         <span class="keyword">end</span>
0099         
0100         <span class="keyword">if</span> ~isempty(TaskOp.count.choiceRT),
0101             m = round(mean(TaskOp.count.choiceRT)*1000);
0102         <span class="keyword">end</span>              
0103         s = num2str([round(choiceRT*1000); m]);
0104         set(MENUs.ModigMainMenu.handles.counterValues, <span class="string">'string'</span>, s)
0105         
0106         en = [TaskOp.count.earlyRelease; TaskOp.count.noTouch; TaskOp.count.successiveError];
0107         set(MENUs.ModigMainMenu.handles.errorNos, <span class="keyword">...</span>
0108             <span class="string">'string'</span>,num2str(en))       
0109         
0110     <span class="keyword">case</span> <span class="string">'reset'</span>,
0111         TaskOp.count.earlyRelease   = 0; <span class="comment">% here we save early key touch releases</span>
0112         TaskOp.count.noTouch        = 0; <span class="comment">% save no touches</span>
0113         TaskOp.count.successiveError= 0;
0114         TaskOp.count.choiceRT       = []; 
0115         TaskOp.count.seq            = 0;
0116         
0117         s = num2str([0; 0]);
0118         set(MENUs.ModigMainMenu.handles.counterValues, <span class="string">'string'</span>, s)
0119         
0120         en = [TaskOp.count.earlyRelease; TaskOp.count.noTouch; TaskOp.count.successiveError];
0121         set(MENUs.ModigMainMenu.handles.errorNos, <span class="keyword">...</span>
0122             <span class="string">'string'</span>,num2str(en))     
0123 <span class="keyword">end</span></pre></div>
