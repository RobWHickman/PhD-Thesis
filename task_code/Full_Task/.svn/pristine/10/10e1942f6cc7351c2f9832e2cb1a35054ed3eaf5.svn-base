function indices = findIndicesInVector(a,b)
% 
% indices = findIndicesInVector(a,b)
%
% helper function,
%   a = vector where indices will be found
%   b = vector of possible matches
%
%   indices = logical vector of length(a) with matches
%
% rbm 
if length(a)==numel(a) && length(b)==numel(b),
    myA = repmat(a, 1, length(b));
    myB = repmat(b, 1, length(a))';
    indices = sum(myA==myB,2)==1;
else
    error('Inputs need to be vectors')
end
