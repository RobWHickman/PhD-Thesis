<h2><a name="_source"></a>SOURCE CODE <a href="#_top"><img alt="^" border="0" src="../../up.png"></a></h2>
<div class="fragment"><pre>0001 <a name="_sub0" href="#_subfunctions" class="code">function adaptiveError(display)</a>
0002 <span class="comment">% adaptive error when running Getty, so to reflect time that</span>
0003 <span class="comment">% Getty won't release control</span>
0004 <span class="comment">%</span>
0005 <span class="comment">% can be called in MoJuSit_(prj) to modify 'on the fly' the error timer</span>
0006 <span class="comment">%</span>
0007 
0008 
0009 <span class="keyword">global</span> TaskOp Timers
0010 
0011 <span class="keyword">if</span> isfield(TaskOp,<span class="string">'trLTimer'</span>)
0012     start = TaskOp.EvntHist.cur_trial_start_time;
0013     gettyRelease = start+(TaskOp.trLTimer/1000);
0014     now = GetSecs;
0015     waitThisLong = gettyRelease - now;
0016     waitThisLong = round(waitThisLong*1000)/1000;
0017     Timers.Event.error.startDelay = waitThisLong;
0018 
0019     <span class="keyword">if</span> nargin==1 &amp;&amp; display
0020         disp(sprintf(<span class="string">'error timeout.  %3.4g out of: %3.4g'</span>, waitThisLong,TaskOp.trLTimer/1000))
0021     <span class="keyword">end</span>
0022 <span class="keyword">end</span></pre></div>
