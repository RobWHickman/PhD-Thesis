function updateMoMaMe_IMP_GIVING(option)
% updateMoMaMe_IMP_GIVING(option)
%
% creates a project specific and totally modifiable update area in the
% MOMaMe figure using uicontrols. 
% 
% inputs: 'initialize' -->creates the uicontrols
%         'update' --> updates the counters.
%         'reset' --> resets the counters
%
%
% rbm 6.08
%     4.09 uses userdata for succesive errors   
global MENUs Stim TaskOp Timers Task 

figHdl = MENUs.ModigMainMenu.handle;
upArea = MENUs.ModigMainMenu.handles.prjUpArea;

% 
if nargin == 0,
    option = 'initialize';
end

switch option,
    case 'initialize',
        % get all variables loaded
        ModigPrepareTiming;
        ModigPrepareTrial_IMP_GIVING;
%         shiftSetupMoMaMe;
        
        % change Area name,
        set(upArea,'Units','pixels')
        set(upArea,'Title', TaskOp.prj)
        
        % delete previous children objects
        kids = get(upArea,'Children');
        delete (kids)
        
        TaskOp.count.earlyRelease = 0; % here we save early key touch releases
        TaskOp.count.noTouch    = 0; % save no touches
        TaskOp.count.choiceRT   = [];  % save choice RT
        TaskOp.count.noKeyRelease = 0;
        TaskOp.count.successiveError = 0;
        TaskOp.count.conditionError = zeros(size(TaskOp.count.prjCount));
        TaskOp.count.conditionRT = zeros(size(TaskOp.count.prjCount));
        
        uicontrol(upArea, 'style', 'text', 'units', 'pixels',...    
            'position', [10 120 220 15],... 
            'fontSize', 9,...
            'backgroundColor', [0.831 0.816 0.784],...
            'tag', 'optionsText1', 'string',sprintf('Receiver---Giver  Corr. #    %%         RT'))
        
        if isfield(Stim,'us')
            opT2 = Stim.us.possiblePulses';
        else
            opT2 = [2; 2];
        end
         uicontrol(upArea, 'style', 'text', 'units', 'pixels',...    
            'position', [50 10 60 110],... 
            'fontSize', 9,...
            'backgroundColor', [0.831 0.816 0.784],...
            'tag', 'optionsText2', 'string', num2str(opT2));
        
         uicontrol(upArea, 'style', 'text', 'units', 'pixels',...
            'position', [120 10 30 110],... 
            'fontSize', 9, ...
            'backgroundColor', [0.831 0.816 0.784],...
            'tag', 'optionsValues', ...
            'string',num2str(TaskOp.count.prjCount))
        
         uicontrol(upArea, 'style', 'text', 'units', 'pixels',...
            'position', [160 10 30 110],... 
            'fontSize', 9, ...
            'backgroundColor', [0.831 0.816 0.784],...
            'tag', 'conditionError', ...
            'string',num2str(TaskOp.count.conditionError))
        
         uicontrol(upArea, 'style', 'text', 'units', 'pixels',...
            'position', [200 10 30 110],... 
            'fontSize', 9, ...
            'backgroundColor', [0.831 0.816 0.784],...
            'tag', 'conditionRT', ...
            'string',num2str(TaskOp.count.prjCount))
        
        % error strings...
        uicontrol(upArea, 'style', 'text', 'units', 'pixels',...
            'position', [260 1 120 135],... 
            'HorizontalAlignment','right',...
            'fontSize', 10, ...
            'backgroundColor', [0.831 0.816 0.784],...
            'tag', 'errorStrings',...
            'string',{'Early KT release: ';'No touch: '; 'No key release: ';'Errors in succesion: '; 'Mean RT: ';'Last RT: '});
        uicontrol(upArea, 'style', 'text', 'units', 'pixels',...
            'position', [375 1 50 135],... 
            'HorizontalAlignment','left',...
            'fontSize', 10, ...
            'backgroundColor', [0.831 0.816 0.784],...
            'tag', 'errorNos',...
            'string',num2str(zeros(6,1)));

        % update gui handles
        uih = guihandles(figHdl);
        guidata(figHdl, uih);

        % update our globals
        MENUs.ModigMainMenu.handles = sort_structure(uih);
        MENUs.ModigMainMenu.handle  = figHdl;        
    case 'update',        
        % variables can be empty,
        if ~isfield(TaskOp.count,'earlyRelease') || ...
                ~isfield(TaskOp.count,'noKeyRelease') || ...
                ~isfield(TaskOp.count,'successiveError') || ...
                ~isfield(TaskOp.count,'conditionRT') || ...
                ~isfield(MENUs.ModigMainMenu.handles,'errorNos')
%             || ...
%                 ~isfield(TaskOp,'A') || ~isfield(TaskOp,'B'),
            updateMoMaMe_IMP_GIVING('initialize');
            updateMoMaMe_IMP_GIVING('update');
            
            
%             shiftSetupMoMaMe;
        end

        % initialize input to GUI
        choiceRT=0;
        if numel(TaskOp.count.choiceRT)>0,
            meanRT = round(1000*mean(TaskOp.count.choiceRT));
        else
            meanRT = 0;
        end
        
        upRow = 1;
        if TaskOp.count.seq > 0,
            upRow = TaskOp.(TaskOp.curSetup).trialOrder(TaskOp.count.seq,1);
        end
        
        % evaluate depending on trial performance
        if TaskOp.correct
            TaskOp.count.prjCount(upRow) = TaskOp.count.prjCount(upRow) + 1;
            TaskOp.count.successiveError = 0;
            
            if ~strcmp(Stim.CSon.type,'dreiEck'),
%                 pre = Timers.Event.targetOn.Userdata;
%                 choiceRT = pre(end).Data-Task.targetOn.flipTimeStamp; 
                choiceRT = Task.touchFB.flipTimeStamp-Task.targetOn.flipTimeStamp;
                TaskOp.count.choiceRT = [TaskOp.count.choiceRT choiceRT];
                choiceRT = round(1000*choiceRT);
                meanRT = round(1000*mean(TaskOp.count.choiceRT));
                
                % condition RT update (FUCK structures!)
                thisCol = 1+size(TaskOp.count.conditionRT,2);
                TaskOp.count.conditionRT(1,thisCol) = upRow;
                TaskOp.count.conditionRT(2,thisCol) = single(choiceRT);
                
                toUpdate = zeros(size(TaskOp.count.prjCount));
                for i = 1:size(TaskOp.count.prjCount,1),
                    thisTrials = TaskOp.count.conditionRT(1,:)==i;
                    if sum(thisTrials)>0,
                        toUpdate(i) = round(mean(TaskOp.count.conditionRT(2,thisTrials)));
                    end
                end
                
                set(MENUs.ModigMainMenu.handles.conditionRT,'String',num2str(toUpdate));
            end
                        
        elseif TaskOp.repeatError
            TaskOp.count.successiveError=TaskOp.count.successiveError+1;
 
           %% determine if monkey didn't release the key          
           noKeyRelease_module(3, 'targetOn');
           
           % condition-specific counter update
           TaskOp.count.conditionError(upRow) = TaskOp.count.conditionError(upRow)+1;           
        end

        % update GUI
        en = [TaskOp.count.earlyRelease; TaskOp.count.noTouch; ...
            TaskOp.count.noKeyRelease; TaskOp.count.successiveError;  ...
            meanRT; choiceRT];
        set(MENUs.ModigMainMenu.handles.errorNos, 'string',num2str(en))
        set(MENUs.ModigMainMenu.handles.optionsValues, 'string', ...
            num2str(TaskOp.count.prjCount))
        if numel(TaskOp.count.prjCount)==numel(TaskOp.count.conditionError)
            warning('off','MATLAB:divideByZero')
            corrects = round(100*(TaskOp.count.prjCount ./ (TaskOp.count.conditionError+TaskOp.count.prjCount)));
            warning('on','MATLAB:divideByZero')
            set(MENUs.ModigMainMenu.handles.conditionError, 'String',num2str(corrects));
        end
trialTime=TaskOp.trecon;
tt=trialTime(:,[1 2 4 5]);
[tt{7:10,3}]-tt{6,3}
    case 'reset',
        % reset counters
        TaskOp.count.prjCount = zeros(numel(TaskOp.count.prjCount),1);
        TaskOp.count.earlyRelease = 0;
        TaskOp.count.noTouch = 0;
        TaskOp.count.choiceRT = [];
        TaskOp.count.noKeyRelease = 0;
        TaskOp.count.successiveError = 0;
        TaskOp.count.conditionError= zeros(size(TaskOp.count.prjCount));
        TaskOp.count.conditionRT  = zeros(size(TaskOp.count.prjCount));
        errors = zeros(size(TaskOp.count.prjCount));
        % update GUI          
        en = [TaskOp.count.earlyRelease; TaskOp.count.noTouch; ...
            TaskOp.count.noKeyRelease; TaskOp.count.successiveError;  ...
            0; 0];
        set(MENUs.ModigMainMenu.handles.errorNos, 'string',num2str(en))           
        set(MENUs.ModigMainMenu.handles.optionsValues, 'string', ...
            num2str(TaskOp.count.prjCount))
        
        set(MENUs.ModigMainMenu.handles.conditionError, 'String',num2str(errors));
        set(MENUs.ModigMainMenu.handles.conditionRT, 'String',num2str(errors));
end
        