<h2><a name="_source"></a>SOURCE CODE <a href="#_top"><img alt="^" border="0" src="../../../../up.png"></a></h2>
<div class="fragment"><pre>0001 <a name="_sub0" href="#_subfunctions" class="code">function runned = ModigPrepareTrial_GUIDED_REACH</a>
0002 <span class="comment">% Prepares trial parameters in project 'GUIDED_REACH'</span>
0003 <span class="comment">%</span>
0004 <span class="comment">%</span>
0005 
0006 <span class="comment">% RBM   1.08</span>
0007 <span class="comment">%       3.08</span>
0008 <span class="comment">%       5.08 giving option</span>
0009 <span class="keyword">global</span> Stim VisParam TaskOp Timers Task UserInfo
0010 
0011 <span class="comment">%% CS on STIM DEFS</span>
0012 Stim.us.possiblePulses = 1;
0013 <span class="comment">% pre = randperm(length(Stim.us.possiblePulses));</span>
0014 pre = randperm(length(Stim.us.possiblePulses));
0015 <span class="comment">% if y(1) &gt;= .9,</span>
0016 <span class="comment">%     pre = 3;</span>
0017 <span class="comment">% elseif y(1) &gt;= .45 &amp;&amp; y(1) &lt;= 0.9</span>
0018 <span class="comment">%     pre = 2;</span>
0019 <span class="comment">% else</span>
0020 <span class="comment">%     pre = 1;</span>
0021 <span class="comment">% end</span>
0022 Stim.us.pulses = Stim.us.possiblePulses(pre(1));
0023 Stim.us.giving = 0;
0024 
0025 <span class="comment">%%</span>
0026 Stim.CSon.size  = 75;
0027 randCSonPos = 1;
0028 switchAxis = 1;
0029 <span class="keyword">if</span> randCSonPos,
0030     
0031     distCtr = [150, -150];
0032     pos = randperm(length(distCtr));
0033     scrCtr = VisParam.scr_rect(3:4)/2;
0034     <span class="keyword">if</span> switchAxis,
0035         Stim.CSon.center = [scrCtr(1), scrCtr(2)-distCtr(pos(1))];
0036     <span class="keyword">else</span>
0037         Stim.CSon.center   = [scrCtr(1)-distCtr(pos(1)), scrCtr(2)+175];
0038     <span class="keyword">end</span>
0039 <span class="keyword">end</span>
0040 
0041 <span class="comment">%</span>
0042 Stim.CSon.type = <span class="string">'ring'</span>;
0043 <span class="keyword">switch</span> Stim.CSon.type
0044     <span class="keyword">case</span> <span class="string">'square'</span>
0045         Stim.CSon.color    = [125 255 255];
0046         
0047         <span class="comment">% how many pulses?</span>
0048         Stim.CSon.pulses = 3;
0049         Stim.CSon.pulseMag = 40; <span class="comment">% in ms</span>
0050         Stim.CSon.pulseStimSize = 40;
0051 
0052         <span class="comment">% divide the draw range in quadrants and randomly draw in 'three' of them</span>
0053         quads = floor(Stim.CSon.size/Stim.CSon.pulseStimSize);
0054         quadMat = repmat(quads,quads)*0;
0055         lottery = randperm(quads*quads);
0056         quadMat(lottery(1:Stim.CSon.pulses)) = 1;
0057         pulseXstart = floor(linspace(Stim.CSon.position(1),<span class="keyword">...</span>
0058             Stim.CSon.position(3)-Stim.CSon.pulseStimSize,quads));
0059         pulseYstart = floor(linspace(Stim.CSon.position(2),<span class="keyword">...</span>
0060             Stim.CSon.position(4)-Stim.CSon.pulseStimSize,quads));
0061         [row,col]=find(quadMat==1);
0062         Stim.CSon.pulsePos = [pulseXstart(row); pulseYstart(col)];
0063         Stim.CSon.pulsePos(3:4,:) = Stim.CSon.pulsePos+Stim.CSon.pulseStimSize;
0064         Stim.CSon.pulseClr = [256 256 256];
0065         
0066         <span class="comment">%</span>
0067     <span class="keyword">case</span> <span class="string">'img'</span>
0068         Stim.CSon.position = [Stim.CSon.center-(Stim.CSon.size/2),<span class="keyword">...</span>
0069                         Stim.CSon.center+(Stim.CSon.size/2)];
0070         Stim.CSon.img = imread(<span class="string">'Picture 056.jpg'</span>);
0071     <span class="keyword">case</span> <span class="string">'bars'</span>
0072         <span class="comment">% proportional payoff in the bars:</span>
0073         rew = [50 60 70 80];
0074         Stim.CSon.alt = rew;
0075         selRew = randperm(length(rew)); <span class="comment">% equal prob</span>
0076         Stim.CSon.rewRange = [50 150];
0077         Stim.CSon.actRew = rew(sort(selRew(1)));
0078         Stim.CSon.bkgclr = [255 255 255];
0079         Stim.CSon.vBarWidth = 30;
0080         Stim.CSon.hBarHeigth = 20;
0081         Stim.CSon.position([1 3]) =  [Stim.CSon.center(1)-Stim.CSon.vBarWidth,<span class="keyword">...</span>
0082             Stim.CSon.center(1)+Stim.CSon.vBarWidth];
0083         Stim.CSon.chocolor = [0 0 255];
0084     <span class="keyword">case</span> <span class="string">'ring'</span>
0085         Stim.CSon.position = [Stim.CSon.center-(Stim.CSon.size/2),<span class="keyword">...</span>
0086                         Stim.CSon.center+(Stim.CSon.size/2)];
0087                     
0088         pre = repmat(Stim.CSon.position,Stim.us.pulses,1);
0089         
0090         <span class="keyword">if</span> switchAxis,
0091             otherAxis = [1 3];
0092             arrangeRings = [2 4];
0093         <span class="keyword">else</span>
0094             arrangeRings = [1 3];
0095             otherAxis = [2 4];
0096         <span class="keyword">end</span>
0097         
0098         <span class="keyword">if</span> Stim.us.pulses == 2,
0099             pre(1,arrangeRings) =  pre(1,arrangeRings)-50;
0100             pre(2,arrangeRings) =  pre(2,arrangeRings)+50;
0101             Stim.CSon.position = pre;
0102         <span class="keyword">elseif</span> Stim.us.pulses == 3,
0103             pre(1,arrangeRings) = pre(1,arrangeRings)-100;
0104             pre(2,arrangeRings) = pre(2,arrangeRings);
0105             pre(3,arrangeRings) = pre(3,arrangeRings)+100;
0106             Stim.CSon.position = pre;
0107         <span class="keyword">elseif</span> Stim.us.pulses == 4,
0108             pre(1,arrangeRings) = pre(1,arrangeRings)-60;
0109             pre(2,arrangeRings) = pre(2,arrangeRings)+60;
0110             pre(3,otherAxis)    = pre(3,otherAxis)-60;
0111             pre(4,otherAxis)    = pre(4,otherAxis)+60;
0112             Stim.CSon.position = pre;
0113         <span class="keyword">end</span>
0114             
0115         <span class="comment">%% monkey ring colors,</span>
0116         mrc = zeros(62,3);
0117         mrc(60,:) = [256 0 256];<span class="comment">% is 60</span>
0118         mrc(61,:) = [256 256 0];<span class="comment">% is 61</span>
0119         mrc(62,:) = [256 0 0]  ;<span class="comment">% is 62</span>
0120         
0121         <span class="comment">% get present guys</span>
0122         actor = eval([<span class="string">'UserInfo.setup'</span>,TaskOp.curSetup]);
0123         
0124         strings = [<span class="string">'A'</span>,<span class="string">'B'</span>];
0125         other = strings(2-strcmp(TaskOp.curSetup,<span class="string">'B'</span>));
0126         receiver = eval([<span class="string">'UserInfo.setup'</span>,other]);
0127         
0128         <span class="comment">% giving or selfish?</span>
0129         <span class="keyword">if</span> Stim.us.giving,
0130             Stim.CSon.clr = mrc(str2double(receiver),:);
0131         <span class="keyword">else</span>
0132             Stim.CSon.clr = mrc(str2double(actor),:);
0133         <span class="keyword">end</span>
0134 <span class="keyword">end</span>
0135 
0136 <span class="comment">%% TARGET ON stim DEFS</span>
0137 closeTargets=1;
0138 Stim.target.size = [100 200];
0139 Stim.target.position = zeros(1,4);
0140 <span class="keyword">if</span> closeTargets
0141     <span class="keyword">if</span> strcmp(TaskOp.curSetup,<span class="string">'B'</span>),
0142         Stim.target.center   = [Stim.target.size(1),<span class="keyword">...</span>
0143             VisParam.scr_rect(4)-Stim.CSon.center(2)];
0144         Stim.target.position([1 3]) = [0 Stim.target.size(1)]; 
0145         Stim.target.position([2 4]) = Stim.CSon.center(2) + <span class="keyword">...</span>
0146             (Stim.target.size(2)/2 *[-1 1]);
0147     <span class="keyword">else</span>
0148         <span class="keyword">if</span> switchAxis,
0149             endOfScr = VisParam.scr_rect(3);
0150             Stim.target.center = [endOfScr-(Stim.target.size(1)),<span class="keyword">...</span>
0151                 VisParam.scr_rect(4)-Stim.CSon.center(2)];
0152             Stim.target.position([1 3]) = [endOfScr-(Stim.target.size(1)) endOfScr];
0153             Stim.target.position([2 4]) = Stim.CSon.center(2) + <span class="keyword">...</span>
0154                 (Stim.target.size(2)/2 *[-1 1]);
0155         <span class="keyword">else</span>
0156             Stim.target.size = Stim.target.size([2 1]);
0157             Stim.target.center = [Stim.CSon.center(1),<span class="keyword">...</span>
0158                 VisParam.scr_rect(4)-(Stim.target.size(1)/2)];
0159             Stim.target.position([1 3]) = Stim.target.center(1)+(Stim.target.size(2)/2 *[-1 1]);
0160             Stim.target.position([2 4]) = Stim.target.center(2)+(Stim.target.size(1)/2 *[-1 1]);            
0161             Stim.target.center(2) = Stim.target.size(1)/2;
0162         <span class="keyword">end</span>
0163     <span class="keyword">end</span>
0164 <span class="keyword">end</span>
0165 Stim.target.color = [0 0 192];
0166 
0167 <span class="comment">%% Target feed back DEF</span>
0168 Stim.targetFB.color    = [0 255 0];
0169 Stim.targetFB.size     = 50; <span class="comment">% pixels wider than our target</span>
0170 Stim.targetFB.position = [Stim.target.position(1:2)-Stim.targetFB.size, <span class="keyword">...</span>
0171                           Stim.target.position(3:4)+Stim.targetFB.size];
0172 
0173 
0174 <span class="comment">%% BEHAVIOR CONTROL VARIABLES</span>
0175 Stim.pre.hand.filter_time = Timers.Event.pre_trial.StartDelay-0.6;
0176 Stim.pre.handInterrupt = 1;
0177 Stim.pre.hold = 1;
0178 Stim.pre.holdTime = .5;
0179 
0180 <span class="comment">%</span>
0181 Stim.target.tolerance_window = Stim.target.size.*[2 1.5];
0182 Stim.target.filter_time = Timers.Event.targetOn.StartDelay-0.1;
0183 
0184 <span class="comment">%</span>
0185 TaskOp.handInterrupt = 0;
0186 TaskOp.eyeInterrupt  = 0;
0187 TaskOp.interrupt = 0;
0188 TaskOp.touchInterrupt = 0;
0189 TaskOp.hold = 0;
0190 TaskOp.holdTime = 0;
0191 
0192 TaskOp.roleChangeCorrect = 1;
0193 TaskOp.respBlackBkg = 1;
0194 TaskOp.roleChangeTrials = inf;
0195 
0196 runned = 1;</pre></div>
