<h2><a name="_source"></a>SOURCE CODE <a href="#_top"><img alt="^" border="0" src="../../up.png"></a></h2>
<div class="fragment"><pre>0001 <a name="_sub0" href="#_subfunctions" class="code">function [m]=DrawValuebarFunction(group,solenoid)</a>
0002 
0003 <span class="keyword">global</span> Stim VisParam <span class="comment">%Tbl ModigDir</span>
0004 
0005 <span class="comment">%max=234; %ms this needs to be done better in the future,</span>
0006 <span class="comment">%for now the number that needs to go in here is the opening time that</span>
0007 <span class="comment">%corresponds to .8 ml... it should be learned from the daily calibration</span>
0008 
0009 <span class="comment">%in the future please program a a menu for this</span>
0010 
0011 <span class="comment">% [i,j,k]=size(m);</span>
0012 
0013 bg=VisParam.bg(1);
0014 
0015 m=repmat(bg,[800 800 3]);
0016 
0017 <span class="comment">%This piece of code is used to draw separate valuebars for primary and</span>
0018 <span class="comment">%alternate groups... which is what I use for my choice task.   Also, the</span>
0019 <span class="comment">%'max' you see below is the opening time in milliseconds which corresponds</span>
0020 <span class="comment">%to 1 ml of juice being delivered, this is the highest point on the scale.</span>
0021 <span class="comment">%This is obviously specific to a given solenoid, so you need to calibrate</span>
0022 <span class="comment">%yours and put it in there.  I have two solenoids, so there is why there</span>
0023 <span class="comment">%are two</span>
0024 <span class="keyword">switch</span>(group)
0025     <span class="keyword">case</span>(<span class="string">'prime'</span>)
0026         <span class="keyword">switch</span>(solenoid)
0027             <span class="keyword">case</span>(1)
0028                 max=332;
0029             <span class="keyword">case</span>(2)
0030                 max=286;
0031         <span class="keyword">end</span>
0032         level=Stim.cs.CurTrial.image.rwd_mag/Stim.cs.CurTrial.image.rwd_num;
0033         levelp=(max-level)/max;
0034         barcolor=Stim.cs.CurTrial.image.color.rgb;
0035         position=Stim.cs.CurTrial.position_selection;
0036         
0037     <span class="keyword">case</span>(<span class="string">'alt'</span>)
0038         <span class="keyword">switch</span>(solenoid)
0039             <span class="keyword">case</span>(1)
0040                 max=332;
0041             <span class="keyword">case</span>(2)
0042                 max=286;
0043         <span class="keyword">end</span>
0044         level=Stim.cs_alt.CurTrial.image.rwd_mag/Stim.cs_alt.CurTrial.image.rwd_num;
0045         levelp=(max-level)/max;
0046         barcolor=Stim.cs_alt.CurTrial.image.color.rgb;
0047         position=Stim.cs_alt.CurTrial.position_selection;
0048 <span class="keyword">end</span>
0049         
0050 <span class="comment">%OK--writing this note months after I initially wrote the code...</span>
0051 <span class="comment">%this looks like a mistake, that the level I am coding (levelp) is actually</span>
0052 <span class="comment">%the inverse of what it shoud be, and I think it is but I also think the</span>
0053 <span class="comment">%picture is displayed upside down, and that this was a hack I implemented.</span>
0054 <span class="comment">%Need to come back and verify....</span>
0055 
0056 level=round(800*levelp);
0057 <span class="comment">%m = zeros(1000,1000,3);</span>
0058 <span class="keyword">if</span> level &lt; 11
0059     bar=1:11;
0060 <span class="keyword">elseif</span> level == 800
0061     bar = 789:800;
0062 <span class="keyword">else</span>
0063     bar=level-5:level+5;
0064 <span class="keyword">end</span>
0065 
0066 <span class="keyword">if</span> position==2
0067     position=randsample([1,5],1);
0068 <span class="keyword">end</span>
0069     
0070 
0071 <span class="comment">%The switch here is implemented so that the value bars image is reflected</span>
0072 <span class="comment">%on either side of the FP, not just shifted</span>
0073 
0074 <span class="keyword">switch</span>(position)
0075     <span class="keyword">case</span>(5)
0076         m(1:10,500:800,1)=barcolor(1);
0077         m(90:100,600:800,1)=barcolor(1);
0078         m(190:200,600:800,1)=barcolor(1);
0079         m(290:300,600:800,1)=barcolor(1);
0080         m(390:400,500:800,1)=barcolor(1);
0081         m(490:500,600:800,1)=barcolor(1);
0082         m(590:600,600:800,1)=barcolor(1);
0083         m(690:700,600:800,1)=barcolor(1);
0084         m(790:800,500:800,1)=barcolor(1);
0085         m(:,1:20,1)=barcolor(1);
0086         m(:,780:800,1)=barcolor(1);
0087 
0088         m(1:10,500:800,2)=barcolor(2);
0089         m(90:100,600:800,2)=barcolor(2);
0090         m(190:200,600:800,2)=barcolor(2);
0091         m(290:300,600:800,2)=barcolor(2);
0092         m(390:400,500:800,2)=barcolor(2);
0093         m(490:500,600:800,2)=barcolor(2);
0094         m(590:600,600:800,2)=barcolor(2);
0095         m(690:700,600:800,2)=barcolor(2);
0096         m(790:800,500:800,2)=barcolor(2);
0097         m(:,1:20,2)=barcolor(2);
0098         m(:,780:800,2)=barcolor(2);
0099 
0100         m(1:10,500:800,3)=barcolor(3);
0101         m(90:100,600:800,3)=barcolor(3);
0102         m(190:200,600:800,3)=barcolor(3);
0103         m(290:300,600:800,3)=barcolor(3);
0104         m(390:400,500:800,3)=barcolor(3);
0105         m(490:500,600:800,3)=barcolor(3);
0106         m(590:600,600:800,3)=barcolor(3);
0107         m(690:700,600:800,3)=barcolor(3);
0108         m(790:800,500:800,3)=barcolor(3);
0109         m(:,1:20,3)=barcolor(3);
0110         m(:,780:800,3)=barcolor(3);
0111 
0112     <span class="keyword">case</span>(1)
0113         m(1:10,1:300,1)=barcolor(1);
0114         m(90:100,1:200,1)=barcolor(1);
0115         m(190:200,1:200,1)=barcolor(1);
0116         m(290:300,1:200,1)=barcolor(1);
0117         m(390:400,1:300,1)=barcolor(1);
0118         m(490:500,1:200,1)=barcolor(1);
0119         m(590:600,1:200,1)=barcolor(1);
0120         m(690:700,1:200,1)=barcolor(1);
0121         m(790:800,1:300,1)=barcolor(1);
0122         m(:,1:20,1)=barcolor(1);
0123         m(:,780:800,1)=barcolor(1);
0124 
0125         m(1:10,1:300,2)=barcolor(2);
0126         m(90:100,1:200,2)=barcolor(2);
0127         m(190:200,1:200,2)=barcolor(2);
0128         m(290:300,1:200,2)=barcolor(2);
0129         m(390:400,1:300,2)=barcolor(2);
0130         m(490:500,1:200,2)=barcolor(2);
0131         m(590:600,1:200,2)=barcolor(2);
0132         m(690:700,1:200,2)=barcolor(2);
0133         m(790:800,1:300,2)=barcolor(2);
0134         m(:,1:20,2)=barcolor(2);
0135         m(:,780:800,2)=barcolor(2);
0136 
0137         m(1:10,1:300,3)=barcolor(3);
0138         m(90:100,1:200,3)=barcolor(3);
0139         m(190:200,1:200,3)=barcolor(3);
0140         m(290:300,1:200,3)=barcolor(3);
0141         m(390:400,1:300,3)=barcolor(3);
0142         m(490:500,1:200,3)=barcolor(3);
0143         m(590:600,1:200,3)=barcolor(3);
0144         m(690:700,1:200,3)=barcolor(3);
0145         m(790:800,1:300,3)=barcolor(3);
0146         m(:,1:20,3)=barcolor(3);
0147         m(:,780:800,3)=barcolor(3);
0148 
0149         
0150 <span class="keyword">end</span>
0151 
0152 
0153 m(bar,21:779,1) = barcolor(1);
0154 m(bar,21:779,2) = barcolor(2);
0155 m(bar,21:779,3) = barcolor(3);
0156 
0157 m=uint8(m);</pre></div>
