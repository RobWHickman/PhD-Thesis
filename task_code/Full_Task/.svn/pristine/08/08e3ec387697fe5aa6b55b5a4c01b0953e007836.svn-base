0345     set(MENUs.ModigMainMenu.handles.MENU_EnableHandshake,<span class="keyword">...</span>
0346         <span class="string">'enable'</span>,<span class="string">'on'</span>,<span class="string">'checked'</span>,<span class="string">'on'</span>)
0347     set(MENUs.ModigMainMenu.handles.MENU_ModigBitMonitor,<span class="string">'enable'</span>,<span class="string">'on'</span>)
0348     UserInfo.gettyHandshake = 1;
0349     UserInfo.typeOfHandshake = <span class="string">'NI'</span>;
0350 <span class="keyword">else</span>
0351     set(MENUs.ModigMainMenu.handles.MENU_EnableHandshake,<span class="keyword">...</span>
0352         <span class="string">'enable'</span>,<span class="string">'off'</span>,<span class="string">'checked'</span>,<span class="string">'off'</span>)
