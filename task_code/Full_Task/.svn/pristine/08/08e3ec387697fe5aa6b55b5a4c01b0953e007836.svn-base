0357 <span class="comment">%% Open PTB</span>
0358 <span class="keyword">try</span>
0359     Screen(<span class="string">'CloseAll'</span>);                                   <span class="comment">% close all first</span>
0360     Screen(<span class="string">'Preference'</span>, <span class="string">'SkipSyncTests'</span>,0); <span class="comment">% use 1 to skip the sync tests</span>
0361     Screen(<span class="string">'Preference'</span>, <span class="string">'VBLTimestampingMode'</span>, 2);
0362     VisParam.scr_num = max(Screen(<span class="string">'Screens'</span>));
0363     
0364     <span class="keyword">if</span> VisParam.scr_num==1,
0365         warning(<span class="string">'Modig:MoInit'</span>,<span class="keyword">...</span>
0366             <span class="string">'Modig isn''t meant to be used with one monito. Starting debug mode'</span>)      
0367         [VisParam.scr_holder, VisParam.scr_rect_holder] = Screen(<span class="string">'OpenWindow'</span>,<span class="keyword">...</span>
0368             VisParam.scr_num, 0, [0 0 200 200]);
0369     <span class="keyword">elseif</span> VisParam.scr_num==2 &amp;&amp; UserInfo.use_split==0,
0370         <span class="comment">% two monitors--&gt; % 0: dual, 1:control, 2:subject,</span>
0371         [VisParam.scr_holder, VisParam.scr_rect_holder] = Screen(<span class="string">'OpenWindow'</span>,<span class="keyword">...</span>
0372             1, 0);
0373     <span class="keyword">elseif</span> VisParam.scr_num==2 &amp;&amp; UserInfo.use_split==1,
0374         <span class="comment">% two monitors, one of which is split in two windows</span>
0375         expRect = Screen(<span class="string">'Rect'</span>,0);
0376         <span class="keyword">if</span> expRect(4)==768,
0377             <span class="comment">% experimental setup (rect values are relative to the monitor)</span>
0378             [VisParam.scr_holder(1), VisParam.scr_rect_holder(1,:)] = <span class="keyword">...</span>
0379                 Screen(<span class="string">'OpenWindow'</span>, 0,0,[512 0 1024 768]);
0380             [VisParam.scr_holder(2), VisParam.scr_rect_holder(2,:)] = Screen(<span class="string">'Openwindow'</span>,<span class="keyword">...</span>
0381                 0,0,[0 0 512 768]);
0382         <span class="keyword">else</span>
0383             <span class="comment">% open in laptop screen</span>
0384             fprintf(<span class="string">'Move all GUIs to LCD monitor...\n'</span>)
0385             keyboard
0386             
0387             <span class="comment">% laptop debug setup</span>
0388             scrRects(1,:) = Screen(<span class="string">'Rect'</span>,1);
0389             scrRects(2,:) = Screen(<span class="string">'Rect'</span>,2);
0390             
0391             <span class="comment">% Open both screens on Screen 1</span>
0392 <span class="comment">%             middle = scrRects(1,1)+((scrRects(1,3)-scrRects(1,1))/2);</span>
0393 <span class="comment">%             [VisParam.scr_holder(1), VisParam.scr_rect_holder(1,:)] = ...</span>
0394 <span class="comment">%                 Screen('OpenWindow',0,0,[middle,scrRects(1,2:4)]);</span>
0395 <span class="comment">%             [VisParam.scr_holder(2), VisParam.scr_rect_holder(2,:)] = ...</span>
0396 <span class="comment">%                 Screen('OpenWindow',0,0,[scrRects(1,1:2),middle,scrRects(1,4)]);</span>
0397             
0398 <span class="comment">%              % Open both screens on Screen 2</span>
0399 <span class="comment">%             middle = scrRects(1,3)+(scrRects(2,3)/2);</span>
0400 <span class="comment">%             [VisParam.scr_holder(1), VisParam.scr_rect_holder(1,:)] = ...</span>
0401 <span class="comment">%                 Screen('OpenWindow', 0, 0, [scrRects(1,3) 0 middle scrRects(2,4)]);</span>
0402 <span class="comment">%             [VisParam.scr_holder(2), VisParam.scr_rect_holder(2,:)] = ...</span>
0403 <span class="comment">%                 Screen('OpenWindow', 0, 0, [scrRects(1,3)+middle 0 scrRects(1,3)+middle+scrRects(2,3) scrRects(2,4)]);</span>
0404 
0405             <span class="comment">% open both screens on monitor 1, which is the leftmost monitor</span>
0406              [VisParam.scr_holder(2), VisParam.scr_rect_holder(2,:)] = <span class="keyword">...</span>
0407                 Screen(<span class="string">'OpenWindow'</span>, 0, 0, [0 0 scrRects(1,3)/2 scrRects(1,4)]);
0408             [VisParam.scr_holder(1), VisParam.scr_rect_holder(1,:)] = <span class="keyword">...</span>
0409                 Screen(<span class="string">'OpenWindow'</span>, 0, 0, [scrRects(1,3)/2 0 scrRects(1,3) scrRects(1,4)]);
0410         <span class="keyword">end</span>
0411         TaskOp.curSetup = <span class="string">'A'</span>;
0412         
0413         
0414         <span class="comment">% warm up</span>
0415         warmUp = 300;
0416         <a href="../../Modig/library/ScreenWarmer.html" class="code" title="function ScreenWarmer(scrHdl,scrRect,warmTime)">ScreenWarmer</a>(VisParam.scr_holder(1),VisParam.scr_rect_holder(1,:),warmUp);
0417         <a href="../../Modig/library/ScreenWarmer.html" class="code" title="function ScreenWarmer(scrHdl,scrRect,warmTime)">ScreenWarmer</a>(VisParam.scr_holder(2),VisParam.scr_rect_holder(2,:),warmUp);
0418     <span class="keyword">elseif</span> VisParam.scr_num==3,
0419         <span class="comment">% create two windows, spanning each one monitor in our double setup</span>
0420         <span class="comment">% three monitors in dual mode --&gt; 0:stereo, 1:disp2, 2:disp1, 3:disp3.</span>
0421         <span class="comment">% note that either calling 0 or 1 will hang Matlab since disp2 isn't</span>
0422         <span class="comment">% controlled by the primary gfx card</span>
0423         <span class="comment">% two ELOs 1024x768</span>
0424         <span class="comment">% three monitors with dual head gfx card in span mode--&gt;  0:full</span>
0425         <span class="comment">% desktop, 1:display 2, 2: two monitors in span mode. check the rect value!</span>
0426 <span class="comment">%         [VisParam.scr_holder(1), VisParam.scr_rect_holder(1,:)]=Screen(...</span>
0427 <span class="comment">%             'OpenWindow',3, 0, [0 0 1024 768]);</span>
0428 <span class="comment">%         [VisParam.scr_holder(2), VisParam.scr_rect_holder(2,:)]=Screen(...</span>
0429 <span class="comment">%             'OpenWindow',1, 0,[1024 0 1024*2 768]);</span>
0430 <span class="comment">%         VisParam.scr_rect_holder(1,:) = Screen('Rect', 1);</span>
0431         [VisParam.scr_holder(1)  VisParam.scr_rect_holder(1,:)]=Screen(<span class="string">'OpenWindow'</span>,1, 0);
0432 <span class="comment">%         VisParam.scr_rect_holder(2,:) = Screen('Rect',3);</span>
0433         [VisParam.scr_holder(2)  VisParam.scr_rect_holder(2,:)]=Screen(<span class="string">'OpenWindow'</span>,3, 0);
0434         TaskOp.curSetup = <span class="string">'A'</span>;
0435         
0436         <a href="../../Modig/library/shiftSetupMoMaMe.html" class="code" title="function varargout = shiftSetupMoMaMe(varargin)">shiftSetupMoMaMe</a>;
0437     <span class="keyword">end</span>
0438     VisParam.scr_handle = VisParam.scr_holder(1);
0439     VisParam.scr_rect   = VisParam.scr_rect_holder(1,:);
0440     
0441     Priority(MaxPriority(VisParam.scr_handle));
0442     Screen(<span class="string">'Flip'</span>,VisParam.scr_handle);
0443     <span class="comment">% Nice picture to start with</span>
0444     <span class="keyword">if</span> exist(<span class="string">'nu_couche_dos.jpg'</span>,<span class="string">'file'</span>)
0445         pic = imread(<span class="string">'nu_couche_dos.jpg'</span>);
0446         txt_handle = Screen(<span class="string">'MakeTexture'</span>,VisParam.scr_handle,pic);
0447         Screen(<span class="string">'DrawTexture'</span>,VisParam.scr_handle,txt_handle);
0448         <span class="keyword">if</span> UserInfo.use_split==1,
0449             txt_handle2 = Screen(<span class="string">'MakeTexture'</span>,VisParam.scr_holder(2),pic);
0450             Screen(<span class="string">'DrawTexture'</span>,VisParam.scr_holder(2),txt_handle2);
0451         <span class="keyword">end</span>
0452     <span class="keyword">else</span>
0453         <span class="comment">% not found?!</span>
0454         Screen(<span class="string">'FillRect'</span>, VisParam.scr_handle, 255/2);
0455         Screen(<span class="string">'DrawText'</span>, VisParam.scr_handle, <span class="string">'couldn''t load nice pic!'</span>, 0, VisParam.scr_rect(4)/2)
0456         Screen(<span class="string">'Flip'</span>,VisParam.scr_handle);
0457     <span class="keyword">end</span>
0458     
0459     <span class="comment">% Initalize audio</span>
0460     InitializePsychSound;
0461     <span class="comment">% Open the default audio device [], with default mode [] (==Only playback),</span>
0462     <span class="comment">% and a required latencyclass of zero 0 == no low-latency mode, as well as</span>
0463     <span class="comment">% a frequency of freq and nrchannels sound channels.</span>
0464     <span class="comment">% This returns a handle to the audio device:</span>
0465     <span class="keyword">try</span>
0466         <span class="comment">% Try with the 'freq'uency we wanted:</span>
0467         AudParam.fs = 8192;
0468         AudParam.nrchannels = 1;
0469         AudParam.pahandle = PsychPortAudio(<span class="string">'Open'</span>, [], [], 0, AudParam.fs, AudParam.nrchannels);
0470     <span class="keyword">catch</span>
0471         <span class="comment">% Failed. Retry with default frequency as suggested by device:</span>
0472         fprintf(<span class="string">'\nCould not open device at wanted playback frequency of %i Hz. Will retry with device default frequency.\n'</span>, freq);
0473         fprintf(<span class="string">'Sound may sound a bit out of tune, ...\n\n'</span>);
0474 
0475         psychlasterror(<span class="string">'reset'</span>);
0476         AudParam.pahandle = PsychPortAudio(<span class="string">'Open'</span>, [], [], 0, [], AudParam.nrchannels);
0477     <span class="keyword">end</span>
0478 <span class="keyword">catch</span>
0479       <span class="comment">% We fucked it up, and we want control back!</span>
0480     Priority(0);
0481     Screen(<span class="string">'CloseAll'</span>);
0482     <a href="Modig.html" class="code" title="function Modig(varargin)">Modig</a> exit
0483     <span class="comment">% Restore preferences</span>
0484 <span class="comment">%     Screen('Preference', 'VisualDebugLevel', oldVisualDebugLevel);</span>
0485 <span class="comment">%     Screen('Preference', 'SuppressAllWarnings', oldSupressAllWarnings);</span>
0486     psychrethrow(psychlasterror);
0487 <span class="comment">%     rethrow(lasterror)</span>
0488 
0489     <span class="keyword">return</span>
0490 <span class="keyword">end</span>
