function varargout = ModigInputMenu(varargin)
% MODIGINPUTMENU M-file for ModigInputMenu.fig
%
% this GUI updates the values assigned to the global IO.Input

% SK wrote it
% RBM 05.07 introduced emulation and actual sampling from sensor and 
%           sampling rate capabilites to the option 'hand'. Changed
%           behavior upon pressing CANCEL
%       5.08 changed fig-file and made changes accordingly in the m-file

gui_Singleton = 1;
gui_State = struct('gui_Name',       mfilename, ...
    'gui_Singleton',  gui_Singleton, ...
    'gui_OpeningFcn', @ModigInputMenu_OpeningFcn, ...
    'gui_OutputFcn',  @ModigInputMenu_OutputFcn, ...
    'gui_LayoutFcn',  [] , ...
    'gui_Callback',   []);
if nargin && ischar(varargin{1})
    gui_State.gui_Callback = str2func(varargin{1});
end

if nargout
    [varargout{1:nargout}] = gui_mainfcn(gui_State, varargin{:});
else
    gui_mainfcn(gui_State, varargin{:});
end
% End initialization code - DO NOT EDIT


%% opening function
function ModigInputMenu_OpeningFcn(hObject, eventdata, handles, varargin)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Read in the previous state of the IO global and present it in the GUI
handles.output = hObject;
guidata(hObject, handles);
global IO UserInfo

% Touch Screen 
set(handles.checkbox_tchScr, 'Value', UserInfo.use_touch_screen)

% EYE condition
set(handles.activateEye, 'Value', IO.Input.eye.monitor)

if IO.Input.eye.monitor,
    set(handles.POP_EYE,'enable','on')
    popAlt = get(handles.POP_EYE, 'String');
    popSel = find(strcmp(IO.Input.eye.tracking_method, popAlt) == 1);
    set(handles.POP_EYE, 'Value', popSel);
else
    set(handles.POP_EYE,'enable','off')
end

% HAND condition % 0 == off, 1 == on
set(handles.activateHand, 'Value', IO.Input.hand.monitor ); 

if IO.Input.hand.monitor,
    set(handles.POP_HAND,'enable','on')
    popAlt = get(handles.POP_HAND, 'String');
    popSel = find(strcmp(IO.Input.hand.tracking_method, popAlt) == 1);
    set(handles.POP_HAND, 'Value', popSel);
else
    set(handles.POP_HAND,'enable','off')
end

% TONGUE condition
set(handles.activateLick, 'Enable', 'Off')
% set(handles.activateLick, 'Value', IO.Input.tongue.monitor)

[THr RATE EMPTY] = isfield_sk(IO,'Input.behavior.sampling_rate');

if ~EMPTY
    set(handles.EDIT_SAMPLING_RATE,'String',num2str(RATE));
end

% Update handles structure
guidata(hObject, handles);
%
if ~isfield(IO.Input.behavior,'sample')
    % if there's nothing to sample, activate "do not sample"
    myhdl = [handles.activateEye, handles.activateHand, handles.checkbox_tchScr];
    IO.Input.behavior.sample = any(cell2mat(get(myhdl, 'value')));
end
set(handles.checkboxNoSampling, 'value', ~IO.Input.behavior.sample);    


% set initial parameters in the userdata so that initial parameters can 
% be recovered when dialog is cancelled. Note that we don't update using
% the callbacks to each element of the figure
GUI_Info = get_menu_contents(hObject);
set(hObject,'userdata',GUI_Info); 

%% output function
function varargout = ModigInputMenu_OutputFcn(hObject, eventdata, handles)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
varargout{1} = handles.output;

%% Eye-sampling drop down menu (empty)
function POP_EYE_Callback(hObject, eventdata, handles)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% buf = get_GUI_value(hObject);

%% Key rest callback
function activateHand_Callback(hObject, eventdata, handles)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
actHand = get(hObject,'Value');
if actHand,
    set(handles.POP_HAND,'enable','on')
    set(handles.checkboxNoSampling,'value',0);
    set(handles.EDIT_SAMPLING_RATE, 'enable', 'on');
else
    set(handles.POP_HAND,'enable','off')    
    % if there's nothing to sample, activate "do not sample"
    myhdl = [handles.activateEye, handles.activateHand, handles.checkbox_tchScr];
    anyAct = any(cell2mat(get(myhdl, 'value')));
    set(handles.checkboxNoSampling, 'value', ~anyAct);    

end

% Update handles structure
guidata(hObject, handles);
%% Licking sampling (empty)
function activateLick_Callback(hObject, eventdata, handles)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% buf = get_GUI_value(hObject);

%% Sampling rate 
function EDIT_SAMPLING_RATE_Callback(hObject, eventdata, handles)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

fs = str2double(get(hObject,'String')); % returns contents of hand_sample_rate as a double
if fs < 1 || fs > 200
    warndlg({'Hand Sampling Rate must be in the [1:200) Hz range' ; ...
        'Reverting to default 50 Hz sampling rate'}, 'Hand Sampling Warning')
    fs = 50;
    set(hObject, 'String', fs)
end

% Update handles structure
guidata(hObject, handles);

%% --- Executes during object creation, after setting all properties.
function hand_sample_rate_CreateFcn(hObject, eventdata, handles)
% Hint: edit controls usually have a white background on Windows.
%       See ISPC and COMPUTER.
if ispc && isequal(get(hObject,'BackgroundColor'), get(0,'defaultUicontrolBackgroundColor'))
    set(hObject,'BackgroundColor','white');
end

%% --- Executes on button press in activateEye.
function activateEye_Callback(hObject, eventdata, handles)

actEye = get(hObject,'Value');
if actEye,
    set(handles.POP_EYE,'enable','on')
    set(handles.checkboxNoSampling,'value',0);
    set(handles.EDIT_SAMPLING_RATE, 'enable', 'on');
else
    set(handles.POP_EYE,'enable','off')    
    % if there's nothing to sample, activate "do not sample"
    myhdl = [handles.activateEye, handles.activateHand, handles.checkbox_tchScr];
    anyAct = any(cell2mat(get(myhdl, 'value')));
    set(handles.checkboxNoSampling, 'value', ~anyAct);    
end

%% --- Executes on selection change in POP_HAND.
function POP_HAND_Callback(hObject, eventdata, handles)
% Hints: contents = get(hObject,'String') returns POP_HAND contents as cell array
%        contents{get(hObject,'Value')} returns selected item from POP_HAND


%% --- Executes during object creation, after setting all properties.
function POP_HAND_CreateFcn(hObject, eventdata, handles)
% Hint: popupmenu controls usually have a white background on Windows.
%       See ISPC and COMPUTER.
if ispc && isequal(get(hObject,'BackgroundColor'), get(0,'defaultUicontrolBackgroundColor'))
    set(hObject,'BackgroundColor','white');
end


%% checks if it is a character (input?)
function check_ch(hObject, eventdata, handles)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
temp = get_GUI_value(hObject);
if isempty(temp.numerical)
    set(hObject,'string','');
elseif temp.numerical<=0
     set(hObject,'string','');
end
%% submit information/pass it to IO and userInfo globals
function PUSH_SUBMIT_Callback(hObject, eventdata, handles)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
global IO UserInfo ExtDevice 
% Update IO global with the data in the current state of the GUI
GUI_Info = get_menu_contents(handles.ModigInputMenu);

% check values put on the menu one by one.

% touch screen 
UserInfo.use_touch_screen = get(handles.checkbox_tchScr, 'Value');

% eye
IO.Input.eye.monitor = get(handles.activateEye,'Value');
if IO.Input.eye.monitor
    switch cell2mat(GUI_Info.CONTENTS.POP_EYE.cur_name)
        case 'eye scan'
            if UserInfo.lab_connection
                IO.Input.eye.tracking_method = cell2mat(GUI_Info.CONTENTS.POP_EYE.cur_name);
            else
                warning('MODIG:input','lab not connected --will change eye input to mouse')
                IO.Input.eye.tracking_method = 'mouse';
            end
        case 'mouse'
            IO.Input.eye.tracking_method = cell2mat(GUI_Info.CONTENTS.POP_EYE.cur_name);
    end
end

% Hand
options   = get(handles.POP_HAND, 'String');
selection = get(handles.POP_HAND, 'Value');
IO.Input.hand.monitor = get(handles.activateHand, 'Value');
if IO.Input.hand.monitor && UserInfo.lab_connection,
    IO.Input.hand.tracking_method = options(selection);
elseif IO.Input.hand.monitor
    IO.Input.hand.tracking_method = 'key';
%     warning('MODIG:input','lab not connected -->changed hand input to KBD [left shift]')
else
    IO.Input.hand.tracking_method = [];
end
% clean IO.Input.hand
if isfield(IO.Input.hand,'sampling_rate'),
    IO.Input.hand=rmfield(IO.Input.hand,'sampling_rate');
end

% Tongue
% IO.Input.tongue.monitor = get(handles.activateLick,'Value');

% sampling rate
IO.Input.behavior.sampling_rate = str2double(get(handles.EDIT_SAMPLING_RATE,'String'));

% If we're sampling or not. //Used in ModigTaskLoop
IO.Input.behavior.sample = ~get(handles.checkboxNoSampling, 'value'); 

ModigMenuControl('ModigInputMenu','OFF');

%%
function PUSH_CANCEL_Callback(hObject, eventdata, handles)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
close(handles.ModigInputMenu) 
ModigMenuControl('ModigInputMenu','OFF');

%% --- Executes on button press in checkbox_tchScr.
function checkbox_tchScr_Callback(hObject, eventdata, handles)

tchScr = get(hObject,'Value');
if tchScr==1,
    set(handles.checkboxNoSampling,'value',0);
    set(handles.EDIT_SAMPLING_RATE, 'enable', 'on');
else
    % if there's nothing to sample, activate "do not sample"
    myhdl = [handles.activateEye, handles.activateHand, handles.checkbox_tchScr];
    anyAct = any(cell2mat(get(myhdl, 'value')));
    set(handles.checkboxNoSampling, 'value', ~anyAct);   
end

%% --- Executes on button press in checkboxNoSampling.
function checkboxNoSampling_Callback(hObject, eventdata, handles)

noSampling = get(hObject,'Value');

% If we do not sample
if noSampling,
    set(handles.activateEye,'value',~noSampling)
    set(handles.activateHand,'value',~noSampling)
    set(handles.checkbox_tchScr,'value',~noSampling)
end
o={'on','off'};
set(handles.EDIT_SAMPLING_RATE,'enable',o{noSampling+1})


% update GUI!
guidata(hObject, handles)

