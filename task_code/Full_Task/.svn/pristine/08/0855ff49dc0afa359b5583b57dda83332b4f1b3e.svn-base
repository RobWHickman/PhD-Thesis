0098                         <span class="keyword">if</span> ~Empty
0099                             fprintf(TaskOp.log.handle,<span class="string">'%s\t'</span>,num2str(block_total));
0100                         <span class="keyword">else</span>
0101                             fprintf(TaskOp.log.handle,<span class="string">'%s\t'</span>);
0102                         <span class="keyword">end</span>
0103                     <span class="keyword">case</span> <span class="string">'time start'</span>
0104                         [TH block_total Empty] = <a href="../../Modig/library/isfield_sk.html" class="code" title="function [TF,value empty] = isfield_sk(stem, fullname)">isfield_sk</a>(TaskOp,<span class="string">'count.block_total'</span>);
0105                         <span class="keyword">if</span> ~Empty
0106                             fprintf(TaskOp.log.handle,<span class="string">'%s\t'</span>,datestr(TaskOp.EvntHist.cur_trial_start_time,<span class="string">'HH:MM:SS'</span>));
0107                         <span class="keyword">else</span>
0108                             fprintf(TaskOp.log.handle,<span class="string">'%s\t'</span>);
0109                         <span class="keyword">end</span>
0110                     <span class="keyword">case</span> <span class="string">'shuffle'</span>
0111                         [TH shuffle Empty] = <a href="../../Modig/library/isfield_sk.html" class="code" title="function [TF,value empty] = isfield_sk(stem, fullname)">isfield_sk</a>(TaskOp,<span class="string">'Trial.just_shuffled'</span>);
0112                         <span class="keyword">if</span> ~Empty
0113                             fprintf(TaskOp.log.handle,<span class="string">'%s\t'</span>,num2str(shuffle));
0114                         <span class="keyword">else</span>
