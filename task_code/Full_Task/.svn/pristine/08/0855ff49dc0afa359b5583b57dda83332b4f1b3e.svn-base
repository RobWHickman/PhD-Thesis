<div class="fragment"><pre>0001 <a name="_sub0" href="#_subfunctions" class="code">function ModigLog(option)</a>
0002 <span class="comment">% ModigLog(option)</span>
0003 <span class="comment">%</span>
0004 <span class="comment">% A collection of subroutines to log trial conditions into a file</span>
0005 <span class="comment">% A log file is made in &quot;modig\log&quot; directry.</span>
0006 <span class="comment">% by the name of &quot;LOG-yyyy-mm-dd.xls&quot;. (tab separated text format)</span>
0007 <span class="comment">% option:</span>
0008 <span class="comment">%     open_file           : open a log file. If it does not exist, create one</span>
0009 <span class="comment">%     close_file          : close a log file</span>
0010 <span class="comment">%     print_basic_header  : print out a header for common log items</span>
0011 <span class="comment">%     print_basic_log     : print out data for common log items</span>
0012 <span class="comment">%     print_prj_header    : print out a header for project specific log items</span>
0013 <span class="comment">%     print_prj_log       : print out data for project specific log items</span>
0014 
0015 <span class="comment">% SK wrote it,</span>
0016 
0017 <span class="comment">% NOTE, check output!</span>
0018 
0019 <span class="keyword">global</span> ModigDir TaskOp UserInfo
0020 
0021 <span class="keyword">switch</span> option
0022     <span class="keyword">case</span> <span class="string">'open_file'</span>
0023         TaskOp.log.filename = strcat(<span class="string">'LOG-'</span>,datestr(now,29),<span class="string">'.xls'</span>);<span class="comment">% (ISO 8601 date format is used to name a log file)</span>
0024         TaskOp.log.fullname = strcat(ModigDir.Log,<span class="string">'/'</span>,TaskOp.log.filename);
0025         <span class="keyword">if</span> ~exist(TaskOp.log.fullname,<span class="string">'file'</span>)
0026             TaskOp.log.prj = <span class="string">''</span>;
0027         <span class="keyword">end</span>
0028         TaskOp.log.handle = fopen(TaskOp.log.fullname,<span class="string">'a'</span>);
0029     <span class="keyword">case</span> <span class="string">'close_file'</span>
0030         [TH handle Empty] = <a href="../../Modig/library/isfield_sk.html" class="code" title="function [TF,value empty] = isfield_sk(stem, fullname)">isfield_sk</a>(TaskOp,<span class="string">'log.handle'</span>);
0031         <span class="keyword">if</span> ~Empty
0032             fclose(handle);
0033             TaskOp.log.filename = [];
0034             TaskOp.log.fullname = [];
0035             TaskOp.log.handle = [];
0036         <span class="keyword">end</span>
0037     <span class="keyword">case</span> <span class="string">'print_basic_header'</span>,<span class="comment">% print basic header on a file.</span>
0038         [TF LOG_PRJ EMPTYprj] =<a href="../../Modig/library/isfield_sk.html" class="code" title="function [TF,value empty] = isfield_sk(stem, fullname)">isfield_sk</a>(TaskOp,<span class="string">'log.prj'</span>);
0039         <span class="keyword">if</span> EMPTYprj
0040            LOG_PRJ = <span class="string">' '</span>; <span class="comment">% This is the case at the very first trial</span>
0041            <span class="comment">% FIXME, struct field assignment overwrites a double</span>
0042            TaskOp.log.prj = <span class="string">' '</span>;
0043         <span class="keyword">end</span>
0044         <span class="keyword">if</span> ~strcmp(TaskOp.prj,LOG_PRJ) <span class="comment">% prj changed from the previous trial. so, print header for the new prj</span>
0045             [TH header Empty] = <a href="../../Modig/library/isfield_sk.html" class="code" title="function [TF,value empty] = isfield_sk(stem, fullname)">isfield_sk</a>(TaskOp,<span class="string">'log.basic_header'</span>);
0046             <span class="keyword">if</span> ~Empty
0047                 <a href="ModigLog.html" class="code" title="function ModigLog(option)">ModigLog</a>(<span class="string">'open_file'</span>);
0048                 fprintf(TaskOp.log.handle,<span class="string">'header\t'</span>); <span class="comment">% print 'header'</span>
0049                 <span class="keyword">for</span> hh = 1:size(header,2)
0050                     str = cell2mat(header(hh));
0051                     <span class="keyword">if</span> ischar(str)
0052                         fprintf(TaskOp.log.handle,<span class="string">'%s\t'</span>,str);
0053                     <span class="keyword">else</span>
0054                         fprintf(TaskOp.log.handle,<span class="string">'%s\t'</span>);
0055                     <span class="keyword">end</span>
0056                 <span class="keyword">end</span>
0057                 <a href="ModigLog.html" class="code" title="function ModigLog(option)">ModigLog</a>(<span class="string">'close_file'</span>);
0058             <span class="keyword">end</span>
0059         <span class="keyword">end</span>
0060     <span class="keyword">case</span> <span class="string">'print_basic_log'</span>,
0061         [TH header Empty] = <a href="../../Modig/library/isfield_sk.html" class="code" title="function [TF,value empty] = isfield_sk(stem, fullname)">isfield_sk</a>(TaskOp,<span class="string">'log.basic_header'</span>);
0062         <span class="keyword">if</span> ~Empty
0063             <a href="ModigLog.html" class="code" title="function ModigLog(option)">ModigLog</a>(<span class="string">'open_file'</span>);
0064             fprintf(TaskOp.log.handle,<span class="string">'data\t'</span>); <span class="comment">% print 'data'</span>
0065             <span class="keyword">for</span> hh = 1:size(header,2)
0066                 str = cell2mat(header(hh));
0067                 <span class="keyword">switch</span> str
