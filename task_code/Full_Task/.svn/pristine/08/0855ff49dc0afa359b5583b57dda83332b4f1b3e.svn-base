0091                         <span class="keyword">if</span> ~Empty
0092                             fprintf(TaskOp.log.handle,<span class="string">'%s\t'</span>,num2str(day_total));
0093                         <span class="keyword">else</span>
0094                             fprintf(TaskOp.log.handle,<span class="string">'%s\t'</span>);
0095                         <span class="keyword">end</span>
