0113                     SetMouse(2048,0);
0114                 <span class="keyword">end</span>
0115                 
0116                 <span class="keyword">if</span> isfield(TaskOp.count,<span class="string">'repChoLimit'</span>) &amp;&amp; <span class="keyword">...</span>
