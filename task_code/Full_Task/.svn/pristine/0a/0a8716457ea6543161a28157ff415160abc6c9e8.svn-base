0128                     VisParam.page(5).draw = VisParam.page(4+TaskOp.choice).draw;
0129                     chosen = VisParam.exp_page(3+TaskOp.choice).obj_handle;
0130                     notchosen = VisParam.exp_page(6-TaskOp.choice).obj_handle;
0131                     VisParam.exp_page(4).obj_handle = chosen;
0132                     VisParam.exp_page(5).obj_handle = notchosen;
0133 
0134                     <span class="comment">% depending on US order, select delayed CS</span>
0135                     <span class="keyword">if</span> Stim.pre_trial.normalUsOrder 
0136                         VisParam.page(7).draw = VisParam.page(6+TaskOp.choice).draw;
0137                         future    = VisParam.exp_page(5+TaskOp.choice).obj_handle;
0138                         nonfuture    = VisParam.exp_page(8-TaskOp.choice).obj_handle;
0139                     <span class="keyword">else</span>
0140                         VisParam.page(7).draw = VisParam.page(8+TaskOp.choice).draw;
0141                         future    = VisParam.exp_page(7+TaskOp.choice).obj_handle;
0142                         nonfuture    = VisParam.exp_page(10-TaskOp.choice).obj_handle;
0143                     <span class="keyword">end</span>                                       
0144                    
0145                     VisParam.exp_page(6).obj_handle = future;
0146                     VisParam.exp_page(7).obj_handle = nonfuture;
0147 
0148                     <span class="comment">% arm juice delivery</span>
0149                     selfPulses = Stim.us.pulses(2,TaskOp.choice);
0150                     otherPulses = Stim.us.pulses(1,TaskOp.choice);
0151                     ipd = num2str(Stim.us.interPulseDelay);
0152 
0153                     <span class="keyword">switch</span> Stim.choApp.type
0154                         <span class="keyword">case</span> {<span class="string">'valueBar'</span>}
0155                             targetInMl_self = Stim.us.pulses(2,TaskOp.choice);
0156                             targetInMl_other = Stim.us.pulses(1,TaskOp.choice);
0157                             selfPulses = selfPulses&gt;0;
0158                             otherPulses = otherPulses&gt;0;
0159                         <span class="keyword">otherwise</span>
0160                             targetInMl_self = Stim.us.target;
0161                             targetInMl_other = Stim.us.target;
0162                     <span class="keyword">end</span>
0163                     <a href="../../../../Modig/library/calibrateJuiceDelivery.html" class="code" title="function [jCurTime, fullUStime] = calibrateJuiceDelivery(targetEpoch,targetInMl,interPulseDelay,pulses)">calibrateJuiceDelivery</a>(<span class="string">'us'</span>,targetInMl_self,ipd,selfPulses);
0164                     <a href="../../../../Modig/library/calibrateJuiceDelivery.html" class="code" title="function [jCurTime, fullUStime] = calibrateJuiceDelivery(targetEpoch,targetInMl,interPulseDelay,pulses)">calibrateJuiceDelivery</a>(<span class="string">'otherUS'</span>,targetInMl_other,ipd,otherPulses);
0165 
0166                     param.next_id = 6;
0167                     TaskOp.repeatError = 0;
0168                     
0169                     <span class="comment">% send bits up depending on choice</span>
0170                     <span class="keyword">if</span> TaskOp.choice == 1,
0171                         param.on_bit = Tbl.Bit.LeftChosenFB.bit_asignment;
0172                     <span class="keyword">elseif</span> TaskOp.choice == 2,
0173                         param.on_bit = Tbl.Bit.RightChosenFB.bit_asignment;
0174                     <span class="keyword">end</span>
0175                     param.on_bit = [param.on_bit; Tbl.Bit.Correct.bit_asignment];
0176                     param.off_bit = Tbl.Bit.Targets.bit_asignment;
0177                 <span class="keyword">else</span>
0178                     TaskOp.count.noTouch =     TaskOp.count.noTouch+1;
0179                     param.next_id = 12;
0180                 <span class="keyword">end</span>      
0181         
0182             <span class="keyword">case</span> 6 <span class="comment">% choice acq/juice delay</span>
