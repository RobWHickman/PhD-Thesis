0184                 
0185                 <span class="keyword">if</span> Stim.pre_trial.normalUsOrder,
0186                     param.next_id = 7;
0187                     param.off_bit = [param.off_bit; Tbl.Bit.ownCSs.bit_asignment];
0188                 <span class="keyword">else</span>
0189                     param.next_id = 9;
0190                     param.off_bit = [param.off_bit; Tbl.Bit.otherCSs.bit_asignment];
0191                 <span class="keyword">end</span>
0192             <span class="keyword">case</span> 7 <span class="comment">% us</span>
0193                 <span class="keyword">if</span> Stim.pre_trial.normalUsOrder,
0194                     param.next_id = 8;
0195                     <span class="keyword">if</span> TaskOp.choice == 1,
0196                         param.off_bit = Tbl.Bit.LeftChosenFB.bit_asignment;
0197                     <span class="keyword">else</span>
0198                         param.off_bit = Tbl.Bit.RightChosenFB.bit_asignment;
0199                     <span class="keyword">end</span>
0200                 <span class="keyword">else</span>
0201                     param.next_id = 10;
0202                 <span class="keyword">end</span>
0203                
0204             <span class="keyword">case</span> 8 <span class="comment">% next us delay</span>
0205                 <span class="keyword">if</span> Stim.pre_trial.normalUsOrder,
0206                     param.next_id = 9;
0207                     param.off_bit = Tbl.Bit.otherCSs.bit_asignment;
0208                 <span class="keyword">else</span>
0209                     param.next_id = 7;
0210                     param.off_bit = Tbl.Bit.ownCSs.bit_asignment;
0211                 <span class="keyword">end</span>
0212                 
0213             <span class="keyword">case</span> 9 <span class="comment">% other us</span>
0214                 
0215                 <span class="keyword">if</span> Stim.pre_trial.normalUsOrder,
0216                     param.next_id = 10;
0217                 <span class="keyword">else</span>
0218                     param.next_id = 8;
0219                     
0220                     <span class="keyword">if</span> TaskOp.choice == 1,
0221                         param.off_bit = Tbl.Bit.LeftChosenFB.bit_asignment;
0222                     <span class="keyword">else</span>
0223                         param.off_bit = Tbl.Bit.RightChosenFB.bit_asignment;
0224                     <span class="keyword">end</span>
0225                 <span class="keyword">end</span>
0226             <span class="keyword">case</span> 10 <span class="comment">% post_trial</span>
0227                 param.next_id = 11;                   
0228                 param.off_bit = bt;
0229                 
0230             <span class="keyword">case</span> 11 <span class="comment">% iti</span>
0231                 <span class="comment">% reset some holders</span>
0232                 TaskOp.touchInterrupt = 0;
0233                 TaskOp.choice = 0;
0234                 
0235                 param.next_id = 1;
0236                 param.on_bit = Tbl.Bit.PreTrial.bit_asignment;
0237                 param.off_bit = bt;
0238             <span class="keyword">case</span> 12 <span class="comment">% error</span>
0239                 param.next_id = 11;
0240                 TaskOp.repeatError = 1;
0241                 TaskOp.correct = 0;
0242 
0243                 param.off_bit = bt;
0244         <span class="keyword">end</span>
0245     <span class="keyword">case</span> 2 <span class="comment">% called by behavior during an error</span>
0246         <span class="keyword">switch</span> param.prev_id
0247             <span class="keyword">case</span> 1
0248                TaskOp.ignored = 1;
0249             <span class="keyword">case</span> {2,3,4}
0250                TaskOp.count.earlyRelease = TaskOp.count.earlyRelease+1;               
0251             <span class="keyword">case</span> 5
0252                TaskOp.count.noTouch = TaskOp.count.noTouch+1;
0253             <span class="keyword">otherwise</span>
0254                fprintf(<span class="string">'Error @ %d\n'</span>,param.prev_id)
0255         <span class="keyword">end</span>
0256         param.next_id = 12;
0257         
0258         <span class="comment">% set all bits down</span>
0259        param.off_bit = bt; 
0260 <span class="keyword">end</span>
0261 <span class="comment">% Recover timer and event names from global Tbl</span>
0262 param.prev_event_name = cell2mat(Tbl.TaskTbl(param.prev_id,Tbl.TaskTblColumnID.evnt_name));
0263 param.prev_timer      = Timers.Event.(param.prev_event_name);
0264 
0265 param.next_event_name = cell2mat(Tbl.TaskTbl(param.next_id,Tbl.TaskTblColumnID.evnt_name));
0266 param.next_timer      = Timers.Event.(param.next_event_name);
0267 param.next_page       = cell2mat(Tbl.TaskTbl(param.next_id, Tbl.TaskTblColumnID.vis_page));
0268 param.ok = 1;</pre></div>
