0180 
0181 <span class="comment">%% checks if it is a character (input?)</span>
0182 <a name="_sub11" href="#_subfunctions" class="code">function check_ch(hObject, eventdata, handles)</a>
0183 <span class="comment">%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%</span>
0184 temp = <a href="../../Modig/library/get_GUI_value.html" class="code" title="function x=get_GUI_value(h)">get_GUI_value</a>(hObject);
0185 <span class="keyword">if</span> isempty(temp.numerical)
0186     set(hObject,<span class="string">'string'</span>,<span class="string">''</span>);
0187 <span class="keyword">elseif</span> temp.numerical&lt;=0
0188      set(hObject,<span class="string">'string'</span>,<span class="string">''</span>);
0189 <span class="keyword">end</span>
0190 <span class="comment">%% submit information/pass it to IO and userInfo globals</span>
0191 <a name="_sub12" href="#_subfunctions" class="code">function PUSH_SUBMIT_Callback(hObject, eventdata, handles)</a>
0192 <span class="comment">%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%</span>
0193 <span class="keyword">global</span> IO UserInfo ExtDevice 
0194 <span class="comment">% Update IO global with the data in the current state of the GUI</span>
0195 GUI_Info = <a href="../../Modig/library/get_menu_contents.html" class="code" title="function GUI_Info = get_menu_contents(h)">get_menu_contents</a>(handles.ModigInputMenu);
0196 
0197 <span class="comment">% check values put on the menu one by one.</span>
0198 
0199 <span class="comment">% touch screen</span>
0200 UserInfo.use_touch_screen = get(handles.checkbox_tchScr, <span class="string">'Value'</span>);
0201 
0202 <span class="comment">% eye</span>
0203 IO.Input.eye.monitor = get(handles.activateEye,<span class="string">'Value'</span>);
0204 <span class="keyword">if</span> IO.Input.eye.monitor
0205     <span class="keyword">switch</span> cell2mat(GUI_Info.CONTENTS.POP_EYE.cur_name)
0206         <span class="keyword">case</span> <span class="string">'eye scan'</span>
0207             <span class="keyword">if</span> UserInfo.lab_connection
0208                 IO.Input.eye.tracking_method = cell2mat(GUI_Info.CONTENTS.POP_EYE.cur_name);
0209             <span class="keyword">else</span>
0210                 warning(<span class="string">'MODIG:input'</span>,<span class="string">'lab not connected --will change eye input to mouse'</span>)
0211                 IO.Input.eye.tracking_method = <span class="string">'mouse'</span>;
0212             <span class="keyword">end</span>
0213         <span class="keyword">case</span> <span class="string">'mouse'</span>
0214             IO.Input.eye.tracking_method = cell2mat(GUI_Info.CONTENTS.POP_EYE.cur_name);
0215     <span class="keyword">end</span>
0216 <span class="keyword">end</span>
0217 
0218 <span class="comment">% Hand</span>
0219 options   = get(handles.POP_HAND, <span class="string">'String'</span>);
0220 selection = get(handles.POP_HAND, <span class="string">'Value'</span>);
0221 IO.Input.hand.monitor = get(handles.activateHand, <span class="string">'Value'</span>);
0222 <span class="keyword">if</span> IO.Input.hand.monitor &amp;&amp; UserInfo.lab_connection,
0223     IO.Input.hand.tracking_method = options(selection);
0224 <span class="keyword">elseif</span> IO.Input.hand.monitor
0225     IO.Input.hand.tracking_method = <span class="string">'key'</span>;
0226 <span class="comment">%     warning('MODIG:input','lab not connected --&gt;changed hand input to KBD [left shift]')</span>
0227 <span class="keyword">else</span>
0228     IO.Input.hand.tracking_method = [];
0229 <span class="keyword">end</span>
0230 <span class="comment">% clean IO.Input.hand</span>
0231 <span class="keyword">if</span> isfield(IO.Input.hand,<span class="string">'sampling_rate'</span>),
0232     IO.Input.hand=rmfield(IO.Input.hand,<span class="string">'sampling_rate'</span>);
0233 <span class="keyword">end</span>
0234 
0235 <span class="comment">% Tongue</span>
0236 <span class="comment">% IO.Input.tongue.monitor = get(handles.activateLick,'Value');</span>
0237 
0238 <span class="comment">% sampling rate</span>
0239 IO.Input.behavior.sampling_rate = str2double(get(handles.EDIT_SAMPLING_RATE,<span class="string">'String'</span>));
0240 
0241 <span class="comment">% If we're sampling or not. //Used in ModigTaskLoop</span>
0242 IO.Input.behavior.sample = ~get(handles.checkboxNoSampling, <span class="string">'value'</span>); 
0243 
0244 <a href="ModigMenuControl.html" class="code" title="function reply = ModigMenuControl(gui_name,option)">ModigMenuControl</a>(<span class="string">'ModigInputMenu'</span>,<span class="string">'OFF'</span>);
0245 
0246 <span class="comment">%%</span>
0247 <a name="_sub13" href="#_subfunctions" class="code">function PUSH_CANCEL_Callback(hObject, eventdata, handles)</a>
0248 <span class="comment">%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%</span>
0249 close(handles.ModigInputMenu) 
0250 <a href="ModigMenuControl.html" class="code" title="function reply = ModigMenuControl(gui_name,option)">ModigMenuControl</a>(<span class="string">'ModigInputMenu'</span>,<span class="string">'OFF'</span>);
0251 
0252 <span class="comment">%% --- Executes on button press in checkbox_tchScr.</span>
0253 <a name="_sub14" href="#_subfunctions" class="code">function checkbox_tchScr_Callback(hObject, eventdata, handles)</a>
0254 
0255 tchScr = get(hObject,<span class="string">'Value'</span>);
0256 <span class="keyword">if</span> tchScr==1,
0257     set(handles.checkboxNoSampling,<span class="string">'value'</span>,0);
0258     set(handles.EDIT_SAMPLING_RATE, <span class="string">'enable'</span>, <span class="string">'on'</span>);
0259 <span class="keyword">else</span>
0260     <span class="comment">% if there's nothing to sample, activate &quot;do not sample&quot;</span>
0261     myhdl = [handles.activateEye, handles.activateHand, handles.checkbox_tchScr];
0262     anyAct = any(cell2mat(get(myhdl, <span class="string">'value'</span>)));
0263     set(handles.checkboxNoSampling, <span class="string">'value'</span>, ~anyAct);   
0264 <span class="keyword">end</span>
0265 
0266 <span class="comment">%% --- Executes on button press in checkboxNoSampling.</span>
0267 <a name="_sub15" href="#_subfunctions" class="code">function checkboxNoSampling_Callback(hObject, eventdata, handles)</a>
0268 
0269 noSampling = get(hObject,<span class="string">'Value'</span>);
0270 
0271 <span class="comment">% If we do not sample</span>
0272 <span class="keyword">if</span> noSampling,
0273     set(handles.activateEye,<span class="string">'value'</span>,~noSampling)
0274     set(handles.activateHand,<span class="string">'value'</span>,~noSampling)
0275     set(handles.checkbox_tchScr,<span class="string">'value'</span>,~noSampling)
0276 <span class="keyword">end</span>
0277 o={<span class="string">'on'</span>,<span class="string">'off'</span>};
0278 set(handles.EDIT_SAMPLING_RATE,<span class="string">'enable'</span>,o{noSampling+1})
0279 
0280 
0281 <span class="comment">% update GUI!</span>
0282 guidata(hObject, handles)
