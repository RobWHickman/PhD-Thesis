<h2><a name="_source"></a>SOURCE CODE <a href="#_top"><img alt="^" border="0" src="../../up.png"></a></h2>
<div class="fragment"><pre>0001 <a name="_sub0" href="#_subfunctions" class="code">function varargout = ModigInputMenu(varargin)</a>
0002 <span class="comment">% MODIGINPUTMENU M-file for ModigInputMenu.fig</span>
0003 <span class="comment">%</span>
0004 <span class="comment">% this GUI updates the values assigned to the global IO.Input</span>
0005 
0006 <span class="comment">% SK wrote it</span>
0007 <span class="comment">% RBM 05.07 introduced emulation and actual sampling from sensor and</span>
0008 <span class="comment">%           sampling rate capabilites to the option 'hand'. Changed</span>
0009 <span class="comment">%           behavior upon pressing CANCEL</span>
0010 <span class="comment">%       5.08 changed fig-file and made changes accordingly in the m-file</span>
0011 
0012 gui_Singleton = 1;
0013 gui_State = struct(<span class="string">'gui_Name'</span>,       mfilename, <span class="keyword">...</span>
0014     <span class="string">'gui_Singleton'</span>,  gui_Singleton, <span class="keyword">...</span>
0015     <span class="string">'gui_OpeningFcn'</span>, @<a href="#_sub1" class="code" title="subfunction ModigInputMenu_OpeningFcn(hObject, eventdata, handles, varargin)">ModigInputMenu_OpeningFcn</a>, <span class="keyword">...</span>
0016     <span class="string">'gui_OutputFcn'</span>,  @<a href="#_sub2" class="code" title="subfunction varargout = ModigInputMenu_OutputFcn(hObject, eventdata, handles)">ModigInputMenu_OutputFcn</a>, <span class="keyword">...</span>
0017     <span class="string">'gui_LayoutFcn'</span>,  [] , <span class="keyword">...</span>
0018     <span class="string">'gui_Callback'</span>,   []);
0019 <span class="keyword">if</span> nargin &amp;&amp; ischar(varargin{1})
0020     gui_State.gui_Callback = str2func(varargin{1});
0021 <span class="keyword">end</span>
0022 
0023 <span class="keyword">if</span> nargout
0024     [varargout{1:nargout}] = gui_mainfcn(gui_State, varargin{:});
0025 <span class="keyword">else</span>
0026     gui_mainfcn(gui_State, varargin{:});
0027 <span class="keyword">end</span>
0028 <span class="comment">% End initialization code - DO NOT EDIT</span>
0029 
0030 
0031 <span class="comment">%% opening function</span>
0032 <a name="_sub1" href="#_subfunctions" class="code">function ModigInputMenu_OpeningFcn(hObject, eventdata, handles, varargin)</a>
0033 <span class="comment">%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%</span>
0034 <span class="comment">% Read in the previous state of the IO global and present it in the GUI</span>
0035 handles.output = hObject;
0036 guidata(hObject, handles);
0037 <span class="keyword">global</span> IO UserInfo
0038 
0039 <span class="comment">% Touch Screen</span>
0040 set(handles.checkbox_tchScr, <span class="string">'Value'</span>, UserInfo.use_touch_screen)
0041 
0042 <span class="comment">% EYE condition</span>
0043 set(handles.activateEye, <span class="string">'Value'</span>, IO.Input.eye.monitor)
0044 
0045 <span class="keyword">if</span> IO.Input.eye.monitor,
0046     set(handles.POP_EYE,<span class="string">'enable'</span>,<span class="string">'on'</span>)
0047     popAlt = get(handles.POP_EYE, <span class="string">'String'</span>);
0048     popSel = find(strcmp(IO.Input.eye.tracking_method, popAlt) == 1);
0049     set(handles.POP_EYE, <span class="string">'Value'</span>, popSel);
0050 <span class="keyword">else</span>
0051     set(handles.POP_EYE,<span class="string">'enable'</span>,<span class="string">'off'</span>)
0052 <span class="keyword">end</span>
0053 
0054 <span class="comment">% HAND condition % 0 == off, 1 == on</span>
0055 set(handles.activateHand, <span class="string">'Value'</span>, IO.Input.hand.monitor ); 
0056 
0057 <span class="keyword">if</span> IO.Input.hand.monitor,
0058     set(handles.POP_HAND,<span class="string">'enable'</span>,<span class="string">'on'</span>)
0059     popAlt = get(handles.POP_HAND, <span class="string">'String'</span>);
0060     popSel = find(strcmp(IO.Input.hand.tracking_method, popAlt) == 1);
0061     set(handles.POP_HAND, <span class="string">'Value'</span>, popSel);
0062 <span class="keyword">else</span>
0063     set(handles.POP_HAND,<span class="string">'enable'</span>,<span class="string">'off'</span>)
0064 <span class="keyword">end</span>
0065 
0066 <span class="comment">% TONGUE condition</span>
0067 set(handles.activateLick, <span class="string">'Enable'</span>, <span class="string">'Off'</span>)
0068 <span class="comment">% set(handles.activateLick, 'Value', IO.Input.tongue.monitor)</span>
0069 
0070 [THr RATE EMPTY] = <a href="../../Modig/library/isfield_sk.html" class="code" title="function [TF,value empty] = isfield_sk(stem, fullname)">isfield_sk</a>(IO,<span class="string">'Input.behavior.sampling_rate'</span>);
0071 
0072 <span class="keyword">if</span> ~EMPTY
0073     set(handles.EDIT_SAMPLING_RATE,<span class="string">'String'</span>,num2str(RATE));
0074 <span class="keyword">end</span>
0075 
0076 <span class="comment">% Update handles structure</span>
0077 guidata(hObject, handles);
0078 <span class="comment">%</span>
0079 <span class="keyword">if</span> ~isfield(IO.Input.behavior,<span class="string">'sample'</span>)
0080     <span class="comment">% if there's nothing to sample, activate &quot;do not sample&quot;</span>
0081     myhdl = [handles.activateEye, handles.activateHand, handles.checkbox_tchScr];
0082     IO.Input.behavior.sample = any(cell2mat(get(myhdl, <span class="string">'value'</span>)));
0083 <span class="keyword">end</span>
0084 set(handles.checkboxNoSampling, <span class="string">'value'</span>, ~IO.Input.behavior.sample);    
0085 
0086 
0087 <span class="comment">% set initial parameters in the userdata so that initial parameters can</span>
0088 <span class="comment">% be recovered when dialog is cancelled. Note that we don't update using</span>
0089 <span class="comment">% the callbacks to each element of the figure</span>
0090 GUI_Info = <a href="../../Modig/library/get_menu_contents.html" class="code" title="function GUI_Info = get_menu_contents(h)">get_menu_contents</a>(hObject);
0091 set(hObject,<span class="string">'userdata'</span>,GUI_Info); 
0092 
0093 <span class="comment">%% output function</span>
0094 <a name="_sub2" href="#_subfunctions" class="code">function varargout = ModigInputMenu_OutputFcn(hObject, eventdata, handles)</a>
0095 <span class="comment">%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%</span>
0096 varargout{1} = handles.output;
0097 
0098 <span class="comment">%% Eye-sampling drop down menu (empty)</span>
0099 <a name="_sub3" href="#_subfunctions" class="code">function POP_EYE_Callback(hObject, eventdata, handles)</a>
0100 <span class="comment">%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%</span>
0101 <span class="comment">% buf = get_GUI_value(hObject);</span>
0102 
0103 <span class="comment">%% Key rest callback</span>
0104 <a name="_sub4" href="#_subfunctions" class="code">function activateHand_Callback(hObject, eventdata, handles)</a>
0105 <span class="comment">%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%</span>
0106 actHand = get(hObject,<span class="string">'Value'</span>);
0107 <span class="keyword">if</span> actHand,
0108     set(handles.POP_HAND,<span class="string">'enable'</span>,<span class="string">'on'</span>)
0109     set(handles.checkboxNoSampling,<span class="string">'value'</span>,0);
0110     set(handles.EDIT_SAMPLING_RATE, <span class="string">'enable'</span>, <span class="string">'on'</span>);
0111 <span class="keyword">else</span>
0112     set(handles.POP_HAND,<span class="string">'enable'</span>,<span class="string">'off'</span>)    
0113     <span class="comment">% if there's nothing to sample, activate &quot;do not sample&quot;</span>
0114     myhdl = [handles.activateEye, handles.activateHand, handles.checkbox_tchScr];
0115     anyAct = any(cell2mat(get(myhdl, <span class="string">'value'</span>)));
0116     set(handles.checkboxNoSampling, <span class="string">'value'</span>, ~anyAct);    
0117 
0118 <span class="keyword">end</span>
0119 
0120 <span class="comment">% Update handles structure</span>
0121 guidata(hObject, handles);
0122 <span class="comment">%% Licking sampling (empty)</span>
0123 <a name="_sub5" href="#_subfunctions" class="code">function activateLick_Callback(hObject, eventdata, handles)</a>
0124 <span class="comment">%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%</span>
0125 <span class="comment">% buf = get_GUI_value(hObject);</span>
0126 
0127 <span class="comment">%% Sampling rate</span>
0128 <a name="_sub6" href="#_subfunctions" class="code">function EDIT_SAMPLING_RATE_Callback(hObject, eventdata, handles)</a>
0129 <span class="comment">%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%</span>
0130 
0131 fs = str2double(get(hObject,<span class="string">'String'</span>)); <span class="comment">% returns contents of hand_sample_rate as a double</span>
0132 <span class="keyword">if</span> fs &lt; 1 || fs &gt; 200
0133     warndlg({<span class="string">'Hand Sampling Rate must be in the [1:200) Hz range'</span> ; <span class="keyword">...</span>
0134         <span class="string">'Reverting to default 50 Hz sampling rate'</span>}, <span class="string">'Hand Sampling Warning'</span>)
0135     fs = 50;
0136     set(hObject, <span class="string">'String'</span>, fs)
0137 <span class="keyword">end</span>
0138 
0139 <span class="comment">% Update handles structure</span>
0140 guidata(hObject, handles);
0141 
0142 <span class="comment">%% --- Executes during object creation, after setting all properties.</span>
0143 <a name="_sub7" href="#_subfunctions" class="code">function hand_sample_rate_CreateFcn(hObject, eventdata, handles)</a>
0144 <span class="comment">% Hint: edit controls usually have a white background on Windows.</span>
0145 <span class="comment">%       See ISPC and COMPUTER.</span>
0146 <span class="keyword">if</span> ispc &amp;&amp; isequal(get(hObject,<span class="string">'BackgroundColor'</span>), get(0,<span class="string">'defaultUicontrolBackgroundColor'</span>))
0147     set(hObject,<span class="string">'BackgroundColor'</span>,<span class="string">'white'</span>);
0148 <span class="keyword">end</span>
0149 
0150 <span class="comment">%% --- Executes on button press in activateEye.</span>
0151 <a name="_sub8" href="#_subfunctions" class="code">function activateEye_Callback(hObject, eventdata, handles)</a>
0152 
0153 actEye = get(hObject,<span class="string">'Value'</span>);
0154 <span class="keyword">if</span> actEye,
0155     set(handles.POP_EYE,<span class="string">'enable'</span>,<span class="string">'on'</span>)
0156     set(handles.checkboxNoSampling,<span class="string">'value'</span>,0);
0157     set(handles.EDIT_SAMPLING_RATE, <span class="string">'enable'</span>, <span class="string">'on'</span>);
0158 <span class="keyword">else</span>
0159     set(handles.POP_EYE,<span class="string">'enable'</span>,<span class="string">'off'</span>)    
0160     <span class="comment">% if there's nothing to sample, activate &quot;do not sample&quot;</span>
0161     myhdl = [handles.activateEye, handles.activateHand, handles.checkbox_tchScr];
0162     anyAct = any(cell2mat(get(myhdl, <span class="string">'value'</span>)));
0163     set(handles.checkboxNoSampling, <span class="string">'value'</span>, ~anyAct);    
0164 <span class="keyword">end</span>
0165 
0166 <span class="comment">%% --- Executes on selection change in POP_HAND.</span>
0167 <a name="_sub9" href="#_subfunctions" class="code">function POP_HAND_Callback(hObject, eventdata, handles)</a>
