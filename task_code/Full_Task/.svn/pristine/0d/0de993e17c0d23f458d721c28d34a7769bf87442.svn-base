function y = ModigMakeGettyArray_IMP_SACC

% Make an array to send to Getty in FIXATION project
global Stim UserInfo Task TaskOp VisParam Tbl
cb = 1;

Array=int16(zeros(1,80));
% 1. fixed
Array(1) = 80; % numb of additional vars
% 2. taskNumb
Array(2) = 30; % previously 21, set at 30 from matlab version 1.0
% 3. combined trial type (bhvsit)
% oitask (0-4)
oitask = 0; % 0 for central fixation
% oiLRsit (1-2) picture positions: L or R
oiLRsit = 1;
% oiRange (1-5)
oiRange = 1;

[TH_image_select VAL_image_select EMPTY_image_select] = isfield_sk(Stim,'fixation_spot.CurTrial.image_selection');
if ~EMPTY_image_select
    oiOutcome = round(VAL_image_select);
else
    oiOutcome = 0;
    cb = 0;
end

bhvsit = oitask * 50 + (oiLRsit-1) * 25 + (oiRange-1) * 5 + oiOutcome;
Array(3) = bhvsit;
% longest possible trial length (error time added)
oitlong = Task.pre_trial.time_planned + Task.fixation.time_planned + Task.us.time_planned + Task.post_trial.time_planned + Task.error.time_planned;
Array(4) = floor(oitlong/256);
Array(5) = mod(oitlong,256);

% alternative range in choice trials
Array(6) = 0;
% picture
[TH_image VAL_image EMPTY_image] = isfield_sk(Stim,'fixation_spot.CurTrial.image.filename');
if ~EMPTY_image
    if strcmp(VAL_image,'circle')
        VAL_image = {'1'};
    elseif strcmp(VAL_image,'square')
        VAL_image = {'2'};
    elseif strcmp(VAL_image,'cross')
        VAL_image = {'3'};
    end
    [file_path file_name file_ext] = fileparts(cell2mat(VAL_image));
    picture_num = [];
    for ii = 1:length(file_name)
        buf = str2num(file_name(ii));
        if ~isempty(buf)
            if isreal(buf) % this is to avoid letter 'i' to be converted to '0+1i'
                picture_num= strcat(picture_num,num2str(buf));
            end
        end
    end
    picture_num = str2num(picture_num);
    Array(7) = floor(picture_num/256);
    Array(8) = mod(picture_num,256);
else
    cb = 0;
    Array(7) = 0;
    Array(8) = 0;
end


[TH_size VAL_size EMPTY_size] = isfield_sk(Stim,'fixation_spot.CurTrial.image.size');
[TH_x VAL_x EMPTY_x] = isfield_sk(Stim,'fixation_spot.CurTrial.position.x');
[TH_y VAL_y EMPTY_y] = isfield_sk(Stim,'fixation_spot.CurTrial.position.y');

if ~EMPTY_size & ~EMPTY_x & ~EMPTY_y
    % picture position by mac coordinate (top 0 left 0)
    % picture top
    pic_top  = VisParam.scr_center_y - VAL_y - round(VAL_size(2)/2);
    % picture left
    pic_left = VisParam.scr_center_x + VAL_x - round(VAL_size(1)/2);
    % picture bottom
    pic_bottom = VisParam.scr_center_y - VAL_y + round(VAL_size(2)/2);
    % picture right
    pic_right = VisParam.scr_center_x + VAL_x + round(VAL_size(1)/2);   
    
    Array(9) = floor(pic_top/256);
    Array(10) = mod(pic_top,256);
    Array(11) = floor(pic_left/256);
    Array(12) = mod(pic_left,256);
    Array(13) = floor(pic_bottom/256);
    Array(14) = mod(pic_bottom,256);
    Array(15) = floor(pic_right/256);
    Array(16) = mod(pic_right,256);
end

% fix spots

% central fix spot start color
Array(17) = 0;
% central fix spot size
Array(18) = 0;
Array(19) = 0;
% central fix at cue->peri size
Array(20) = 0;
% current central spot form
Array(21) = 0;
% peripheral fix spot start color
Array(22) = 0;
% any fix spot end color
Array(23) = 0;
% perioheral fix spot size
Array(24) = 0;

% eye tolerance window
% central tolerance window size
Array(25) = 0;
Array(26) = 0;
% position L tolerance window size
Array(27) = 0;
Array(28) = 0;
% position R tolerance window size
Array(29) = 0;
Array(30) = 0;

% rewards
% current reward magnitude
[TH_rwd_mag VAL_rwd_mag EMPTY_rwd_mag] = isfield_sk(Stim,'cs.CurTrial.image.rwd_mag');
if ~EMPTY_rwd_mag
    Array(31) = floor(VAL_rwd_mag/256);
    Array(32) = mod(VAL_rwd_mag,256);
else
    Array(31) = 0;
    Array(32) = 0;
end
% current reward probability
[TH_rwd_prob VAL_rwd_prob EMPTY_rwd_prob] = isfield_sk(Stim,'cs.CurTrial.image.rwd_prob');
if ~EMPTY_rwd_prob
    Array(33) = VAL_rwd_prob;
else
    Array(33) = 0;
end
% current reward delay
[TH_cs VAL_cs EMPTY_cs] = isfield_sk(Task, 'cs.time_planned');
if ~EMPTY_cs
    Array(34) = floor(VAL_cs/256);
    Array(35) = mod(VAL_cs,256);
end

% remaining parameters
Array(36) = 99;
% fix spot onset ssound
Array(37) = 0;
% oiErrCheck % 1: abort, 2: abort + Getty on initial error
Array(38) = 0;
% oiExactRepeart
Array(39) = 0;
% Timing dialog % only key:0, only eye:1, both:2 
Array(40) = 0;
% eye fix filter
Array(41) = 0;
% antisac
Array(42) = 0;
% dialog normal ITI past
Array(43) = floor(TaskOp.EvntHist.prev_ITI_base/256); % previous ITI duration base
Array(44) = mod(TaskOp.EvntHist.prev_ITI_base,256); % previous ITI duration base
Array(45) = floor(TaskOp.EvntHist.prev_ITI_var/256); % previous ITI duration var
Array(46) = mod(TaskOp.EvntHist.prev_ITI_var,256); % previous ITI duration var
Array(47) = 0;
Array(48) = 0;

% [this is planned ITI duration]
%Array(49) = floor(TaskOp.EvntHist.prev_ITI_rand/256); % planned ITI duration
%Array(50) = mod(TaskOp.EvntHist.prev_ITI_rand,256);   % planned ITI duration

% [this is measured ITI duration]
% At this moment we are in ITI between (n)th and (n+1)th trial.
% We don't know duration of this ITI because there are several processes to happen before (n+1)th trial starts.
% ITI duration is sent to getty ignoring this time.
% ITI duration between (n)th and (n+1)th trial is logged in the data of (n+1)th trial, with some underestimation.
%%%%%                 prev_ITI_start_time    prev_trial_start_time     ITI_start_time          cur_trial_start_time (unknown yet)
%%%%%                     |                      |                           |                    |
%%%%%  ----|  trial (n-1) |----------------------|       trial(n)            |--------------------| trial(n+1) |--------------
[TH ITI_start_time Empty] = isfield_sk(TaskOp,'EvntHist.ITI_start_time');
if ~Empty
    prev_ITI_dur = round(etime(clock, TaskOp.EvntHist.ITI_start_time)*1000);
else
    prev_ITI_dur = 0;
end
if prev_ITI_dur>2^16 % ITI longer than 1 min 5 sec 536 msec is rounded to 65535 msec, because of 16 bit limit
    Array(49) = 255;
    Array(50) = 255;
else
    Array(49) = floor(prev_ITI_dur/256);
    Array(50) = mod(prev_ITI_dur,256);
end
Array(51) = Stim.fixation_spot.CurTrial.image_selection;
[TH max_reps Empty] = isfield_sk(Tbl,'Rand.rwd_cond.cur_max_reps');
if ~Empty
    Array(52) = max_reps;
else
    Array(52) = 1;
end
Array(53) = 0; % fix eye ctr 1 until cue on
Array(54) = 0; % fix eye ctr 2 until cue on
Array(55) = 0; % sacc eye ctr 1 until cue on
Array(56) = 0; % sacc eye ctr 2 cue on to cent fix off
Array(57) = 0; % sacc eye ctr 3 to pericol change
Array(58) = 0; % imp target indicator in
for aa = 59:Array(1)
    Array(aa) = 0;
end

y.cb = cb;
y.Array = Array;


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
function cb = getnum(FILENAME)
pic_num = [];
for aa = 1:length(FILENAME)
    if ~strcmp(FILENAME(aa),'i')
        buf = str2num(FILENAME(aa));
        if ~isempty(buf)
            pic_num = [pic_num num2str(buf)];
        end
    end
end
if ~isempty(pic_num)
    cb = str2num(pic_num);
else
    cb = [];
end
