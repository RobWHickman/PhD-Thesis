function varargout =  ModigCommentLevel(varargin)
% Change Comment level (on Modig main menu & command line)
% Comment level ranges between 0 and 9
% The lower the comment level is, the MORE comments are printed
% Note that printing comments can delay real time task control
% considerablly. So, it is absolutely necessary to set comment level HIGH
% (9 is recommended) unless you are debugging.
%
% Important note: ModigCommentLevel controls only the
%   Comment Level, not the priority as before, especially since there are
%   3 levels of Priority in Windows and 9 in Mac. 

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% coded by skoba (skoba-tky@umin.ac.jp) 8 June 2005
% last modified by skoba 4 Oct 2005
% RBM   8.05.07 IMPORTANT CHANGE! ModigCommentLevel controls only the
%   Comment Level, not the priority as before, especially since there are
%   3 levels of Priority in Windows and 9 in Mac. So there's no agreement
%   between TaskOp.message_level and TaskOp.priority_level. 

gui_Singleton = 1;
gui_State = struct('gui_Name',       mfilename, ...
                   'gui_Singleton',  gui_Singleton, ...
                   'gui_OpeningFcn', @ModigCommentLevel_OpeningFcn, ...
                   'gui_OutputFcn',  @ModigCommentLevel_OutputFcn, ...
                   'gui_LayoutFcn',  [] , ...
                   'gui_Callback',   []);
if nargin && ischar(varargin{1})
    gui_State.gui_Callback = str2func(varargin{1});
end

if nargout
    [varargout{1:nargout}] = gui_mainfcn(gui_State, varargin{:});
else
    gui_mainfcn(gui_State, varargin{:});
end
% End initialization code - DO NOT EDIT

%%
function ModigCommentLevel_OpeningFcn(hObject, eventdata, handles, varargin)
global TaskOp
handles.output = hObject;
guidata(hObject, handles);
set(handles.SLIDER_COMMENT_LEVEL,'min',0,'max',9,'SliderStep',[1 1],'value',TaskOp.message_level);
set(handles.EDIT_COMMENT_LEVEL,'string',num2str(TaskOp.message_level));

%%
function varargout = ModigCommentLevel_OutputFcn(hObject, eventdata, handles) 
varargout{1} = handles.output;

%%
function SLIDER_Callback(hObject, eventdata, handles)
global TaskOp
TaskOp.message_level = round(get(hObject,'value'));
set(handles.EDIT_COMMENT_LEVEL,'string',num2str(round(get(hObject,'value'))));

%%
function EDIT_COMMENT_LEVEL_Callback(hObject, eventdata, handles)
global TaskOp
buf = get(hObject,'string');
buf2 = str2double(buf);
if isnumeric(buf2)
    % Set limits
    if buf2 < 0
        buf2 = 0;
    elseif buf2 > 9
        buf2 = 9;
    end
    set(handles.SLIDER_COMMENT_LEVEL,'value',round(buf2));
    set(handles.EDIT_COMMENT_LEVEL,'string',num2str(round(buf2)));
    TaskOp.message_level = round(buf2);
else
    set(handles.hObject,'string','');
end