function ModigLog_OBS_LEARN 

warning('To be re-written!')
return

global TaskOp Stim BehaveData ModigDir UserInfo 
persistent idx dictatorData stimSelect taskOpSelect

if isempty(dictatorData),
    stimSelect = {'touchHold','target','choApp','us'};
    taskOpSelect = {'reward', 'error_event','curSetup','choice','trecon',...
        'correct'};
    idx = 1;
end

% get trial results from TaskOp
for i = 1:length(taskOpSelect),
    dictatorData(idx).TaskOp.(char(taskOpSelect(i))) = TaskOp.(char(taskOpSelect(i))); 
end
% clean TaskOp.trecon, so that it doesn't "overloads" memory
% TaskOp.trecon = TaskOp.trecon(:,:,1);
TaskOp.trecon = [];
% get behavior table
dictatorData(idx).BehaveData = BehaveData.Tbl;

% get stimuli details, which contain *most* behavioral requirements
for j = 1:length(stimSelect),
    dictatorData(idx).Stim.(char(stimSelect(j))) = Stim.(char(stimSelect(j))); 
end

% get animal ids --> can go in the *header*
dictatorData(idx).animalIds = [UserInfo.setupA,'_', UserInfo.setupB];

% get 'human' time -->fallible when we re set the cpu "clock"
dictatorData(idx).logTime = clock;

% save data
pul = num2str([Stim.us.possiblePulses(1,:), Stim.us.possiblePulses(2,:)]);
fileName = [ModigDir.Log,'\Dictator_',datestr(now,29),'_',dictatorData(idx).animalIds,'-',pul];
if exist(fileName,'file')==0
%     dictatorData(1) = dictatorData(idx);
%     dictatorData(2:end) = [];
%     idx = 1;
    save(fileName,'dictatorData')
    TaskOp.log.filename = fileName;%['Dictator_',datestr(now,29),'_',dictatorData(idx).animalIds,'-',pul];
else
    save(fileName,'-append','dictatorData')
end

idx = idx +1;

