<h2><a name="_source"></a>SOURCE CODE <a href="#_top"><img alt="^" border="0" src="../../../../up.png"></a></h2>
<div class="fragment"><pre>0001 <a name="_sub0" href="#_subfunctions" class="code">function ModigLog_TOUCH_TRAINING</a>
0002 <span class="comment">% ModigLog_TOUCH_TRAINING(option)</span>
0003 <span class="comment">%</span>
0004 <span class="comment">% Saves:</span>
0005 <span class="comment">%   -the stims params,</span>
0006 <span class="comment">%   -the timer time stamps. takes the ITI previous to the start of the</span>
0007 <span class="comment">%         current trial)</span>
0008 <span class="comment">%   -the behavioral data</span>
0009 <span class="comment">%   -*eventually* the flipping time stamps</span>
0010 <span class="comment">%</span>
0011 <span class="comment">% into a *momentarily* MAT file (less overhead as with an XLS)</span>
0012 
0013 <span class="comment">% RBM 1.08</span>
0014 <span class="keyword">global</span> BehaveData Stim Task TaskOp TrialLog UserInfo
0015 
0016 <span class="keyword">persistent</span> idx 
0017 <span class="keyword">if</span> isempty(idx)
0018     idx = 1;
0019 <span class="keyword">end</span>
0020 
0021 TrialLog(idx).behDa = BehaveData;
0022 TrialLog(idx).Stim  = Stim;
0023 TrialLog(idx).task  = Task;
0024 TrialLog(idx).tOper = TaskOp;
0025 
0026 
0027 str = strcat(TaskOp.prj,date,<span class="string">'_aid_'</span>,UserInfo.animal_ID);
0028 path = <span class="string">'C:\Program Files\MATLAB\R2006b\work\Modig\Log\'</span>;
0029 fileName = [path,str];
0030 <span class="keyword">if</span> ~exist(<span class="string">'fileName'</span>,<span class="string">'file'</span>),
0031     save(fileName, <span class="string">'TrialLog'</span>)
0032 <span class="keyword">else</span>
0033     save(fileName, <span class="string">'TrialLog'</span>, <span class="string">'-append'</span>)
0034 <span class="keyword">end</span>
0035 idx = idx + 1;</pre></div>
