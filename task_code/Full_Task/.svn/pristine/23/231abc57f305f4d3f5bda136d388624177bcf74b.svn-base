function cb = ModigPreparePages_GUIDED_REACH
%  cb = ModigPreparePages_GUIDED_REACH
%
% page 1: background
% page 2: CS on
% page 3: touch target
% page 4: target touched feedback, target area dissapears or green circle
%
% See also EXPSHOWIMAGE, EXPDRAWRECT, MODIGMONITORBEHAVIOR, DRAWRECT

% RBM 01.08
%     03.08
global Tbl VisParam Stim 

% prepare VisParam params
cb = 1;
VisParam.pages    = unique(cell2mat(Tbl.TaskTbl(:,Tbl.TaskTblColumnID.vis_page)));
VisParam.pages    = VisParam.pages(VisParam.pages>0);
VisParam.num_page = length(VisParam.pages);

% String for Drawing with PTB on subject's screen the fixation spot,
bkgstr   = 'Screen(''FillRect'', VisParam.scr_handle, [127 127 127]);';

% draw touch rest key cue
% rc = Stim.restCue;
% rcstr    = ['Screen(''FillOval'', VisParam.scr_handle,[',num2str(rc.color),'],[',num2str(rc.position),']);'];

% draw CS on or load CS on image
cs = Stim.CSon;
csPos = num2str(cs.position);
switch cs.type
    case 'img'
        VisParam.texid = Screen('MakeTexture', VisParam.scr_handle, Stim.CSon.img);
        csstr = strcat('Screen(''DrawTexture'',  VisParam.scr_handle, VisParam.texid, [],[',csPos,']);');
    case 'bars'
        % horizontal bars -px-
        propRew = (cs.actRew-min(cs.rewRange))./(max(cs.rewRange)-min(cs.rewRange));
        pFpos  = [ cs.position(1),...
                   cs.position(4)-(cs.size*propRew),...
                   cs.position(3),...
                   cs.position(4)-(cs.size*propRew)+cs.hBarHeigth];      
        pos = num2str([csPos; pFpos]);
        wb = ['Screen(''FillRect'',VisParam.scr_handle,[',num2str(cs.bkgclr),'],[',pos(1,:),']);'];
        hb = ['Screen(''FillRect'',VisParam.scr_handle,[',num2str(cs.chocolor),'],[',pos(2,:),']);'];
        wbf = ['Screen(''FrameRect'',VisParam.scr_handle,[',num2str(cs.chocolor),'],[',pos(1,:),'],3);'];

        % in case we have a '0' reward value
        if cs.actRew>0
            csstr = [wb,' ', hb, wbf];
        else
            csstr = [wb,wbf];
        end
    case 'ring'
        [csstr ringHdl]  = drawRings(cs.clr, cs.position, VisParam.h_MONITOR_AXIS, 3);
end

% draw touch target
tpos = num2str(Stim.target.position);
tclr = num2str(Stim.target.color);
tstr = strcat('Screen(''FillRect'', VisParam.scr_handle, [',tclr,'],[',tpos,']);'); 
    
% draw target touched feedback
fbpos = num2str(Stim.targetFB.position);
fbclr = num2str(Stim.targetFB.color); 
fbstr = strcat('Screen(''FrameOval'', VisParam.scr_handle, [',fbclr,'],[',fbpos,'],3);');

% flip strings
flpstr   = 'Screen(''Flip'',VisParam.scr_handle);';
flpnoclr = 'Screen(''Flip'',VisParam.scr_handle,[],1);';

% load draw commands into VisParam global
VisParam.page(1).draw = bkgstr;
VisParam.page(2).draw = csstr;
VisParam.page(3).draw = tstr;
% VisParam.page(4).draw = [tstr fbstr];
VisParam.page(4).draw = csstr;

VisParam.page(1).flip = flpstr;
VisParam.page(2).flip = flpnoclr;
VisParam.page(3).flip = flpstr;
VisParam.page(4).flip = flpstr;

VisParam.page(1).str = [bkgstr, flpstr];
VisParam.page(2).str = [csstr, flpnoclr];
VisParam.page(3).str = [tstr, flpstr];
% VisParam.page(4).str = [tstr, fbstr, flpstr];
VisParam.page(4).str = [csstr, flpstr];

% Draw stimulus on experimenter's monitor (ModigMonitor)
[TH h_monitor EMPTY] = isfield_sk(VisParam,'h_MONITOR_AXIS');
if ~EMPTY && ishandle(h_monitor),
%     cshdl = zeros(3,1);
    cshdl = [];
    tarHdl = zeros(3,1);
    sz = Stim.target.position(3:4)-Stim.target.position(1:2);
    cs = Stim.CSon;
%     cssz = cs.position(3:4)-cs.position(1:2);
    % target and rest cue 
    for i=1:3,
        switch cs.type
            case 'img'
                imgSz = size(cs.img);
                factor = imgSz(1:2) ./ sz;
                if sum(factor>=2)~=2,
                    factor = [2 2];
                end
                [x y z reducedImg] = reducevolume(cs.img,[factor 1]);
                cshdl(i) = image(...
                    cs.position(1),...
                    VisParam.scr_rect(4)-cs.position(4),...
                    reducedImg,...
                    'Parent',h_monitor,...
                    'Visible', 'off');
            case 'bars'
                sz = cs.hBarHeigth*2;
                cshdl(i) = rectangle(...
                'Position', [pFpos(1) VisParam.scr_rect(4)-pFpos(2) pFpos(3)-pFpos(1) sz],...
                'FaceColor',cs.chocolor./256,...
                'Parent',h_monitor,...
                'Visible', 'off');
            case 'ring'
                cshdl = [cshdl, ringHdl(:,i)];
        end
        tarHdl(i) = rectangle(...
            'Position', [Stim.target.position(1), VisParam.scr_rect(4)-Stim.target.position(4),...
            sz],...
            'FaceColor',Stim.target.color/256,...
            'Parent',h_monitor,...
            'Visible', 'off');  
    end
      
%     % target acquired feedback ... circle
%     theta = linspace(0,2*pi,1000);
%     rho   = ones(1,1000)* ((sz(1)/2)+Stim.targetFB.size);
%     [X,Y] = pol2cart(theta,rho); % polar to cartesian
%     X     = X + Stim.target.center(1);
%     Y     = Y + Stim.target.center(2);
%     fbHdl = plot(X,Y,...
%             'Color',Stim.targetFB.color./256,...
%             'Parent',h_monitor,...
%             'Visible', 'off');
        
    VisParam.exp_page(1).obj_handle = cshdl(:,1);
    VisParam.exp_page(2).obj_handle = [cshdl(:,2); tarHdl(1)];
    VisParam.exp_page(3).obj_handle = cshdl(:,3);
%     VisParam.exp_page(4).obj_handle = [tarHdl(3); fbHdl];

    for i = 1:3,
        VisParam.exp_page(i).scr_handle = h_monitor;
    end
end
