0117 <span class="comment">% --- Executes on button press in pushbutton_update.</span>
0118 <a name="_sub7" href="#_subfunctions" class="code">function pushbutton_update_Callback(hObject, eventdata, handles)</a>
0119 <span class="comment">% hObject    handle to pushbutton_update (see GCBO)</span>
0120 <span class="comment">% eventdata  reserved - to be defined in a future version of MATLAB</span>
0121 <span class="comment">% handles    structure with handles and user data (see GUIDATA)</span>
0122 
0123 <span class="comment">% put together juice string</span>
0124 upDownDelay = 0.001;<span class="comment">%[latest latency measurements suggest latencies =1ms, Feb 2013]</span>
0125 openTime = handles.openTime-upDownDelay; <span class="comment">% DIO up/down adjustment</span>
0126 
0127 curJuiceCall = [<span class="string">'DIOjuice('</span>,num2str(openTime),<span class="string">','</span>,num2str(handles.curLine),<span class="string">');'</span>];    
0128 <span class="keyword">if</span> handles.pulses&gt;1,
0129     juiceAndDelay = sprintf(<span class="string">'%s WaitSecs(%s); '</span>,curJuiceCall,handles.interPulseDelay);
0130     handles.juiceString = [repmat(juiceAndDelay,1,handles.pulses-1), curJuiceCall];
0131 <span class="keyword">else</span>
0132     handles.juiceString = curJuiceCall;
0133 <span class="keyword">end</span>
0134 
0135 set(handles.text_currentCall,<span class="string">'String'</span>,handles.juiceString)
0136 guidata(handles.pushbutton_update,handles)
0137 
