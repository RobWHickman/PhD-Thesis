function ModigPrepareTrial_EYECAL
% ModigPrepareTrial_EYECAL
%
% define the
% parameters that correspond to this project. and that are updated every
% trial
%
% NB the parameters are set on the first call, subsequent changes *must* be
% made in the corresponding GUI. e.g. on ModigMainMenu: Stim-->preTrial and
% if changed field "default" should be changed to 0. 
%
% RBM 08.07
%     10.08 use with table setup
%     04.09 GUI integration with Stim (Jawbreakingly)
%     07.09 pseudorandomization of conditions
%     02.10 Peri fix position in visual angle
global Stim VisParam Timers UserInfo TaskOp

%% create whole window if we don't have one yet
persistent wholeWindow
windowPtrs=Screen('Windows');
kind=Screen(windowPtrs, 'WindowKind');

if isempty(wholeWindow) && sum(kind==1)==2,
    [VisParam.scr_handle, VisParam.scr_rect] = Screen('OpenWindow',1, 0);
    TaskOp.curSetup = 'A';
    activeSetupChange;
    wholeWindow = 1;
    
    if UserInfo.use_split==1,
        UserInfo.use_split = 0;
    end
end
scrCtr = VisParam.scr_rect(3:4)/2;

%% pre_trial behav params
if ~isfield(Stim.pre_trial,'default') || Stim.pre_trial.default == 1,
    Stim.pre_trial.hand.req         = 1;
    Stim.pre_trial.handInterrupt    = 1;
    Stim.pre_trial.hand.filter_time = Timers.Event.pre_trial.StartDelay-0.6;
    Stim.pre_trial.hold             = 1;
    Stim.pre_trial.holdTime         = 0.5;
    Stim.pre_trial.default          = 1;
end

%% central fixation parameters
% (x,y) from mon center
Stim.centralFix.center = scrCtr; 

if ~isfield(Stim.centralFix,'default') || Stim.centralFix.default == 1,
    Stim.centralFix.hand.req            = 1;
    
    Stim.centralFix.size = [10 10]; 

    cF = Stim.centralFix;
    Stim.centralFix.position = [cF.center-cF.size(1),...
                                cF.center+cF.size(2)];

    % [rgb] (0-256, ptb; 0-1, matlab
    Stim.centralFix.color               = [256 0 256]; 

    Stim.centralFix.tolerance_window    = 150;

    Stim.centralFix.filter_time         = 1.5;
    Stim.centralFix.hold                = 1;
    Stim.centralFix.holdTime            = .5;
    Stim.centralFix.eyeInterrupt        = 1;
    
    Stim.centralFix.default             = 1;
end

% [Stim.centralFix.tolWin  Stim.centralFix.tolWinHdl] = createTolWin2(Stim.centralFix.center, Stim.centralFix.tolerance_window);
[Stim.centralFix.tolWin  Stim.centralFix.tolWinHdl] = createTolWinCircle(Stim.centralFix.center, Stim.centralFix.tolerance_window);


%% peripheral  fixation parameters   
if ~isfield(Stim.centralFix,'default') || Stim.periFix.default==1
    Stim.periFix.conds = 2;

    Stim.periFix.default            =  1;
    Stim.periFix.hand.req           =  1;
    Stim.periFix.size = [10 10];
    Stim.periFix.distCtr = [VisParam.scr_rect(3)/4 250];
     Stim.periFix.distCtrDeg = 5;
    Stim.periFix.color              = [0 256 256]; 

    Stim.periFix.tolerance_window   = 150;

    Stim.periFix.hold               = 1;
    Stim.periFix.holdTime           = 0.5;
    Stim.periFix.filter_time        = 1;
    Stim.periFix.eyeInterrupt       = 1;
    
    Stim.periFix.degChangeX         = [-9, 9];
    Stim.periFix.degChangeY         = [-3,3];
end

%% counter stuff, select final position for perifix
timesXCond = 6;
TaskOp.count.total_seq=Stim.periFix.conds*timesXCond;

if isfield(TaskOp.count,'prjCount') && Stim.periFix.conds ~= length(TaskOp.count.prjCount)
    % it wasn't our counter...
    TaskOp.count.prjCount = zeros(Stim.periFix.conds,1);
end

% select one condition and one target
if TaskOp.count.seq > TaskOp.count.total_seq || TaskOp.count.seq <= 1 ...
        || isempty(TaskOp.count.trialOrder)
    TaskOp.count.seq = 1;
    
    TaskOp.count.trialOrder = ModigRandSeq_DICTATOR(Stim.periFix.conds, ...
        TaskOp.count.total_seq);
    
    TaskOp.count.total_seq = size(TaskOp.count.trialOrder,1);
end

% check that we'll look for a predefined trial
if size(TaskOp.count.trialOrder,1) < TaskOp.count.seq,
    TaskOp.count.seq = 1;
    ModigPrepareTrial_EYECAL;
end

c  = 42.7; %cm, real
h  = 20; %cm, real
d  = sqrt(c^2 + h^2);

thetaCFy = atan(c/h);
degCFy = rad2deg(thetaCFy);

horDistInCM = tan(deg2rad(Stim.periFix.degChangeX))*d;
verDistInCM = (tan(deg2rad(degCFy + Stim.periFix.degChangeY))*h)-c;
pixelsInOneCM = 33.6842; % obtained from analog2eyepos
horDistInPix = round(pixelsInOneCM*horDistInCM);
verDistInPix = round(pixelsInOneCM*verDistInCM);
% clockwise from the top, Nigel Version
thisCond = TaskOp.count.trialOrder(TaskOp.count.seq);
% thisCond = 1+(rand(1)>0.5); % only left-right

if thisCond==4, % up....
    x = scrCtr(1) + verDistInPix(1); 
    y = scrCtr(2);
elseif thisCond==2, % right
    x = scrCtr(1);
    y = scrCtr(2) + horDistInPix(1);
elseif thisCond == 3, % down
    x = scrCtr(1) + verDistInPix(2);
    y = scrCtr(2);
elseif thisCond == 1, % left
    x = scrCtr(1);
    y = scrCtr(2) + horDistInPix(2);
end

Stim.periFix.center   = [x y]; 
Stim.periFix.position = [Stim.periFix.center-Stim.periFix.size,...
                         Stim.periFix.center+Stim.periFix.size];
% % invert Y-axis to plot correctly the position of the Tolerance windows                     
% Stim.periFix.center(2) = VisParam.scr_rect(4)-y;


% [Stim.periFix.tolWin  Stim.periFix.tolWinHdl] = createTolWin2(Stim.periFix.center, Stim.periFix.tolerance_window);
[Stim.periFix.tolWin  Stim.periFix.tolWinHdl] = createTolWinCircle(Stim.periFix.center, Stim.periFix.tolerance_window);
%% TODO: WHERE SHOULD THIS GO!?
TaskOp.lostHold = 0;
