<h2><a name="_source"></a>SOURCE CODE <a href="#_top"><img alt="^" border="0" src="../../../../up.png"></a></h2>
<div class="fragment"><pre>0001 <a name="_sub0" href="#_subfunctions" class="code">function ModigPrepareOutput_TWOAFC_SACC</a>
0002 <span class="comment">% Prepares timers for digital output, e.g. juice trigger.</span>
0003 <span class="comment">% Called by PrepareBitTbl subroutine in ModigChangeTask.m</span>
0004 
0005 <span class="comment">% coded by skoba (skoba-tky@umin.ac.jp) 1 February 2006</span>
0006 <span class="comment">% last modified by skoba 1 February 2006</span>
0007 <span class="keyword">global</span> Tbl IO Task Timers
0008 
0009 <span class="comment">% set FREE-reward bit and duration</span>
0010 IO.Output.free_juice.bit =  Tbl.Bit.Reward.bit_asignment; <span class="comment">% bit asignment is constant. Read it from Tbl file</span>
0011 [TH free_juice_dur Empty] = <a href="../../../../Modig/library/isfield_sk.html" class="code" title="function [TF,value empty] = isfield_sk(stem, fullname)">isfield_sk</a>(IO,<span class="string">'Output.free_juice.dur'</span>);
0012 <span class="keyword">if</span> Empty
0013    IO.Output.free_juice.dur = 100; 
0014 <span class="keyword">end</span>
0015 <a href="../../../../Modig/shell/ModigSetTimer.html" class="code" title="function cb = ModigSetTimer(timer_category,timer_name)">ModigSetTimer</a>(<span class="string">'Output'</span>,<span class="string">'free_juice'</span>);
0016 
0017 <span class="comment">% set TASK-reward bit and duration</span>
0018 IO.Output.task_juice.bit =  Tbl.Bit.Reward.bit_asignment; <span class="comment">% bit asignment is constant. Read it from Tbl file</span>
0019 [TH task_juice_dur Empty] = <a href="../../../../Modig/library/isfield_sk.html" class="code" title="function [TF,value empty] = isfield_sk(stem, fullname)">isfield_sk</a>(IO,<span class="string">'Output.task_juice.dur'</span>);
0020 <span class="keyword">if</span> Empty
0021    IO.Output.task_juice.dur = 100; 
0022 <span class="keyword">end</span>
0023 <a href="../../../../Modig/shell/ModigSetTimer.html" class="code" title="function cb = ModigSetTimer(timer_category,timer_name)">ModigSetTimer</a>(<span class="string">'Output'</span>,<span class="string">'task_juice'</span>);
0024 <span class="keyword">if</span> isempty(ismember(Task.us.OutputTimer,<span class="string">'Timers.Output.task_juice'</span>))
0025     ModigLockTimerToEvent(<span class="string">'us'</span>,<span class="string">'Timers.Output.task_juice'</span>);
0026 <span class="keyword">else</span>
0027     Task.us.OutputTimer = unique(Task.us.OutputTimer);
0028 <span class="keyword">end</span>
0029 
0030 
0031</pre></div>
