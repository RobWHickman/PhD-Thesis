<h2><a name="_source"></a>SOURCE CODE <a href="#_top"><img alt="^" border="0" src="../../up.png"></a></h2>
<div class="fragment"><pre>0001 <a name="_sub0" href="#_subfunctions" class="code">function ModigMessage(msg_where,msg_what,msg_level,option)</a>
0002 <span class="comment">%</span>
0003 <span class="comment">% ModigMessage(msg_where,msg_what,msg_level,option)</span>
0004 <span class="comment">%</span>
0005 <span class="comment">% Print message on Modig Main Menu and/or command window</span>
0006 <span class="comment">% msg_where:</span>
0007 <span class="comment">%             'message_board&quot; or 'm', or 'M' -&gt; print on message window on the Modig Main Menu</span>
0008 <span class="comment">%             'command_line' or 'c', or 'C'  -&gt; print on command line</span>
0009 <span class="comment">%             'm&amp;c'                          -&gt; print on both</span>
0010 <span class="comment">% msg_what:  string to print out</span>
0011 <span class="comment">% msg_level: 0 to 9, higher values mean less output</span>
0012 <span class="comment">% option: only accepts the char 'clear' and clears the messages where</span>
0013 <span class="comment">%           indicated</span>
0014 <span class="comment">%</span>
0015 
0016 <span class="comment">% SK    wrote it</span>
0017 <span class="comment">% RBM   8.05.07 changed isstr to ischar, reposition of drawnow for faster</span>
0018 <span class="comment">%       execution</span>
0019 
0020 <span class="keyword">global</span> MENUs TaskOp
0021 
0022 <span class="keyword">if</span> nargin &lt; 3
0023     msg_level = 1;
0024 <span class="keyword">end</span>
0025 
0026 <span class="keyword">if</span> nargin &gt;=4
0027     <span class="keyword">if</span> strcmp(option,<span class="string">'clear'</span>)
0028         <span class="keyword">switch</span> msg_where,
0029             <span class="keyword">case</span> {<span class="string">'message_board'</span>,<span class="string">'m'</span>,<span class="string">'M'</span>}
0030                 set(MENUs.ModigMainMenu.handles.LIST_MESSAGE,<span class="string">'string'</span>,{<span class="string">''</span>;<span class="string">''</span>;<span class="string">''</span>},<span class="string">'Value'</span>,1,<span class="string">'ListboxTop'</span>,3);
0031             <span class="keyword">case</span> {<span class="string">'command_line'</span>,<span class="string">'c'</span>,<span class="string">'C'</span>}
0032                 clc;
0033             <span class="keyword">case</span> <span class="string">'m&amp;c'</span>
0034                 set(MENUs.ModigMainMenu.handles.LIST_MESSAGE,<span class="string">'string'</span>,{<span class="string">''</span>;<span class="string">''</span>;<span class="string">''</span>},<span class="string">'Value'</span>,1,<span class="string">'ListboxTop'</span>,3);
0035                 clc;
0036         <span class="keyword">end</span>
0037     <span class="keyword">end</span>
0038 <span class="keyword">end</span>
0039 
0040 <span class="comment">% decide to give output or not,</span>
0041 <span class="comment">% NOTE, all calls go through since I commented out the if-else structure</span>
0042 <span class="comment">% if TaskOp.message_level &lt;= msg_level</span>
0043     <span class="keyword">switch</span> msg_where
0044         <span class="keyword">case</span> {<span class="string">'message_board'</span>,<span class="string">'m'</span>,<span class="string">'M'</span>}
0045             <span class="keyword">if</span> ischar(msg_what)
0046                 str = get(MENUs.ModigMainMenu.handles.LIST_MESSAGE,<span class="string">'String'</span>);
0047                 <span class="comment">% truncate output string</span>
0048                 <span class="keyword">if</span> length(str)&gt;30,
0049                     str = {};
0050                 <span class="keyword">end</span>
0051                 str = [str;{msg_what}];
0052                 set(MENUs.ModigMainMenu.handles.LIST_MESSAGE,<span class="string">'string'</span>,str,<span class="string">'Value'</span>,1,<span class="string">'ListboxTop'</span>,length(str));
0053             <span class="keyword">elseif</span> isnumeric(msg_what)
0054                 str = get(MENUs.ModigMainMenu.handles.LIST_MESSAGE,<span class="string">'String'</span>);
0055                 str = [str;{num2str(msg_what)}];
0056                 set(MENUs.ModigMainMenu.handles.LIST_MESSAGE,<span class="string">'string'</span>,str,<span class="string">'Value'</span>,1,<span class="string">'ListboxTop'</span>,length(str));
0057             <span class="keyword">end</span>
0058         <span class="keyword">case</span>  {<span class="string">'command_line'</span>,<span class="string">'c'</span>,<span class="string">'C'</span>}
0059             <span class="keyword">if</span> ischar(msg_what)
0060                 fprintf(<span class="string">'%s\n'</span>,msg_what)
0061             <span class="keyword">elseif</span> isnumeric(msg_what)
0062                 fprintf(<span class="string">'%f\n'</span>,msg_what)
0063             <span class="keyword">end</span>
0064         <span class="keyword">case</span> <span class="string">'m&amp;c'</span>
0065             <span class="keyword">if</span> ischar(msg_what)
0066                 str = get(MENUs.ModigMainMenu.handles.LIST_MESSAGE,<span class="string">'String'</span>);
0067                 <span class="keyword">if</span> length(str)&gt;30,
0068                     str = {};
0069                 <span class="keyword">end</span>
0070                 str = [str;{msg_what}];
0071                 set(MENUs.ModigMainMenu.handles.LIST_MESSAGE,<span class="string">'string'</span>,str,<span class="string">'Value'</span>,1,<span class="string">'ListboxTop'</span>,length(str));
0072             <span class="keyword">elseif</span> isnumeric(msg_what)
0073                 str = get(MENUs.ModigMainMenu.handles.LIST_MESSAGE,<span class="string">'String'</span>);
0074                 str = [str;{num2str(msg_what)}];
0075                 set(MENUs.ModigMainMenu.handles.LIST_MESSAGE,<span class="string">'string'</span>,str,<span class="string">'Value'</span>,1,<span class="string">'ListboxTop'</span>,length(str));
0076             <span class="keyword">end</span>
0077             <span class="keyword">if</span> ischar(msg_what)
0078                 fprintf(<span class="string">'%s\n'</span>,msg_what)
0079             <span class="keyword">elseif</span> isnumeric(msg_what)
0080                 fprintf(<span class="string">'%f\n'</span>,msg_what)
0081             <span class="keyword">end</span>
0082     <span class="keyword">end</span>
0083      <span class="comment">%  flush the event queue and update the figure(s) window</span>
0084     drawnow;
0085     
0086 <span class="comment">% BUG report: ??? Error using ==&gt; drawnow</span>
0087 <span class="comment">% UIJ_AreThereWindowShowsPending - timeout waiting for window to show up.</span>
0088 
0089 <span class="comment">% end</span></pre></div>
