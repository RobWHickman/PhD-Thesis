function updateMoMaMe_PAVLOVIAN_FIX(option)
% updateMoMaMe_PAVLOVIAN_FIX(option)
%
% creates a project specific and totally modifiable update area in the
% MOMaMe figure using uicontrols. 
% 
% inputs: 'initialize' -->creates the uicontrols
%         'update' --> updates the counters.
%         'reset' --> resets the counters
%

% rbm 2.13 based on updateMoMaMe_PAVLOVIAN_FIX
global MENUs TaskOp Stim
figHdl = MENUs.ModigMainMenu.handle;
upArea = MENUs.ModigMainMenu.handles.prjUpArea;

switch option,
    case 'initialize',
        
        % change Area name,
        set(upArea,'Units','pixels')
        set(upArea,'Title', TaskOp.prj)

        % delete previous data
        kids = get(upArea, 'children');
        delete(kids)
        
        % get option names
        ModigPrepareTrial_PAVLOVIAN_FIX;
        
        % since the parent is the project update area the position values are in
        % reference to the ui control parent, *not* the figure itself
        uicontrol(upArea, 'style', 'text', 'units', 'pixels',...  
            'HorizontalAlignment','Center',...
            'position', [1 1 120 160],... 
            'fontSize', 10,...
            'backgroundColor', [0.831 0.816 0.784],...
            'tag', 'optionsText', ...
            'string',{'CS1'; 'CS2'; 'CS3'; 'CS4'; 'CS5';...
            'CS6'; 'CS7'; 'CS8'; 'CS9'; 'CS10';})

        % for simpler updating use matrix
        uicontrol(upArea, 'style', 'text', 'units', 'pixels',...
            'position', [130 1 75 160],... 
            'HorizontalAlignment','left',...
            'fontSize', 10, ...
            'backgroundColor', [0.831 0.816 0.784],...
            'tag', 'counterValues',...
            'string',num2str(zeros(10,3)))      
        
        % update gui handles
        uih = guihandles(figHdl);
        guidata(figHdl, uih);

        % update our globals
        MENUs.ModigMainMenu.handles = sort_structure(uih);
        MENUs.ModigMainMenu.handle  = figHdl;

        TaskOp.count.rewHist        = zeros(10,1);
        TaskOp.count.csCounter      = zeros(10,1);
        TaskOp.count.seq            = 0;       
        
        TaskOp.count.trialCounter = zeros(2,10); % counter for set up, CS reward for monkey
        TaskOp.count.socialCounter = zeros(2,10); % counter for set up, monkey vs bucket
        TaskOp.count.bucketCounter = zeros(2,10); % counter for set up, CS reward for bucket

    case 'update',
        % variables can be undeclared, and this is 
        if ~isfield(MENUs.ModigMainMenu.handles,'counterValues') || ...
                ~isfield(TaskOp.count,'csCounter') || ...
                ~isfield(MENUs.ModigMainMenu.handles,'counterValues') || ...
                ~ishandle(MENUs.ModigMainMenu.handles.counterValues) || ...
                sum(size(TaskOp.count.csCounter)==size(TaskOp.count.rewHist))~=2
            updateMoMaMe_PAVLOVIAN_FIX('initialize')
            updateMoMaMe_PAVLOVIAN_FIX('update')
        end
       
        % update counters
        if TaskOp.correct
           
            % update presented CS
            CSnumber = TaskOp.(TaskOp.curSetup).trialOrder(TaskOp.count.seq,1);
            TaskOp.count.csCounter(CSnumber) = TaskOp.count.csCounter(CSnumber)+1;
                
            % update reward history for each CS
            TaskOp.count.rewHist(CSnumber) = ...
                TaskOp.count.rewHist(CSnumber) + TaskOp.count.rewardNow;
            
            setupB = strcmpi(TaskOp.curSetup,'B');
            % counter for setup receiving reward associated to each CS
            listIdxSocial = TaskOp.count.socialCounter(setupB+1,CSnumber);            
            TaskOp.count.socialCounter(setupB+1,CSnumber) = listIdxSocial+1;
            
            % Counters for EITHER own or other for large reward
            if TaskOp.count.bucketTrial == 0
                TaskOp.count.trialCounter(setupB+1,CSnumber) = ...
                    TaskOp.count.trialCounter(setupB+1,CSnumber)+1; 
            else
                TaskOp.count.bucketCounter(setupB+1,CSnumber) = ...
                    TaskOp.count.bucketCounter(setupB+1,CSnumber)+1; 
            end
       end
        
        if sum(TaskOp.count.csCounter)>0, 
            warning('off','MATLAB:DivideByZero')
            percentRw = round(100*(TaskOp.count.rewHist./TaskOp.count.csCounter));
            warning('on','MATLAB:DivideByZero')
        else
            percentRw = zeros(10,1);
        end
       
        
        s = num2str([TaskOp.count.csCounter, TaskOp.count.rewHist, percentRw]);
        set(MENUs.ModigMainMenu.handles.counterValues, ...
            'string',s)
        
    case 'reset',
        if ~isfield(MENUs.ModigMainMenu.handles,'counterValues') || ...
            ~ishandle(MENUs.ModigMainMenu.handles.counterValues)
            updateMoMaMe_PAVLOVIAN_FIX('initialize')
            updateMoMaMe_PAVLOVIAN_FIX('update')
        end

        
        TaskOp.count.successiveError=0;
        TaskOp.count.rewHist        = zeros(10,1);
        TaskOp.count.seq            = 0;
        TaskOp.count.csCounter      = zeros(10,1);
        
        TaskOp.count.trialCounter = zeros(2,10); % counter for set up, CS reward for monkey
        TaskOp.count.socialCounter = zeros(2,10); % counter for set up, monkey vs bucket
        TaskOp.count.bucketCounter = zeros(2,10); % counter for set up, CS reward for bucket
        
        percentRw = zeros(10,1);
        s = num2str([TaskOp.count.csCounter, TaskOp.count.rewHist, percentRw]);
        set(MENUs.ModigMainMenu.handles.counterValues, ...
            'string',s)
end

