function param = ModigJudgeSituation_EYECAL(time_beh,prev_id)
% param = ModigJudgeSituation_EYECAL(time_beh,prev_id)
%
% Judge Situation in EYECAL project. Called by ModigShiftEvent on every
% event shift.
% Note that every epoch has a timer and this code is evaluated in the
% timerFcn callback, and the time each epoch lasts is defined by
% startDelay, which means that the requirements for the NEXT epoch are
% defined in what 'corresponds' to be 'prev_id'.
%
%
% RBM 08.07 while listening to Dover :D
%      10.08 ttabe setup changes....listening to rancid! 
%       7.09 error table and hold correction, ska-p y silvio
global Tbl Timers Stim TaskOp

persistent bt
if isempty(bt),
    % output table:
    bt = cell2mat(Tbl.BitTbl(:,2));
    nbt(1) = find( strcmp(Tbl.BitTbl(:,1),'KT1')==1);
    nbt(2) = find( strcmp(Tbl.BitTbl(:,1),'KT2')==1);
    nbt(3) = find( strcmp(Tbl.BitTbl(:,1),'Lick1')==1);
    nbt(4) = find( strcmp(Tbl.BitTbl(:,1),'Neuron')==1);
    bt(nbt)=[];
end


% Initalize variables
param.ok                = 0;
param.time_beh          = time_beh;
param.prev_id           = prev_id;

param.hand.req          = 0;
param.hand.filter_time  = 0;

param.eye.req           = {};
param.eye.target_center = [];
param.eye.tolerance_window_size = [];
param.eye.filter_time   = 0;
param.eye.target_name   = {};
param.eye.limits        = [];

TaskOp.eyeInterrupt   = 0;
TaskOp.handInterrupt  = 0;
TaskOp.hold = 0;
TaskOp.repeatError = 0;

param.on_bit = [];
param.off_bit = [];
    
switch param.time_beh
    case 1 % called by timer
        switch param.prev_id
            case 1 % pre_trial              
                fP = Stim.centralFix;
                param.hand.req          = fP.hand.req;
                param.eye.req           = fP.eye.req;
                param.eye.filter_time   = fP.filter_time;
                
                param.eye.limits        = fP.tolWin;
                
                TaskOp.hold             = fP.hold;
                TaskOp.holdTime         = fP.holdTime;
                TaskOp.eyeInterrupt     = fP.eyeInterrupt;

                param.next_id           = 2; 
            case 2 
                pP = Stim.periFix;
                param.hand.req          = pP.hand.req;
                
                param.eye.req           = pP.eye.req;
                param.eye.filter_time   = pP.filter_time;
                
                param.eye.limits        = pP.tolWin;

                TaskOp.hold             = pP.hold;
                TaskOp.holdTime         = pP.holdTime;
                TaskOp.eyeInterrupt     = pP.eyeInterrupt;
                
                param.next_id = 3;
                
            case 3 % periFix
                param.next_id = 4; 
                
            case 4 % us
                TaskOp.correct = 1;

                param.next_id = 5; 
            case 5 %iti
                
                %% pre_trial behav params
                pt                      = Stim.pre_trial;
                param.hand.req          = pt.hand.req;
                TaskOp.handInterrupt    = pt.handInterrupt;
                param.hand.filter_time  = pt.hand.filter_time;
                TaskOp.hold             = pt.hold;
                TaskOp.holdTime         = pt.holdTime;
                param.next_id           = 1;
                
                
            case 6 
                % NOTE, calling ITI adds up error time to the ITI, alt: 
                % go directly to pre_trial, but in that case it will skip
                % all that happens during an ITI, but it will repeat
                % the previous trial.
                TaskOp.repeatError = 1;
                param.next_id = 5; 
        end
    case 2 % called by behavior during an error
        %         -Eyecal errors:
        % no start KT
        % 1 lost KT anytime
        % 2 lost CF 
        % 3 didn't start CF
        % 5 lost PF
%         4 didn't start PF/late saccade
        switch param.prev_id
            case 1 % no Kt at beginning
                param.next_id = 6;
                TaskOp.ignored = 1;
                TaskOp.count.errors(1) = TaskOp.count.errors(1)+1;
            case 2 %
                param.next_id = 6; 
                if TaskOp.lostHold,
                     TaskOp.count.errors(3) = TaskOp.count.errors(3)+1;
                else
                    TaskOp.count.errors(2) = TaskOp.count.errors(2)+1;
                end
            case 3 
                param.next_id = 6; 
                if TaskOp.lostHold,
                    TaskOp.count.errors(5) = TaskOp.count.errors(5)+1;
                else
                    TaskOp.count.errors(4) = TaskOp.count.errors(4)+1;
                end
            otherwise
                sprintf('MJS_EYECAL input from beh: %s ', num2str(prev_id))
        end
    case -1 
        % called by ModigPrepareTiming. NOTE, I don't think this lines
        % are ever executed:
        sprintf('debug info: MJS_EYECAL called with %d and %d!!', ...
            time_beh, prev_id)
end
param.prev_event_name = cell2mat(Tbl.TaskTbl(param.prev_id,Tbl.TaskTblColumnID.evnt_name));
param.prev_timer      = Timers.Event.(param.prev_event_name);

param.next_event_name = cell2mat(Tbl.TaskTbl(param.next_id,Tbl.TaskTblColumnID.evnt_name));
param.next_timer      = Timers.Event.(param.next_event_name);
param.next_page       = cell2mat(Tbl.TaskTbl(param.next_id, Tbl.TaskTblColumnID.vis_page));
param.ok = 1;