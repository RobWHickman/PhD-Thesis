<div class="fragment"><pre>0001 <a name="_sub0" href="#_subfunctions" class="code">function aiObject = ModigCreateAnalogInput(sampling)</a>
0002 <span class="comment">%</span>
0003 <span class="comment">%</span>
0004 
0005 <span class="comment">% RBM 06.07</span>
0006 
0007 <span class="keyword">if</span> nargin == 0
0008     sampling = 200;
0009 <span class="keyword">end</span>
0010 <span class="comment">% create AI object</span>
0011 ai = analoginput(<span class="string">'nidaq'</span>,<span class="string">'Dev1'</span>);
0012 <span class="comment">% add channel(s)</span>
0013 addchannel(ai, [0 1 2 3]);
0014 ai.SampleRate        = sampling;
0015 ai.SamplesPerTrigger = inf;
0016 ai.UserData          = zeros(1,3);
0017 
0018 aiObject = ai;
0019</pre></div>
