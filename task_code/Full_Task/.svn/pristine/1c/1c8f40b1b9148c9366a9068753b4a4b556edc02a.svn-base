function param = ModigJudgeSituation_IMP_GIVING(time_beh,prev_id)
% param = ModigJudgeSituation_IMP_GIVING(time_beh,prev_id)
%
%    Events:
%    
%   pre_trial   
%   touchHold   
%   CSon      
%   targetOn    
%   touchFB      
%   us          
%   otherUsDelay
%   otherUS     
%   post_trial  
%   ITI         
%   error 
%
% rbm 6.08
%       7.08
%       9.08 new bitTbl -shared with dictator
%            licking is back on order, it shouldn't be changed by outputs   
%       2.09 touch parameters, double monitor
%       5.09 changed event position of bit.Correct

global Tbl Timers Stim TaskOp UserInfo 
global ExtDevice VisParam MENUs  Task

persistent bt
if isempty(bt),
    % output table:
    bt = cell2mat(Tbl.BitTbl(:,2));
    nbt(1) = find( strcmp(Tbl.BitTbl(:,1),'KT1')==1);
    nbt(2) = find( strcmp(Tbl.BitTbl(:,1),'KT2')==1);
    nbt(3) = find( strcmp(Tbl.BitTbl(:,1),'Lick1')==1);
    nbt(4) = find( strcmp(Tbl.BitTbl(:,1),'Neuron')==1);
    nbt(5) = find( strcmp(Tbl.BitTbl(:,1),'EMG')==1);
    bt(nbt)=[];
end

% Initalize variables
param.time_beh          = time_beh;
param.prev_id           = prev_id;

param.hand.req          = 0;
param.hand.filter_time  = 0;

param.touch.req           = {};
param.touch.filter_time   = [];
param.touch.state         = 0;
param.touch.limits      =[];

param.expPageMod = 0; 

TaskOp.eyeInterrupt   = 0;
TaskOp.handInterrupt  = 0;
TaskOp.touchInterrupt = 0;
TaskOp.hold = 0;
TaskOp.repeatError = 0;

param.on_bit = [];
param.off_bit = [];


if strcmpi(TaskOp.simOnePlayer,TaskOp.curSetup),
    sim = 1;
else
    sim = 0;
end

switch param.time_beh
    case 1 % called by timer
        switch param.prev_id
            case 1 % pre
                if sim==0,
                    param.hand.req = 1;   

                    TaskOp.handInterrupt = Stim.touchHold.handInterrupt;
                    TaskOp.hold          = Stim.touchHold.hold;
                    TaskOp.holdTime      = Stim.touchHold.holdTime;
                    param.hand.filter_time = Stim.touchHold.hand.filter_time;
                end
                param.next_id  = 2; 
                param.on_bit = Tbl.Bit.greyOn.bit_asignment;
                
             case 2 % touchHold
                 if sim==0,
                    param.hand.req = 1;                    
                 end
                param.next_id  = 3;

                on = [Tbl.Bit.otherCSs.bit_asignment; ...
                      Tbl.Bit.ownCSs.bit_asignment];

                switch Stim.CSon.type
                    case 'rings'
                        % only on if there are CSs shown
                        param.on_bit  = on(Stim.us.pulses>0);
                    otherwise
                        param.on_bit  = on;
                end
                param.off_bit = Tbl.Bit.PreTrial.bit_asignment;
                
            case 3 % CS on
                switch Stim.CSon.type
                    case {'ring','boxedRing','ringRect','valueBar'}
                        if UserInfo.use_touch_screen,
                             SetMouse(2048,0);
                        end
                        if sim==0,
                            tar = Stim.target;
                            param.touch.req                   = 'oneTouchArea';
                            param.touch.filter_time           = tar.filter_time;
                            param.touch.limits                = tar.touchLimits;
                            TaskOp.touchInterrupt = 1;   
                        end
                        param.next_id = 4;
                        param.on_bit = Tbl.Bit.Targets.bit_asignment;
                    otherwise
                        if sim==0,
                            param.hand.req = 1;
                        end
                        % going to 6 makes the CS dissapear AFTER the US
                        param.next_id = 5; 
                end
                
            case 4 % target on
                if UserInfo.use_touch_screen,
                     SetMouse(2048,0);
                end
                 
                if TaskOp.interrupt && sim==0,
                    param.next_id = 5; 
                    param.off_bit = Tbl.Bit.Targets.bit_asignment;
                    % moved here on 11-09-09
                    param.on_bit = Tbl.Bit.Correct.bit_asignment;

                elseif sim,
                    TaskOp.correct=1;
                    param.next_id = 5; 
                    % moved here on 11-09-09
                    param.on_bit = Tbl.Bit.Correct.bit_asignment;
                    param.off_bit = Tbl.Bit.Targets.bit_asignment;
                else
                    param.next_id = 11;
                end
                
            case 5 % touch fb 
                if sum(Stim.us.pulses)==0
                    param.next_id = 9;
                else
                    if Stim.pre_trial.normalUsOrder,
                        param.next_id = 6;
                        param.off_bit = [Tbl.Bit.Correct.bit_asignment;...
                                     Tbl.Bit.ownCSs.bit_asignment];
                    else
                        param.next_id = 8;
                        param.off_bit = [Tbl.Bit.Correct.bit_asignment;...
                                     Tbl.Bit.otherCSs.bit_asignment];
                        param.expPageMod = -1;
                    end
                end
                
            case 6 % us
                if Stim.pre_trial.normalUsOrder,
                    param.next_id = 7;
               else
                    param.next_id = 9;
                end
                
            case 7 % other us delay
                if Stim.pre_trial.normalUsOrder,
                    param.next_id = 8;
                    param.off_bit = Tbl.Bit.otherCSs.bit_asignment;
                else
                    param.next_id = 6;
                    param.off_bit = Tbl.Bit.ownCSs.bit_asignment;
                end
                
            case 8 % other us
                if Stim.pre_trial.normalUsOrder,
                    param.next_id = 9;                  
                else
                    param.next_id = 7;      
                    param.expPageMod = -1;
                end
                
            case 9 % post_trial
                param.next_id = 10;
                % so we mark the start of iti and black bkg               
                param.off_bit = Tbl.Bit.greyOn.bit_asignment;
                param.expPageMod = 1;
                
            case 10 % iti
                param.next_id = 1;
                param.on_bit = Tbl.Bit.PreTrial.bit_asignment;
                param.off_bit = bt(bt ~= param.on_bit);
                param.expPageMod = 1;
                
            case 11 % error
                TaskOp.repeatError = 1;
                param.next_id = 10;
                % set all bits down
                param.off_bit = bt;
                param.expPageMod = 1;
        end
    case 2 
        % called by behavior during an error
        
        % add error type to counter
       switch param.prev_id
           case 2
               TaskOp.ignored = 1;
           case 3
               TaskOp.count.earlyRelease = TaskOp.count.earlyRelease+1;
           case 4
               if strcmpi(Stim.CSon.type,'dreieck'),
                   TaskOp.count.earlyRelease = TaskOp.count.earlyRelease+1;
               else
                   TaskOp.count.noTouch = TaskOp.count.noTouch+1;
               end
           case 5
               if strcmpi(Stim.CSon.type,'dreieck'),
                   TaskOp.count.earlyRelease = TaskOp.count.earlyRelease+1;
               end
           otherwise
               fprintf('behavioral error @ epoch %d\n',param.prev_id)
       end
       param.next_id = 11; 
       
        % adaptive error when running Getty, so to reflect time
       % Getty won't release control
%         adaptiveError(0);
       % set all bits down
       param.off_bit = bt; 
       param.expPageMod = 1;
end
% Recover timer and event names from global Tbl
param.prev_event_name = cell2mat(Tbl.TaskTbl(param.prev_id,Tbl.TaskTblColumnID.evnt_name));
param.prev_timer      = Timers.Event.(param.prev_event_name);

param.next_event_name = cell2mat(Tbl.TaskTbl(param.next_id,Tbl.TaskTblColumnID.evnt_name));
param.next_timer      = Timers.Event.(param.next_event_name);

% adjust page # depending on US order
if Stim.pre_trial.normalUsOrder || ismember(param.prev_id,[1:4 6 9:11])
    param.next_page       = cell2mat(Tbl.TaskTbl(param.next_id, Tbl.TaskTblColumnID.vis_page));
elseif ismember(param.prev_id,[5 8])
    param.next_page = 7;
elseif param.prev_id==7,
    param.next_page = 1;
end

%% obtain programmed time for next epoch, used by ModigRuntrial
param.next_time = Task.(param.next_event_name).time_planned;

param.ok                = 1;