function [badshake] = Gettycom(VarToGetty)

%General protocol for transmitting data from ITC to Getty:
%(VarToGetty... array should be 16bit values but only use lower 8 bits)

% if no data available on control lines (4-bit) then exit as no getty present
%   i.e. test bits 20-23 (Front panel BNC connectors)
%   Control codes for Getty communication: (GWI interface uses active low
%   setup so equivalent of all off = 15, all on =0)
%   15 = no Getty
%   7 = Handshake from getty is on (ie. bit 3 is low)
warning('Modig:Legacy','Gettycom is due to be deprecated, use instead gettyHandshake')
global ExtDevice
badshake=0;
%SetDigitalOutput([15], [1]); %Turn hardtrigger on and handshake off
keydown=0;
keysecs=0;
keycode=0;
abort=0;
while 1
    dcontin=ITC_AsyncIO(ExtDevice.ITC.dev_handle, ExtDevice.ITC.CommData);%Read input digital data
    if bitand((convertsignedunsigned(dcontin(10))),32768)~=0  %Control data arrives at Channel 8 (+1)
        %Handshake bit on - exit loop
        break;
    end
    if (dcontin(9)==15)
        badshake=-1; %no getty
        return; %No getty available. Handshake (bit 0) should be off
    end
    [keydown, keyseecs, keycode]=KbCheck;
    if  (keydown~=0)
        keyname=KbName(keycode);
%        if ((keyname=='x')||(keyname=='X'))
%            abort=1;
%        end
    end
    if abort==1
        badshake=-2; %Abort pressed
        break;
    end
end
if (badshake<0)
    return  %if getty offline abort transfer
end
eval(strcat(ExtDevice.CurDevice,'_SetDigitalOutput([14,15], [1,0]);'));%Turn hardtrigger on and handshake off

while 1
    dcontin=ITC_AsyncIO(ExtDevice.ITC.dev_handle, ExtDevice.ITC.CommData); %Read input data
    if bitand(convertsignedunsigned(dcontin(10)), 32768)==0 %Test bit 3/channel 8(+1 for array manipulation)
        %Handshake from getty is off
        %Getty ready for data
        break
    end
    if dcontin(9)==15   %Test if getty still online
        %Getty is off
        badshake=-1;
        break
    end
    [keydown, keyseecs, keycode]=KbCheck;
    if  (keydown~=0)
        keyname=KbName(keycode);
 %       if ((keyname=='x')||(keyname=='X'))
 %           abort=1;
 %       end
    end
    if abort==1
        badshake=-2; %Abort pressed
        break;
    end
end
eval(strcat(ExtDevice.CurDevice,'_SetDigitalOutput(14, 0);'));%Turn HardTrigger off
if (badshake<0)
    return  %if getty offline abort transfer
end

NumToTransmit=VarToGetty(1); %get number of variables to transmit to getty

for i=1:NumToTransmit
    eval(strcat(ExtDevice.CurDevice,'_SetDigitalOutput([15], [1]);'));
    while 1
        dcontin=ITC_AsyncIO(ExtDevice.ITC.dev_handle, ExtDevice.ITC.CommData);
        if bitand(convertsignedunsigned(dcontin(10)),32768)~=0  %Control data arrives at Channel 8 (+1)
            %Handshake bit on - exit loop
            break;
        end
        [keydown, keyseecs, keycode]=KbCheck;
        if  (keydown~=0)
            keyname=KbName(keycode);
%            if ((keyname=='x')||(keyname=='X'))
%                abort=1;
%            end
        end
        if abort==1
            badshake=-2; %Abort pressed
            break;
        end


    end
    ExtDevice.ITC.CommData(19).Value=VarToGetty(i); %Set digital outputs
    eval(strcat(ExtDevice.CurDevice,'_SetDigitalOutput([15], [0]);'));%Turn hardtrigger on and handshake off
    if (badshake<0)
        return  %if getty offline abort transfer
    end

    dcontin=ITC_AsyncIO(ExtDevice.ITC.dev_handle, ExtDevice.ITC.CommData); %Send data
    while 1
        dcontin=ITC_AsyncIO(ExtDevice.ITC.dev_handle, ExtDevice.ITC.CommData);
        %       if GetDigitalData(15,0)~=0
        if bitand(convertsignedunsigned(dcontin(10)),32768)==0
            %Getty handshake off (has received data)
            break
        end
        [keydown, keyseecs, keycode]=KbCheck;
        if  (keydown~=0)
            keyname=KbName(keycode);
%            if ((keyname=='x')||(keyname=='X'))
%                abort=1;
%            end
        end
        if abort==1
            badshake=-2; %Abort pressed
            break;
        end

    end
end
    ExtDevice.ITC.CommData(19).Value=0; %Reset info output
    if (badshake<0)
        return  %if getty offline abort transfer
    end




