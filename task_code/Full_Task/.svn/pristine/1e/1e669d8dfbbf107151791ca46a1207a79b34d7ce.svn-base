<h1>ModigPrepareOutput_DICTATOR
</h1>

<h2><a name="_name"></a>PURPOSE <a href="#_top"><img alt="^" border="0" src="../../../../up.png"></a></h2>
<div class="box"><strong>Prepares timers for digital output, e.g. juice trigger.</strong></div>

<h2><a name="_synopsis"></a>SYNOPSIS <a href="#_top"><img alt="^" border="0" src="../../../../up.png"></a></h2>
<div class="box"><strong>function ModigPrepareOutput_DICTATOR </strong></div>

<h2><a name="_description"></a>DESCRIPTION <a href="#_top"><img alt="^" border="0" src="../../../../up.png"></a></h2>
<div class="fragment"><pre class="comment"> Prepares timers for digital output, e.g. juice trigger.
 Called by PrepareBitTbl subroutine in ModigChangeTask.m

 rbm 04.08
 global Tbl IO Task Timers
 
 % set FREE-reward bit and duration
 IO.Output.free_juice.bit =  Tbl.Bit.Reward.bit_asignment; % bit asignment is constant. Read it from Tbl file
 [TH free_juice_dur Empty] = isfield_sk(IO,'Output.free_juice.dur');
 if Empty
    IO.Output.free_juice.dur = 35; 
 end
 ModigSetTimer('Output','free_juice');
 
 % set TASK-reward bit and duration
 IO.Output.task_juice.bit =  Tbl.Bit.Reward.bit_asignment; % bit asignment is constant. Read it from Tbl file
 [TH task_juice_dur Empty] = isfield_sk(IO,'Output.task_juice.dur');
 if Empty
    IO.Output.task_juice.dur = 100; 
 end
 ModigSetTimer('Output','task_juice');
 if isempty(ismember(Task.us.OutputTimer,'Timers.Output.task_juice'))
     ModigLockTimerToEvent('us','Timers.Output.task_juice');
 else
     Task.us.OutputTimer = unique(Task.us.OutputTimer);
 end</pre></div>

