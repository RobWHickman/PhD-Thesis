function reply=ModigStimMenuControl(gui_name,stim_name,option)
% reply=ModigStimMenuControl(gui_name,stim_name,option)
%
% This function is used to activate or inactivate stimulus setup menu  the
% argument 'gui_name' is a menu name (fig file or m file) without extention
% (eg. ModigStimSetUp_A) the argument 'stim_name' is a stimulus name Option
% should be 'ON'/ 'OFF'. [in future, set up for 'HIDE']  Handles and Tags 
% of objects  that went through this function is stored in the global 
% 'MENUs' (including their children) 

% coded by skoba (skoba-tky@umin.ac.jp) 6 July 2005
% last modified by skoba 23 August 2005
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
global TaskOp Stim MENUs MenuPos
unique_name = strcat(gui_name,'_',TaskOp.prj,'_',stim_name);% menu name for stimulus setup: guiname_xxx_yyy (xxx: project name, yyy: stimulus name). make a unique name because the same menu dialog would be called in different projects or for different stimuli.
if nargin <= 2
    if isfield(MENUs,unique_name)                               % if option is not given, judge on/off by MENUs status
        switch eval(strcat('MENUs.',unique_name,'.status'))
            case 'ON',
                option='OFF';
            case 'OFF',
                option='ON';
            otherwise
                option='OFF';
        end
    else
        option='ON';
    end
else
    if isempty(option)
        if isfield(MENUs,unique_name)
            switch eval(strcat('MENUs.',unique_name,'.status'))
                case 'ON',
                    option='OFF';
                case 'OFF',
                    option='ON';
                otherwise
                    option='OFF';
            end
        else
            option='ON';
        end
    end
end

% open GUI_MENU
if strcmpi(option,'ON')
    [TH StimStruct EMPTY] = isfield_sk(Stim,stim_name);
    if ~EMPTY
        eval(strcat(gui_name,'(','''','ArrangeMenu','''',',','StimStruct',')'));
        gui_handle = gcf;
        gui_tag=get(gui_handle,'tag');
        eval(strcat('MENUs.',unique_name,'.tag=','''',gui_tag,'''',';'));
        gui_handles = guidata(gui_handle);
        eval(strcat('MENUs.',unique_name,'.handles=','gui_handles',';'));
        eval(strcat('MENUs.',unique_name,'.status=','''','ON','''',';'));
        Fcn=strcat('ModigStimMenuControl(','''',gui_name,'''',',','''',stim_name,'''',',','''','OFF','''',');');
        set(gui_handle,'CloseRequestFcn',Fcn); % When the menu is closed, ModigMenuControl is evaluated to update 'MENUs'
        field_name = strcat('ModigMainMenu.handles.MENU_',TaskOp.prj,'_',stim_name);
        [TH h_tab EMPTY_tab] = isfield_sk(MENUs,field_name);
        if ~EMPTY_tab
            % set the corresponding check in the MainMenu on. (To do this, tag name has to be named as 'MENU_xxx_yyy', where xxx is a project name and yyy is a stimulus name)
            eval(strcat('set(MENUs.ModigMainMenu.handles.MENU_',TaskOp.prj,'_',stim_name,',','''','Checked','''',',','''','on','''',');'));
        end
        field_name = strcat(gui_tag,'.position');
        [TH_pos menu_position EMPTY_pos] = isfield_sk(MenuPos,field_name);
        if ~EMPTY_pos
            set(gui_handle,'Unit','Pixel');
            cur_pos = get(gui_handle,'Position');
            menu_position(3:4) = cur_pos(3:4);
            set(gui_handle,'Unit','Pixel','Position', menu_position);
        else
            ModigArrangeMenuPosition(gui_handle);
        end
        reply=1;
    else
        reply = 0;
    end
elseif strcmpi(option,'OFF'),
    if isfield(MENUs,unique_name)
        gui_tag=eval(strcat('MENUs.',unique_name,'.tag'));
        gui_handle=findobj('tag',gui_tag);
        if ~isempty(gui_handle)
            set(gui_handle,'Unit','Pixel');
            menu_position = get(gui_handle,'Position');
            eval(strcat('MenuPos.',gui_tag, '.position = menu_position;'));
            delete(gui_handle);
            reply=1;
        else
            reply=0;
        end
        eval(strcat('MENUs.',unique_name,'.handles=','''',[],'''',';'));
        eval(strcat('MENUs.',unique_name,'.status=','''','OFF','''',';'));
        field_name = strcat('ModigMainMenu.handles.MENU_',TaskOp.prj,'_',stim_name);
        [TH h_tab EMPTY_tab] = isfield_sk(MENUs,field_name);
        if ~EMPTY_tab
            % set the corresponding check in the MainMenu on. (To do this, tag name has to be named as 'MENU_xxx_yyy', where xxx is a project name and yyy is a stimulus name)
            eval(strcat('set(MENUs.ModigMainMenu.handles.MENU_',TaskOp.prj,'_',stim_name,',','''','Checked','''',',','''','off','''',');'));
        end

    end
end


