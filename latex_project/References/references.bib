@article{azabCorrelatesEconomicDecisions2018,
  title = {Correlates of Economic Decisions in the Dorsal and Subgenual Anterior Cingulate Cortices},
  author = {Azab, Habiba and Hayden, Benjamin Y.},
  year = {2018},
