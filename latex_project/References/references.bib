@article{grabenhorstPrimateAmygdalaNeurons2019,
  title = {Primate {{Amygdala Neurons Simulate Decision Processes}} of {{Social Partners}}},
  author = {Grabenhorst, Fabian and {B{\'a}ez-Mendoza}, Raymundo and Genest, Wilfried and Deco, Gustavo and Schultz, Wolfram},
