  author = {Hare, Todd A. and O'Doherty, John and Camerer, Colin F. and Schultz, Wolfram and Rangel, Antonio},
  year = {2008},
  month = may,
  journal = {The Journal of Neuroscience},
  volume = {28},
  number = {22},
  pages = {5623--5630},
  issn = {0270-6474, 1529-2401},
  doi = {10.1523/JNEUROSCI.1309-08.2008},
  urldate = {2025-04-15},
  abstract = {To make sound economic decisions, the brain needs to compute several different value-related signals. These include goal values that measure the predicted reward that results from the outcome generated by each of the actions under consideration, decision values that measure the net value of taking the different actions, and prediction errors that measure deviations from individuals' previous reward expectations. We used functional magnetic resonance imaging and a novel decision-making paradigm to dissociate the neural basis of these three computations. Our results show that they are supported by different neural substrates: goal values are correlated with activity in the medial orbitofrontal cortex, decision values are correlated with activity in the central orbitofrontal cortex, and prediction errors are correlated with activity in the ventral striatum.},
  copyright = {https://creativecommons.org/licenses/by-nc-sa/4.0/},
  langid = {english},
  file = {/Users/roberthickman/Zotero/storage/7GSZFI38/Hare et al. - 2008 - Dissociating the Role of the Orbitofrontal Cortex and the Striatum in the Computation of Goal Values.pdf}
}

